FROM debian:bookworm-slim AS source-fetcher
RUN apt-get update && apt-get install -y curl tar sed ca-certificates

WORKDIR /src

RUN echo "$(date +%Y-%m-%d_%H:%M:%S)" > /tmp/build_time

RUN LATEST_URL=$(curl -s https://api.github.com/repos/chriswritescode-dev/opencode-manager/releases/latest | grep "tarball_url" | cut -d '"' -f 4) \
    && curl -Ls "$LATEST_URL" | tar -xzf - --strip-components=1

RUN if [ -f scripts/docker-entrypoint.sh ]; then \
        sed -i 's/export HOME=\/home\/node/export HOME=\/root/g' scripts/docker-entrypoint.sh && \
        sed -i 's/\/home\/node/\/root/g' scripts/docker-entrypoint.sh && \
        sed -i 's/chown -R node:node.*/# Root mode/g' scripts/docker-entrypoint.sh && \
        sed -i 's/exec runuser -u node -- "$@"/exec "$@"/g' scripts/docker-entrypoint.sh; \
    fi

FROM node:24.13.0-slim AS builder
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app
COPY --from=source-fetcher /src .
RUN pnpm install --frozen-lockfile && \
    pnpm --filter frontend build && \
    CI=true pnpm install --prod --frozen-lockfile

FROM node:24.13.0-slim AS runner

# Cài đặt công cụ nền hệ thống
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl lsof ripgrep ca-certificates grep gawk sed findutils openssh-client \
    coreutils procps jq less tree file python3 python3-pip python3-venv \
    tar openssl unzip inotify-tools tini chromium bash psmisc \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update && apt-get install -y gh \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Tải, giải nén và cấu hình công cụ cloudflare-warp mới (Thay thế cho wgcf + wireproxy)
RUN ARCH=$(dpkg --print-architecture) \
    && WARP_ZIP_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2hoc3cyMDE1L2Nsb3VkZmxhcmUtd2FycC9yZWxlYXNlcy9kb3dubG9hZC92MS4wL3dhcnAtbGludXgtYW1kNjQuemlw" | base64 -d) \
    && if [ "$ARCH" != "amd64" ]; then \
         echo "Canh bao: Phien ban cloudflare-warp hien tai chi ho tro kien truc amd64!" ; \
       fi \
    && curl -fsSL "$WARP_ZIP_URL" -o /tmp/warp.zip \
    && unzip /tmp/warp.zip -d /usr/local/bin/ \
    && mv /usr/local/bin/warp-linux-amd64 /usr/local/bin/warp \
    && rm -f /tmp/warp.zip \
    && chmod +x /usr/local/bin/warp

WORKDIR /root

RUN echo "$(date +%Y-%m-%d_%H:%M:%S)" > /tmp/runner_build_time

RUN curl -fsSL https://bun.sh/install | bash && ln -s /root/.bun/bin/bun /usr/local/bin/bun
RUN npm install -g --prefer-online --loglevel=error opencode-ai@latest

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/shared ./shared
COPY --from=builder /app/backend ./backend
COPY --from=builder /app/frontend/dist ./frontend/dist
COPY --from=source-fetcher /src/package.json /src/pnpm-workspace.yaml ./

# Cấu hình biến môi trường hệ thống
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=7860 \
    HOME=/root \
    AUTH_SECRET="super-secret-key-change-me" \
    AUTH_TRUSTED_ORIGINS="http://localhost:7860" \
    AUTH_SECURE_COOKIES=true \
    BACKUP_DIR="/data" \
    BACKUP_FILENAME="opencode-manager_backup.enc" \
    BACKUP_PASS="123456" \
    DATABASE_PATH=/root/data/opencode.db \
    WORKSPACE_PATH=/root \
    HTTP_PROXY="http://127.0.0.1:4001" \
    HTTPS_PROXY="http://127.0.0.1:4001" \
    ALL_PROXY="http://127.0.0.1:4001" \
    NO_PROXY="localhost,127.0.0.1"

RUN mkdir -p /root/data /root/.cache /data /tmp/warp_data && chmod -R 777 /root /data /app

RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh
#!/bin/bash
set +e

BACKUP_PATH="$BACKUP_DIR/$BACKUP_FILENAME"
TEMP_PATH="/tmp/temp_backup.enc"
WARP_DIR="/tmp/warp_data"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

# Hàm kiểm tra trạng thái sống động thực tế của Opencode Manager
is_app_alive() {
    if pgrep -f "bun.*backend/src/index.ts" >/dev/null 2>&1 || lsof -i :"$PORT" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

# --- HÀM KHỞI TẠO HTTP PROXY WARP MỚI ---
start_warp_proxy() {
    log "--- [WARP] Dang khoi tao va dinh tuyen mang qua Cloudflare Warp... ---"
    killall warp 2>/dev/null || true
    mkdir -p "$WARP_DIR" && cd "$WARP_DIR"
    
    if [ ! -f "$WARP_DIR/reg.json" ]; then
        log "--- [WARP] Sinh thong tin tai khoan dinh danh moi... ---"
        HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" warp --data-dir "$WARP_DIR" generate >/dev/null 2>&1 || true
    fi

    # Chỉ kích hoạt HTTP Proxy (Bỏ SOCKS5)
    log "--- [WARP] Dang khoi chay HTTP Proxy tai cong 4001... ---"
    HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" warp --data-dir "$WARP_DIR" run --http-addr 127.0.0.1:4001 >/dev/null 2>&1 &
    sleep 3
    cd /app
}

restore_data() {
    if [ -f "$BACKUP_PATH" ]; then
        log "--- [RESTORE] Tim thay ban luu. Dang giai ma va phuc hoi du lieu he thong... ---"
        if openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_PATH" | tar -xz -C / 2>/dev/null; then
            log "--- [RESTORE] Phuc hoi du lieu thanh cong! Bao dam cap lai toan quyen ghi... ---"
            chmod -R 777 /root /data /app 2>/dev/null || true
        else
            log "--- [RESTORE] That bai (Sai mat khau hoac file loi) ---"
        fi
    else
        log "--- [RESTORE] Khong tim thay ban luu cu. Khoi tao moi truong moi. ---"
    fi
}

backup_data() {
    if [ ! -d "/root/data" ] && [ ! -d "/root/.config" ]; then return; fi

    log "--- [BACKUP] Kich hoat tien trinh nen va ma hoa du lieu... ---"
    mkdir -p "$BACKUP_DIR"
    
    if tar -cz -C / \
        --exclude='root/.cache' \
        --exclude='root/.npm' \
        --exclude='/tmp/warp_data' \
        --exclude='root/data/*.db-journal' \
        --exclude='*.log' \
        root 2>/dev/null | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$TEMP_PATH"; then
        
        mv "$TEMP_PATH" "$BACKUP_PATH"
        log "--- [BACKUP] Da cap nhat ban luu ma hoa thanh cong luc $(date) ---"
    else
        log "--- [BACKUP] Loi trong qua trinh nen hoac ma hoa du lieu! ---"
        rm -f "$TEMP_PATH"
    fi
}

cleanup() {
    log "!!! [STOP] Container dang bi dung! Kiem tra trang thai ung dung truoc khi xu ly du lieu... !!!"
    if is_app_alive; then
        if [ -d "/root/data" ] || [ -d "/root/.config" ]; then
            tar -cz -C / --exclude='root/.cache' --exclude='root/.npm' --exclude='/tmp/warp_data' --exclude='root/data/*.db-journal' --exclude='*.log' root 2>/dev/null | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$BACKUP_PATH"
            log "!!! [STOP] Da cuu ho backup thanh cong truoc khi tat may !!!"
        fi
    else
        log "!!! [STOP] Ung dung da sap hoac chua tung khoi chay thanh cong. HUY BO ghi de de bao ve ban sao luu goc !!!"
    fi
    exit 0
}

# Dang ky tin hieu shutdown
trap cleanup SIGTERM SIGINT

# Khoi chay dich vu
start_warp_proxy
restore_data

# --- TIẾN TRÌNH INOTIFYWAIT (ĐÃ LOẠI BỎ XOAY IP XOAY VÒNG) ---
(
    while true; do
        inotifywait -r -e modify -e create -e delete -e move \
            --exclude '(\.cache|\.npm|warp_data|\.db-journal|\.log)' \
            /root /app 2>/dev/null

        log "--- [INOTIFY] Phat hien he thong co teps tin vua thay doi! ---"
        log "--- [INOTIFY] Bat dau dem nguoc 5 phut (Debounce) truoc khi cap nhat file luu... ---"
        
        sleep 300
        
        if is_app_alive; then
            backup_data
        else
            log "--- [INOTIFY] Bo qua sao luu tu dong vi phat hien ung dung chinh da bi dung hoac thuc su crash ---"
        fi
    done
) &

log "Dang khoi dong Opencode Manager tai /app tren cong $PORT..."
bun backend/src/index.ts &

# Vong lap giu Entrypoint song theo ung dung chinh
sleep 5
while is_app_alive; do
    sleep 5
done

log "--- [EXIT] Tien trinh chinh cua ung dung da ket thuc ---"
EOF

EXPOSE 7860

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
