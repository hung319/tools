# Kế thừa trực tiếp từ Image gốc của họ (Bỏ qua toàn bộ bước compile/build code)
FROM ghcr.io/chriswritescode-dev/opencode-manager:latest

# Chuyển hẳn sang quyền ROOT để kiểm soát hệ thống, rsync và warp không bị chặn quyền
USER root

# Cài đặt bổ sung các công cụ cần thiết cho hệ thống tùy chỉnh của chúng ta (rsync, inotify, warp)
RUN apt-get update && apt-get install -y --no-install-recommends \
    inotify-tools rsync psmisc unzip ca-certificates tini lsof \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Tải và cấu hình công cụ cloudflare-warp mới độc lập
RUN ARCH=$(dpkg --print-architecture) \
    && WARP_ZIP_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2hoc3cyMDE1L2Nsb3VkZmxhcmUtd2FycC9yZWxlYXNlcy9kb3dubG9hZC92MS4wL3dhcnAtbGludXgtYW1kNjQuemlw" | base64 -d) \
    && if [ "$ARCH" != "amd64" ]; then \
         echo "Canh bao: Phien ban cloudflare-warp hien tai chi ho tro kien truc amd64!" ; \
       fi \
    && curl -fsSL "$WARP_ZIP_URL" -o /tmp/warp.zip \
    && unzip /tmp/warp.zip -d /usr/local/bin/ \
    && mv /usr/local/bin/warp-linux-amd64 /usr/local/bin/warp \
    && rm -f /tmp/warp.zip \
    && chmod +x /usr/local/bin/warp

WORKDIR /app

# --- CẤU HÌNH BIẾN MÔI TRƯỜNG ĐÃ ĐƯỢC MAP LẠI (Gộp cấu trúc phẳng) ---
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=7860 \
    OPENCODE_SERVER_PORT=5551 \
    HOME=/root \
    AUTH_SECRET="super-secret-key-change-me" \
    AUTH_TRUSTED_ORIGINS="http://localhost:7860" \
    AUTH_SECURE_COOKIES=true \
    BACKUP_DIR="/data/opencode-manager_backup_data" \
    DATABASE_PATH=/root/data/opencode.db \
    WORKSPACE_PATH=/root \
    XDG_CACHE_HOME=/root/.cache \
    HTTP_PROXY="http://127.0.0.1:4001" \
    HTTPS_PROXY="http://127.0.0.1:4001" \
    ALL_PROXY="http://127.0.0.1:4001" \
    NO_PROXY="localhost,127.0.0.1"

# Đảm bảo PATH chứa đủ Bun và các công cụ khác chạy dưới quyền root
ENV PATH="/opt/bun/bin:/root/.opencode/bin:/usr/local/bin:$PATH"

RUN mkdir -p /root/data /root/.cache /root/.opencode /data /tmp/warp_data && chmod -R 777 /root /data /app

# Ghi đè file entrypoint tùy chỉnh của chúng ta vào hệ thống
RUN cat <<'EOF' > /usr/local/bin/custom-entrypoint.sh && chmod +x /usr/local/bin/custom-entrypoint.sh
#!/bin/bash
set +e

WARP_DIR="/tmp/warp_data"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

is_app_alive() {
    if pgrep -f "bun.*backend/src/index.ts" >/dev/null 2>&1 || lsof -i :"$PORT" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

start_warp_proxy() {
    log "--- [WARP] Dang khoi tao va dinh tuyen mang qua Cloudflare Warp... ---"
    killall warp 2>/dev/null || true
    mkdir -p "$WARP_DIR" && cd "$WARP_DIR"
    
    if [ ! -f "$WARP_DIR/reg.json" ]; then
        log "--- [WARP] Sinh thong tin tai khoan dinh danh moi... ---"
        HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" warp --data-dir "$WARP_DIR" generate >/dev/null 2>&1 || true
    fi

    log "--- [WARP] Dang khoi chay HTTP Proxy tai cong 4001... ---"
    HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" warp --data-dir "$WARP_DIR" run --http-addr 127.0.0.1:4001 >/dev/null 2>&1 &
    sleep 3
    cd /app
}

restore_data() {
    if [ -d "$BACKUP_DIR" ] && [ "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
        log "--- [RESTORE] Tim thay du lieu dong bo phang. Kich hoat rsync phuc hoi... ---"
        rsync -a --delete "$BACKUP_DIR/" "/root/"
        log "--- [RESTORE] Phuc hoi du lieu phang thanh cong. ---"
    else
        log "--- [RESTORE] Khong tim thay du lieu cu tai $BACKUP_DIR. Chay moi truong moi tinh. ---"
    fi
    chmod -R 777 /root /data /app 2>/dev/null || true
}

backup_data() {
    if [ ! -d "/root/data" ] && [ ! -d "/root/.config" ]; then return; fi

    log "--- [BACKUP] Kich hoat rsync dong bo phang delta... ---"
    mkdir -p "$BACKUP_DIR"
    
    rsync -a --delete \
        --exclude='.cache' \
        --exclude='.npm' \
        --exclude='data/*.db-journal' \
        --exclude='*.log' \
        "/root/" "$BACKUP_DIR/"

    if [ $? -eq 0 ]; then
        log "--- [BACKUP] Dong bo phang thanh cong luc $(date) ---"
    else
        log "--- [BACKUP] Dong bo rsync gap su co! ---"
    fi
}

cleanup() {
    log "!!! [STOP] Container dang bi dung! Kiem tra trang thai ung dung... !!!"
    kill $WATCHER_PID 2>/dev/null || true
    
    if is_app_alive; then
        backup_data
        log "!!! [STOP] Da cuu ho backup dong bo phang thanh cong truoc khi shutdown !!!"
    else
        log "!!! [STOP] Ung dung crash tu truoc. HUY BO dong bo de bao ve an toan data cu !!!"
    fi
    exit 0
}

trap cleanup SIGTERM SIGINT

start_warp_proxy

# Chạy trình kiểm tra và chuẩn bị OpenCode Engine của nhà phát triển gốc (giữ nguyên tính năng check/upgrade của họ)
log "--- [SYSTEM] Chay kiem tra Engine phu thuoc cua he thong... ---"
export HOME=/root
# Fake lại hàm hoặc chạy logic cài đặt của gốc nếu thiếu file
if ! command -v opencode >/dev/null 2>&1; then
    log "OpenCode Engine khong tim thay trong global, tu dong tai ban moi nhat..."
    curl -fsSL "https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-$(uname -m | sed 's/x86_64/x64/; s/aarch64/arm64/').tar.gz" -o /tmp/opencode.tar.gz
    tar -xzf /tmp/opencode.tar.gz -C /tmp
    mkdir -p "/root/.opencode/bin"
    mv /tmp/opencode "/root/.opencode/bin/opencode"
    chmod 755 "/root/.opencode/bin/opencode"
    rm -f /tmp/opencode.tar.gz
fi

restore_data

# --- TIẾN TRÌNH THEO DÕI BIẾN ĐỘNG FILE (INOTIFY + RSYNC PHẲNG) ---
(
    while true; do
        inotifywait -r -e modify -e create -e delete -e move \
            --exclude '(\.cache|\.npm|warp_data|\.db-journal|\.log)' \
            /root /app 2>/dev/null

        log "--- [INOTIFY] Co bien dong tep tin! Dang tri hoan 5 phut (Debounce)... ---"
        sleep 300
        
        if is_app_alive; then
            backup_data
        else
            log "--- [INOTIFY] Bo qua sao luu vi ung dung unhealthy hoac crash ---"
        fi
    done
) &
WATCHER_PID=$!

log "Dang khoi dong Opencode Manager tu Image goc tren cong $PORT..."
# Chạy trực tiếp qua bun (không dùng lệnh runuser -u node để giữ quyền root toàn quyền ghi data phẳng)
bun backend/src/index.ts &

sleep 5
while is_app_alive; do
    sleep 5
done

log "--- [EXIT] Tien trinh chinh cua ung dung da ket thuc ---"
EOF

# Cấp quyền thực thi cho entrypoint mới
RUN chmod +x /usr/local/bin/custom-entrypoint.sh

EXPOSE 7860

# Dùng tini quản lý tiến trình của chúng ta làm root
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/custom-entrypoint.sh"]
