FROM debian:bookworm-slim AS source-fetcher
RUN apt-get update && apt-get install -y curl tar sed ca-certificates

WORKDIR /src

RUN echo "$(date +%Y-%m-%d_%H:%M:%S)" > /tmp/build_time

RUN LATEST_URL=$(curl -s https://api.github.com/repos/chriswritescode-dev/opencode-manager/releases/latest | grep "tarball_url" | cut -d '"' -f 4) \
    && curl -Ls "$LATEST_URL" | tar -xzf - --strip-components=1

RUN if [ -f scripts/docker-entrypoint.sh ]; then \
        sed -i 's/export HOME=\/home\/node/export HOME=\/root/g' scripts/docker-entrypoint.sh && \
        sed -i 's/\/home\/node/\/root/g' scripts/docker-entrypoint.sh && \
        sed -i 's/chown -R node:node.*/# Root mode/g' scripts/docker-entrypoint.sh && \
        sed -i 's/exec runuser -u node -- "$@"/exec "$@"/g' scripts/docker-entrypoint.sh; \
    fi

FROM node:24.13.0-slim AS builder
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app
COPY --from=source-fetcher /src .
RUN pnpm install --frozen-lockfile && \
    pnpm --filter frontend build && \
    CI=true pnpm install --prod --frozen-lockfile

FROM node:24.13.0-slim AS runner

# Cài đặt công cụ nền và tải duy nhất Wireproxy phiên bản cố định ổn định (Loại bỏ wgcf)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl lsof ripgrep ca-certificates grep gawk sed findutils openssh-client \
    coreutils procps jq less tree file python3 python3-pip python3-venv \
    tar openssl unzip inotify-tools tini chromium bash psmisc xxd netcat-openbsd \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update && apt-get install -y gh \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

RUN ARCH=$(dpkg --print-architecture) \
    && if [ "$ARCH" = "amd64" ]; then \
         curl -fsSL $(echo "aHR0cHM6Ly9naXRodWIuY29tL3dpbmR0Zi93aXJlcHJveHkvcmVsZWFzZXMvZG93bmxvYWQvdjEuMS4yL3dpcmVwcm94eV9saW51eF9hbWQ2NC50YXIuZ3o=" | base64 -d) | tar -xz -C /usr/local/bin/ wireproxy; \
       else \
         curl -fsSL $(echo "aHR0cHM6Ly9naXRodWIuY29tL3dpbmR0Zi93aXJlcHJveHkvcmVsZWFzZXMvZG93bmxvYWQvdjEuMS4yL3dpcmVwcm94eV9saW51eF9hcm02NC50YXIuZ3o=" | base64 -d) | tar -xz -C /usr/local/bin/ wireproxy; \
       fi \
    && chmod +x /usr/local/bin/wireproxy

WORKDIR /root

RUN echo "$(date +%Y-%m-%d_%H:%M:%S)" > /tmp/runner_build_time

RUN curl -fsSL https://bun.sh/install | bash && ln -s /root/.bun/bin/bun /usr/local/bin/bun
RUN npm install -g --prefer-online --loglevel=error opencode-ai@latest

WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/shared ./shared
COPY --from=builder /app/backend ./backend
COPY --from=builder /app/frontend/dist ./frontend/dist
COPY --from=source-fetcher /src/package.json /src/pnpm-workspace.yaml ./

# Cấu hình biến môi trường hệ thống (Đã loại bỏ biến WGCF_FORCE_REGISTER)
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=7860 \
    HOME=/root \
    AUTH_SECRET="super-secret-key-change-me" \
    AUTH_TRUSTED_ORIGINS="http://localhost:7860" \
    AUTH_SECURE_COOKIES=true \
    BACKUP_DIR="/data" \
    BACKUP_FILENAME="opencode-manager_backup.enc" \
    BACKUP_PASS="123456" \
    DATABASE_PATH=/root/data/opencode.db \
    WORKSPACE_PATH=/root \
    HTTP_PROXY="http://127.0.0.1:4001" \
    HTTPS_PROXY="http://127.0.0.1:4001" \
    ALL_PROXY="http://127.0.0.1:4001" \
    NO_PROXY="localhost,127.0.0.1"

RUN mkdir -p /root/data /root/.cache /data /tmp/wireproxy_temp && chmod -R 777 /root /data /app

RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh && chmod +x /usr/local/bin/entrypoint.sh
#!/bin/bash
set +e

BACKUP_PATH="$BACKUP_DIR/$BACKUP_FILENAME"
TEMP_PATH="/tmp/temp_backup.enc"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

is_app_alive() {
    if pgrep -f "bun.*backend/src/index.ts" >/dev/null 2>&1 || lsof -i :"$PORT" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

# --- HÀM ĐĂNG KÝ WARP DÙNG SCRIPT NATIVE (THAY THẾ WGCF) ---
start_warp_proxy() {
    log "--- [WARP] Đang khởi tạo và đăng ký IP Cloudflare mới... ---"
    killall wireproxy 2>/dev/null || true
    rm -rf /tmp/wireproxy_temp && mkdir -p /tmp/wireproxy_temp && cd /tmp/wireproxy_temp
    
    log "[WARP-SCAN] Dang quet nhanh Endpoint toi uu bang Bash (Fresh Mode)..."
    ips=("162.159.192" "162.159.193" "162.159.195" "162.159.204" "188.114.96" "188.114.97" "188.114.98" "188.114.99")
    ports=(2408 500 864 880 894 934 1070 1180 3476 3581 4198 4500 5279 5956 7103 7152 7559 8319 8854 8886)
    HEX_DATA="\x04\x1d\x69\xe6\x79\x22\x09\x9a\xa0\xb9\x3d\x1e\x7b\x30\x9e\xc5\x85\x1e\xe2\xa3\xd6\xbf\x82\xa8\xbb\x5b\xb0\x3e\xd4\x6f\xb2\x34\x65\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x77\xa4\xa8\xcd\x5d\x88\x3e\x66\x08\x8e\x5f\x70\xad\xb4\x2f\x8a"
    DYNAMIC_ENDPOINT=""
    best_latency=9999

    for i in {1..12}; do
        rand_sub=${ips[$RANDOM % ${#ips[@]}]}
        rand_host=$((RANDOM % 254 + 1))
        rand_port=${ports[$RANDOM % ${#ports[@]}]}
        target_ip="${rand_sub}.${rand_host}"
        
        start_t=$(date +%s%3N)
        res=$(echo -ne "$HEX_DATA" | nc -w 1 -u "$target_ip" "$rand_port" 2>/dev/null | head -c 5 | xxd -p 2>/dev/null)
        end_t=$(date +%s%3N)
        
        if [[ "$res" == "cf00000000" ]]; then
            latency=$((end_t - start_t))
            if [ "$latency" -lt "$best_latency" ]; then
                best_latency=$latency
                DYNAMIC_ENDPOINT="${target_ip}:${rand_port}"
            fi
        fi
    done

    if [ -z "$DYNAMIC_ENDPOINT" ]; then
        log "[WARP-SCAN] Khong scan kip endpoint hop le. Chuyen ve Endpoint mac dinh..."
        DYNAMIC_ENDPOINT="188.114.97.242:7559"
    else
        log "[WARP-SCAN] Da tim thay Endpoint ngon nhat: $DYNAMIC_ENDPOINT (Ping: ${best_latency}ms)"
    fi

    log "[WARP-REG] Dang ky tai khoan thuc qua corsfix.com..."

    openssl genpkey -algorithm X25519 -outform DER -out x25519_priv.der 2>/dev/null
    PRIV_KEY=$(tail -c 32 x25519_priv.der | base64 | tr -d '\n\r ')

    openssl pkey -inform DER -in x25519_priv.der -pubout -outform DER -out x25519_pub.der 2>/dev/null
    PUB_KEY=$(tail -c 32 x25519_pub.der | base64 | tr -d '\n\r ')

    rm -f x25519_priv.der x25519_pub.der
    NOW_ISO=$(date -u +"%Y-%m-%dT%H:%M:%S.000Z")

    REG_RESPONSE=$(HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" curl -s 'https://proxy.corsfix.com/?https://api.cloudflareclient.com/v0a737/reg' \
      -H 'authority: proxy.corsfix.com' \
      -H 'accept: */*' \
      -H 'accept-language: vi-VN,vi;q=0.9' \
      -H 'content-type: application/json' \
      -H 'origin: https://lanrat.github.io' \
      -H 'referer: https://lanrat.github.io/' \
      -H 'user-agent: Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Mobile Safari/537.36' \
      --data-raw "{\"key\":\"$PUB_KEY\",\"install_id\":\"\",\"warp_enabled\":true,\"tos\":\"$NOW_ISO\",\"type\":\"Linux\",\"locale\":\"en_US\"}")

    W_TOKEN=$(echo "$REG_RESPONSE" | python3 -c "import sys, json; data=json.load(sys.stdin); print(data.get('token', ''))" 2>/dev/null)
    W_IPV4=$(echo "$REG_RESPONSE" | python3 -c "import sys, json; data=json.load(sys.stdin); print(data.get('config', {}).get('interface', {}).get('addresses', {}).get('v4', ''))" 2>/dev/null)

    HAS_ACCOUNT=false
    if [ -n "$W_TOKEN" ] && [ "$W_TOKEN" != "None" ] && [ "$W_TOKEN" != "" ]; then
        log "[WARP-REG] -> TAO TAI KHOAN SUCCESS! Dang nap..."
        [[ "$W_IPV4" != *"/"* ]] && W_IPV4="${W_IPV4}/32"
        HAS_ACCOUNT=true
    else
        log "[WARP-REG] -> Tao tai khoan tai corsfix errors, dang thu lai voi proxy.cors.sh..."
        
        REG_RESPONSE=$(HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" curl -s 'https://proxy.cors.sh/https://api.cloudflareclient.com/v0a737/reg' \
          -H 'accept: */*' \
          -H 'content-type: application/json' \
          -H 'x-cors-gratis: true' \
          --data-raw "{\"key\":\"$PUB_KEY\",\"install_id\":\"\",\"warp_enabled\":true,\"tos\":\"$NOW_ISO\",\"type\":\"Linux\",\"locale\":\"en_US\"}")

        W_TOKEN=$(echo "$REG_RESPONSE" | python3 -c "import sys, json; data=json.load(sys.stdin); print(data.get('token', ''))" 2>/dev/null)
        W_IPV4=$(echo "$REG_RESPONSE" | python3 -c "import sys, json; data=json.load(sys.stdin); print(data.get('config', {}).get('interface', {}).get('addresses', {}).get('v4', ''))" 2>/dev/null)
        
        if [ -n "$W_TOKEN" ] && [ "$W_TOKEN" != "None" ] && [ "$W_TOKEN" != "" ]; then
            log "[WARP-REG] -> TAO TAI KHOAN SUCCESS (via cors.sh)! Dang nap..."
            [[ "$W_IPV4" != *"/"* ]] && W_IPV4="${W_IPV4}/32"
            HAS_ACCOUNT=true
        fi
    fi

    if [ "$HAS_ACCOUNT" = true ]; then
        printf "[Interface]\nPrivateKey = %s\nAddress = %s\nDNS = 1.1.1.1\n\n[Peer]\nPublicKey = bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=\nEndpoint = %s\n\n[http]\nBindAddress = 127.0.0.1:4001\n" \
        "$PRIV_KEY" "$W_IPV4" "$DYNAMIC_ENDPOINT" > wireproxy.conf

        HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" wireproxy -c wireproxy.conf >/dev/null 2>&1 &
        sleep 3
        log "--- [WARP] Kích hoạt thành công! HTTP Proxy đang chạy tại cổng 4001 ---"
    else
        log "--- [CẢNH BÁO] Tạo tài khoản thất bại ở cả hai proxy. Không thể thiết lập bộ định tuyến WARP ---"
    fi
    cd /app
}

restore_data() {
    if [ -f "$BACKUP_PATH" ]; then
        log "--- [RESTORE] Tìm thấy bản lưu. Đang giải mã và phục hồi dữ liệu hệ thống... ---"
        if openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_PATH" | tar -xz -C / 2>/dev/null; then
            log "--- [RESTORE] Phục hồi dữ liệu thành công! Bảo đảm cấp lại toàn quyền ghi... ---"
            chmod -R 777 /root /data /app 2>/dev/null || true
        else
            log "--- [RESTORE] Thất bại (Sai mật khẩu hoặc file lỗi) ---"
        fi
    else
        log "--- [RESTORE] Không tìm thấy bản lưu cũ. Khởi tạo môi trường mới. ---"
    fi
}

backup_data() {
    if [ ! -d "/root/data" ] && [ ! -d "/root/.config" ]; then return; fi

    log "--- [BACKUP] Kích hoạt tiến trình nén và mã hóa dữ liệu... ---"
    mkdir -p "$BACKUP_DIR"
    
    if tar -cz -C / \
        --exclude='root/.cache' \
        --exclude='root/.npm' \
        --exclude='tmp/wireproxy_temp' \
        --exclude='root/data/*.db-journal' \
        --exclude='*.log' \
        root 2>/dev/null | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$TEMP_PATH"; then
        
        mv "$TEMP_PATH" "$BACKUP_PATH"
        log "--- [BACKUP] Đã cập nhật bản lưu mã hóa thành công lúc $(date) ---"
    else
        log "--- [BACKUP] Lỗi trong quá trình nén hoặc mã hóa dữ liệu! ---"
        rm -f "$TEMP_PATH"
    fi
}

cleanup() {
    log "!!! [STOP] Container đang bị dừng! Kiểm tra trạng thái ứng dụng trước khi xử lý dữ liệu... !!!"
    if is_app_alive; then
        if [ -d "/root/data" ] || [ -d "/root/.config" ]; then
            tar -cz -C / --exclude='root/.cache' --exclude='root/.npm' --exclude='tmp/wireproxy_temp' --exclude='root/data/*.db-journal' --exclude='*.log' root 2>/dev/null | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$BACKUP_PATH"
            log "!!! [STOP] Đã cứu hộ backup thành công trước khi tắt máy !!!"
        fi
    else
        log "!!! [STOP] Ứng dụng đã sập hoặc chưa từng khởi chạy thành công. HỦY BỎ tiến trình ghi đè dữ liệu cứu hộ để bảo vệ file backup gốc !!!"
    fi
    exit 0
}

trap cleanup SIGTERM SIGINT

# Khởi chạy dịch vụ bảo đảm cô lập ENV proxy
HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" start_warp_proxy
restore_data

(
    LAST_WARP_ROTATE=$(date +%s)

    while true; do
        inotifywait -r -e modify -e create -e delete -e move \
            --exclude '(\.cache|\.npm|wireproxy_temp|\.db-journal|\.log)' \
            /root /app 2>/dev/null

        log "--- [INOTIFY] Phát hiện hệ thống có tệp tin vừa thay đổi! ---"
        log "--- [INOTIFY] Bắt đầu đếm ngược 5 phút (Debounce) trước khi cập nhật file lưu... ---"
        
        sleep 300
        
        if is_app_alive; then
            backup_data
        else
            log "--- [INOTIFY] Bỏ qua sao lưu tự động vì phát hiện ứng dụng chính đã bị dừng hoặc thực sự crash ---"
        fi

        NOW=$(date +%s)
        RUN_TIME=$((NOW - LAST_WARP_ROTATE))
        if [ $RUN_TIME -ge 21600 ]; then
            log "--- [WARP-ROTATE] Đã đạt chu kỳ 6 giờ. Tiến hành làm mới định tuyến mạng... ---"
            HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" start_warp_proxy
            LAST_WARP_ROTATE=$NOW
        fi
    done
) &

log "Đang khởi động Opencode Manager tại /app trên cổng $PORT..."
bun backend/src/index.ts &

sleep 5
while is_app_alive; do
    sleep 5
done

log "--- [EXIT] Tiến trình chính của ứng dụng đã kết thúc ---"
EOF

EXPOSE 7860

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
