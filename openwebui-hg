FROM ghcr.io/open-webui/open-webui:main

USER root

# 1. Cài đặt các công cụ hệ thống cần thiết
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini tar openssl findutils inotify-tools \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 2. Cấu hình biến môi trường
ENV PORT=7860 \
    DATA_DIR=/app/backend/data \
    BACKUP_DIR=/data \
    BACKUP_FILENAME="open_webui_backup.enc" \
    BACKUP_PASS="123456" \
    USER_AGENT="OpenWebUI-Agent" \
    HF_TOKEN="" \
    WEBUI_SECRET_KEY="secret_key_999" \
    # --- TẠO ADMIN SẴN & BẢO MẬT ---
    WEBUI_ADMIN_NAME="admin" \
    WEBUI_ADMIN_EMAIL="admin@example.com" \
    WEBUI_ADMIN_PASSWORD="your_strong_password_here" \
    ENABLE_SIGNUP=False \
    ENABLE_OLLAMA=False \
    WEBUI_AUTH=True

# 3. Phân quyền thư mục
RUN mkdir -p /app/backend/data /data && chown -R 1000:1000 /app /data

# 4. Script Entrypoint xử lý logic chính
RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh
#!/bin/bash
set -e

DATA_PATH="/app/backend/data"
BACKUP_FILE="$BACKUP_DIR/$BACKUP_FILENAME"
TEMP_FILE="/tmp/temp_backup.enc"
INTERVAL_TIME=300 # Gom thay đổi và backup sau đúng 5 phút (300 giây)

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

# --- HÀM PHỤC HỒI ---
restore_data() {
    log "--- [RESTORE] Đang kiểm tra file backup tại $BACKUP_FILE ---"
    if [ -f "$BACKUP_FILE" ]; then
        log "--- [RESTORE] TÌM THẤY bản sao lưu. Đang giải mã và phục hồi... ---"
        if openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_FILE" | tar -xz -C "$DATA_PATH"; then
            log "--- [RESTORE] THÀNH CÔNG! ---"
        else
            log "--- [RESTORE] LỖI: Giải mã thất bại. ---"
        fi
    else
        log "--- [RESTORE] Không có dữ liệu cũ. Bắt đầu phiên mới. ---"
    fi
}

# --- HÀM SAO LƯU (BACKUP TOÀN BỘ KHÔNG LOẠI TRỪ) ---
backup_data() {
    if [ ! "$(ls -A $DATA_PATH 2>/dev/null)" ]; then return; fi

    log "--- [BACKUP] Tiến hành nén toàn bộ và mã hóa... ---"
    
    # Nén sạch 100% nội dung và mã hóa luồng bằng OpenSSL (AES-256-CBC)
    if tar -cz --exclude='cache' -C "$DATA_PATH" . | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$TEMP_FILE"; then
        mv "$TEMP_FILE" "$BACKUP_FILE"
        log "--- [BACKUP] HOÀN TẤT cập nhật bản sao lưu ($BACKUP_FILENAME) ---"
    else
        log "--- [BACKUP] LỖI trong quá trình sao lưu! ---"
        rm -f "$TEMP_FILE"
    fi
}

# --- HÀM XỬ LÝ LẮNG NGHE SỰ KIỆN VÀ GOM THỜI GIAN CỐ ĐỊNH (THROTTLING) ---
watch_changes() {
    log "--- [WATCHER] Đang khởi động inotify-tools để theo dõi $DATA_PATH ---"
    
    BACKUP_PENDING=false

    # Lắng nghe liên tục các sự kiện thay đổi dữ liệu
    inotifywait -m -r -e modify -e move -e create -e delete --exclude 'cache' "$DATA_PATH" 2>/dev/null | while read -r directory events filename; do
        
        # Nếu chưa kích hoạt bộ hẹn giờ gom thay đổi
        if [ "$BACKUP_PENDING" = false ]; then
            BACKUP_PENDING=true
            log "--- [WATCHER] Phát hiện thay đổi đầu tiên. Bắt đầu gom tất cả thay đổi và sẽ backup sau đúng 5 phút... ---"
            
            # Chạy ngầm đếm ngược đúng 5 phút độc lập
            (
                sleep $INTERVAL_TIME
                backup_data
                
                # Báo hiệu hoàn tất để sẵn sàng cho chu kỳ gom tiếp theo
                echo "RESET_PENDING" > /tmp/watcher_status
            ) &
        fi

        # Kiểm tra nếu tiến trình ngầm đã chạy xong để reset cờ hiệu chính
        if [ -f /tmp/watcher_status ]; then
            rm -f /tmp/watcher_status
            BACKUP_PENDING=false
        fi
    done
}

cleanup() {
    trap - TERM INT QUIT
    log "!!! [SHUTDOWN] Đang backup lần cuối trước khi tắt Space... !!!"
    kill $WATCHER_PID 2>/dev/null || true
    backup_data
    kill -TERM "$APP_PID" 2>/dev/null || true
    wait "$APP_PID" 2>/dev/null || true
    log "!!! [SHUTDOWN] Hệ thống đã dừng an toàn. !!!"
    exit 0
}

trap 'cleanup' TERM INT QUIT

# Thực hiện Restore
restore_data

# Khởi chạy Smart Watcher ngầm dựa trên inotify
watch_changes &
WATCHER_PID=$!

# Khởi động Open WebUI
log "Đang khởi động Open WebUI (Admin: $WEBUI_ADMIN_EMAIL)..."
bash /app/backend/start.sh &
APP_PID=$!

wait "$APP_PID" || true
EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

# 5. Cấu hình thực thi
USER 1000
EXPOSE 7860
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
