FROM alpine:latest AS fetcher
RUN apk add --no-cache curl coreutils

WORKDIR /downloads

RUN ZORAXY_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL3RvYnljaHVpL3pvcmF4eS9yZWxlYXNlcy9sYXRlc3QvZG93bmxvYWQvem9yYXh5X2xpbnV4X2FtZDY0" | base64 -d) && \
    curl -L "$ZORAXY_URL" -o z_bin && \
    chmod +x z_bin

RUN CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d) && \
    curl -L "$CF_URL" -o c_bin && \
    chmod +x c_bin

RUN PEN_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL215emhhbmcxMDI5L3Blbmd1aW4tcnMvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL3Blbmd1aW4teDg2XzY0LXVua25vd24tbGludXgtbXVzbA==" | base64 -d) && \
    curl -L "$PEN_URL" -o p_bin && \
    chmod +x p_bin


FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates tini procps bash netcat-openbsd && rm -rf /var/lib/apt/lists/*

ENV PORT=7860 \
    CFGUPGRADE="true" \
    DB="auto" \
    DOCKER="true" \
    ENABLELOG="true" \
    FASTGEOIP="false" \
    MDNS="false" \
    NOAUTH="false" \
    PLUGIN="/data/plugin/" \
    SSHLB="false" \
    VERSION="false" \
    WEBROOT="./www" \
    TZ="Etc/UTC" \
    PENGUIN_PORT=9000 \
    PENGUIN_PSK="mysecretpsk123"

RUN mkdir -p /app/sys1 /app/sys2 /app/sys3 /data/plugin

COPY --from=fetcher /downloads/z_bin /app/sys1/srv_a
COPY --from=fetcher /downloads/c_bin /app/sys2/srv_b
COPY --from=fetcher /downloads/p_bin /app/sys3/srv_c

RUN chmod +x /app/sys1/srv_a /app/sys2/srv_b /app/sys3/srv_c

RUN cat <<'EOF' > /app/entrypoint.sh
#!/bin/bash
set -e

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [ENTRYPOINT] $1"; }

cleanup() {
    trap - TERM INT QUIT
    log "!!! [SHUTDOWN] Dang dung cac dich vu an toan... !!!"
    kill -TERM "$ZORAXY_PID" "$TUNNEL_PID" "$PENGUIN_PID" 2>/dev/null || true
    wait "$ZORAXY_PID" "$PENGUIN_PID" 2>/dev/null || true
    exit 0
}
trap 'cleanup' TERM INT QUIT

if [ ! -z "$TUNNEL_TOKEN" ]; then
    log "Khoi dong Cloudflared Tunnel..."
    /app/sys2/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" &
    TUNNEL_PID=$!
fi

log "Khoi dong Rusty Penguin Server tai cong ${PENGUIN_PORT}..."
/app/sys3/srv_c server \
    --host "0.0.0.0" \
    --port "${PENGUIN_PORT}" \
    --ws-psk "${PENGUIN_PSK}" &
PENGUIN_PID=$!

log "Khoi dong Zoraxy Web UI tai cong ${PORT} (He dieu hanh: Debian | Du lieu: /data)..."
cd /data

/app/sys1/srv_a \
    -cfgupgrade="${CFGUPGRADE}" \
    -db="${DB}" \
    -docker="${DOCKER}" \
    -enablelog="${ENABLELOG}" \
    -fastgeoip="${FASTGEOIP}" \
    -mdns="${MDNS}" \
    -noauth="${NOAUTH}" \
    -plugin="${PLUGIN}" \
    -port=:"${PORT}" \
    -sshlb="${SSHLB}" \
    -version="${VERSION}" \
    -webroot="${WEBROOT}" &
ZORAXY_PID=$!

wait "$ZORAXY_PID" || true
EOF

RUN chmod +x /app/entrypoint.sh

WORKDIR /data

EXPOSE 7860
ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]
