FROM alpine:latest AS fetcher
RUN apk add --no-cache curl jq coreutils

WORKDIR /downloads

RUN ZORAXY_API=$(echo "aHR0cHM6Ly9hcGkuZ2l0aHViLmNvbS9yZXBvcy90b2J5Y2h1aS96b3JheHkvcmVsZWFzZXMvbGF0ZXN0" | base64 -d) && \
    ZORAXY_KEY=$(echo "bGludXhfYW1kNjQ=" | base64 -d) && \
    ZORAXY_URL=$(curl -s "$ZORAXY_API" | jq -r --arg key "$ZORAXY_KEY" '.assets[] | select(.name | contains($key)) | .browser_download_url') && \
    curl -L "$ZORAXY_URL" -o z_bin && \
    chmod +x z_bin

RUN CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d) && \
    curl -L "$CF_URL" -o c_bin && \
    chmod +x c_bin


FROM debian:bookworm-slim
# Loại bỏ các gói phục vụ backup cũ như openssl, findutils, tar để giảm dung lượng image
RUN apt-get update && apt-get install -y ca-certificates tini && rm -rf /var/lib/apt/lists/*

ENV PORT=7860

# Tạo cấu trúc thư mục rõ ràng: /app chứa binaries, /data chứa dữ liệu chạy
RUN mkdir -p /app/sys1 /app/sys2 /data && chown -R 1000:1000 /app /data

COPY --from=fetcher --chown=1000:1000 /downloads/z_bin /app/sys1/srv_a
COPY --from=fetcher --chown=1000:1000 /downloads/c_bin /app/sys2/srv_b

RUN cat <<'EOF' > /app/entrypoint.sh
#!/bin/bash
set -e

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

cleanup() {
    trap - TERM INT QUIT
    log "!!! [SHUTDOWN] Đang dừng các dịch vụ an toàn... !!!"
    kill -TERM "$APP_PID" "$TUNNEL_PID" 2>/dev/null || true
    wait "$APP_PID" 2>/dev/null || true
    exit 0
}

trap 'cleanup' TERM INT QUIT

# Khởi động Cloudflared Tunnel nếu có Token
if [ ! -z "$TUNNEL_TOKEN" ]; then
    log "Khởi động Cloudflared Tunnel..."
    /app/sys2/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" &
    TUNNEL_PID=$!
fi

log "Khởi động Zoraxy trực tiếp tại thư mục /data (Port: ${PORT})..."
# Di chuyển vào /data để mọi file cấu hình, db của Zoraxy tự sinh ra tại đây
cd /data
/app/sys1/srv_a -port=:"${PORT}" -docker &
APP_PID=$!

wait "$APP_PID" || true
EOF

RUN chmod +x /app/entrypoint.sh && chown 1000:1000 /app/entrypoint.sh

# Đặt hẳn WORKDIR tại /data để nhất quán
WORKDIR /data
USER 1000

EXPOSE 7860
ENTRYPOINT ["/usr/bin/tini", "--", "/app/entrypoint.sh"]
