FROM ghcr.io/nextlevelbuilder/goclaw:latest

USER root

RUN apk update && apk add --no-cache \
    curl ca-certificates \
    postgresql18 postgresql18-contrib postgresql-pgvector \
    python3 py3-pip python3-dev build-base libxml2-dev libxslt-dev zlib-dev jpeg-dev linux-headers \
    nodejs npm \
    chromium font-noto \
    git lsof ripgrep grep gawk sed procps jq less tree file pandoc github-cli poppler-utils \
    inotify-tools tini psmisc openssl tar sudo bash

RUN pip3 install --quiet --break-system-packages pypdf Pillow pdfplumber pdf2image defusedxml lxml openpyxl anthropic \
    && npm install -g -q npm@latest > /dev/null 2>&1 \
    && npm install -g -q --prefer-online docx@^9.6.1 pptxgenjs@^4.0.1 @googleworkspace/cli@0.22.5 @anthropic-ai/claude-code@^2.1.91 \
    > /dev/null 2>&1

RUN ARCH=$(apk --print-arch) \
    && if [ "$ARCH" = "x86_64" ]; then \
         curl -fsSL $(echo "aHR0cHM6Ly9naXRodWIuY29tL1ZpUmIzL3dnY2YvcmVsZWFzZXMvZG93bmxvYWQvdjIuMi4zMS93Z2NmXzIuMi4zMV9saW51eF9hbWQ2NA==" | base64 -d) -o /usr/local/bin/wgcf; \
         curl -fsSL $(echo "aHR0cHM6Ly9naXRodWIuY29tL3dpbmR0Zi93aXJlcHJveHkvcmVsZWFzZXMvZG93bmxvYWQvdjEuMS4yL3dpcmVwcm94eV9saW51eF9hbWQ2NC50YXIuZ3o=" | base64 -d) | tar -xz -C /usr/local/bin/ wireproxy; \
       else \
         curl -fsSL $(echo "aHR0cHM6Ly9naXRodWIuY29tL1ZpUmIzL3dnY2YvcmVsZWFzZXMvZG93bmxvYWQvdjIuMi4zMS93Z2NmXzIuMi4zMV9saW51eF9hcm02NA==" | base64 -d) -o /usr/local/bin/wgcf; \
         curl -fsSL $(echo "aHR0cHM6Ly9naXRodWIuY29tL3dpbmR0Zi93aXJlcHJveHkvcmVsZWFzZXMvZG93bmxvYWQvdjEuMS4yL3dpcmVwcm94eV9saW51eF9hbWQ2NC50YXIuZ3o=" | base64 -d) | tar -xz -C /usr/local/bin/ wireproxy; \
       fi \
    && chmod +x /usr/local/bin/wgcf /usr/local/bin/wireproxy

WORKDIR /app

ENV GOCLAW_PORT=7860 \
    GOCLAW_BROWSER_REMOTE_URL=ws://127.0.0.1:9222 \
    GOCLAW_JWT_SECRET=ThayDoiChuoiNayThanhMatKhauCuaBan2026! \
    GOCLAW_GATEWAY_TOKEN=MySuperSecretToken2026! \
    GOCLAW_POSTGRES_DSN=postgres://goclaw_user:goclaw_pass@127.0.0.1:5432/goclaw_db?sslmode=disable \
    GOCLAW_AUTO_UPGRADE=true \
    GOCLAW_ENCRYPTION_KEY=ChuoiBiMat32KyTuGoclawEncryptKey! \
    GOCLAW_CONFIG=/app/config.json \
    GOCLAW_WORKSPACE=/app/workspace \
    GOCLAW_DATA_DIR=/app/data \
    GOCLAW_SKILLS_DIR=/app/skills \
    GOCLAW_MIGRATIONS_DIR=/app/migrations \
    GOCLAW_HOST=0.0.0.0 \
    BACKUP_DIR="/data" \
    BACKUP_FILENAME="goclaw_backup.enc" \
    BACKUP_PASS="123456" \
    HTTP_PROXY="http://127.0.0.1:4001" \
    HTTPS_PROXY="http://127.0.0.1:4001" \
    ALL_PROXY="http://127.0.0.1:4001" \
    NO_PROXY="localhost,127.0.0.1" \
    PATH="/usr/local/bin:/app:/app/data/.runtime/bin:${PATH}" \
    WGCF_FORCE_REGISTER=1

RUN mkdir -p /app/workspace /app/data/.runtime/pip /app/data/.runtime/npm-global/lib \
    /app/data/.runtime/pip-cache /app/data/.runtime/bin /app/data/.claude /app/skills \
    /app/tsnet-state /app/.goclaw /root/.goclaw /var/lib/postgresql/data /data \
    /app/migrations /app/bundled-skills /run/postgresql \
    && chmod -R 777 /data /root /app /var/lib/postgresql /run/postgresql /tmp

COPY <<-"EOF" /usr/local/bin/entrypoint.sh
#!/bin/bash
exec 2>&1
set -x

echo "--- [SYSTEM] SCRIPT ĐÃ KÍCH HOẠT THÀNH CÔNG ---"
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

start_warp_proxy() {
    log "--- [WARP] Đang khởi tạo Proxy mạng sạch... ---"
    killall wireproxy 2>/dev/null || true
    rm -rf /root/wgcf && mkdir -p /root/wgcf && cd /root/wgcf
    
    HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" wgcf register --accept-tos >/dev/null 2>&1
    HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" wgcf generate >/dev/null 2>&1
    
    if [ -f "wgcf-profile.conf" ]; then
        PRIVATE_KEY=$(grep "PrivateKey" wgcf-profile.conf | awk '{print $3}')
        PUBLIC_KEY=$(grep "PublicKey" wgcf-profile.conf | awk '{print $3}')
        ENDPOINT=$(grep "Endpoint" wgcf-profile.conf | awk '{print $3}')
        ADDRESS=$(grep "Address" wgcf-profile.conf | awk '{print $3}' | head -n 1)
        
        cat <<WCONF > wireproxy.conf
[Interface]
PrivateKey = $PRIVATE_KEY
Address = $ADDRESS
DNS = 1.1.1.1

[Peer]
PublicKey = $PUBLIC_KEY
Endpoint = $ENDPOINT

[http]
BindAddress = 127.0.0.1:4001
WCONF

        wireproxy -c wireproxy.conf >/dev/null 2>&1 &
        sleep 2
        log "--- [WARP] Đã lên mạng sạch thành công tại cổng 4001 ---"
    else
        log "--- [WARP] Không thể đăng ký cấu hình mới, bypass proxy hệ thống ---"
        unset HTTP_PROXY HTTPS_PROXY ALL_PROXY
    fi
    cd /app
}

restore_data() {
    if [ -f "$BACKUP_DIR/$BACKUP_FILENAME" ]; then
        log "--- [RESTORE] Tìm thấy bản sao lưu cũ, tiến hành khôi phục dữ liệu... ---"
        openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_DIR/$BACKUP_FILENAME" | tar -xz -C / 2>/dev/null || true
        rm -f /var/lib/postgresql/data/postmaster.pid 2>/dev/null || true
    fi
    chown -R postgres:postgres /var/lib/postgresql /run/postgresql 2>/dev/null || true
    chmod 777 /app /app/workspace /app/skills /data /root /tmp 2>/dev/null || true
}

do_backup() {
    log "--- [AUTO-BACKUP] Đang thực hiện sao lưu dữ liệu... ---"
    mkdir -p "$BACKUP_DIR"
    su - postgres -c "psql -h /tmp -c 'CHECKPOINT;'" >/dev/null 2>&1 || true
    tar -cz -C / var/lib/postgresql/data app/workspace app/data app/skills 2>/dev/null | \
    openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$BACKUP_DIR/$BACKUP_FILENAME.tmp"
    mv "$BACKUP_DIR/$BACKUP_FILENAME.tmp" "$BACKUP_DIR/$BACKUP_FILENAME"
    log "--- [AUTO-BACKUP] Hoàn thành lưu bản backup an toàn ---"
}

watch_and_backup() {
    sleep 10
    log "--- [WATCHER] Kích hoạt chế độ theo dõi thay đổi file bằng inotify ---"
    
    while true; do
        inotifywait -r -e modify -e create -e delete -e move /app/workspace /app/skills /app/data 2>/dev/null
        log "--- [WATCHER] Phát hiện thay đổi, đợi 5 phút (300s) ổn định để gom cụm backup ---"
        sleep 300
        do_backup
    done
}

start_warp_proxy
restore_data

log "--- [DATABASE] Khởi tạo PostgreSQL 18... ---"
if [ ! -s "/var/lib/postgresql/data/PG_VERSION" ]; then
    su - postgres -c "initdb -D /var/lib/postgresql/data"
fi
chmod 700 /var/lib/postgresql/data
su - postgres -c "pg_ctl -D /var/lib/postgresql/data -o '-k /tmp' -l /tmp/postgres.log start"
sleep 3

if ! su - postgres -c "psql -h /tmp -lqt" | cut -d \| -f 1 | grep -qw goclaw_db; then
    su - postgres -c "psql -h /tmp -c \"CREATE USER goclaw_user WITH PASSWORD 'goclaw_pass';\""
    su - postgres -c "psql -h /tmp -c \"CREATE DATABASE goclaw_db OWNER goclaw_user;\""
    su - postgres -c "psql -h /tmp -d goclaw_db -c \"CREATE EXTENSION IF NOT EXISTS vector;\""
fi

log "--- [BROWSER] Kích hoạt Chrome Headless (CDP :9222) ---"
rm -rf /tmp/chromium && mkdir -p /tmp/chromium && chmod 777 /tmp/chromium
chromium-browser --headless=new --no-sandbox --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 --remote-allow-origins=* --disable-gpu --disable-dev-shm-usage --user-data-dir=/tmp/chromium &
sleep 2

if [ -f "/app/pkg-helper" ]; then
    /app/pkg-helper &
    sleep 1
elif [ -f "/usr/local/bin/pkg-helper" ]; then
    /usr/local/bin/pkg-helper &
    sleep 1
fi

watch_and_backup &

log "--- [GOCLAW] Khởi động ứng dụng chính thức ---"
exec /app/goclaw
EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT []

CMD ["/bin/bash", "/usr/local/bin/entrypoint.sh"]
