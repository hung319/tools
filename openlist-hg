FROM alpine:latest AS fetcher
RUN apk add --no-cache curl jq coreutils unzip

WORKDIR /downloads

RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ] || [ "$ARCH" = "amd64" ]; then \
        CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d); \
    else \
        CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFybTY0" | base64 -d); \
    fi && \
    curl -fsSL "$CF_URL" -o srv_b && \
    chmod +x srv_b

FROM ghcr.io/zmabin/openlist-chunk:latest

USER root

RUN apk add --no-cache jq bash tini procps psmisc net-tools shadow aria2

RUN mkdir -p /opt/openlist/sys3 /data && \
    chown -R openlist:openlist /opt/openlist /data

WORKDIR /opt/openlist

COPY --from=fetcher --chown=openlist:openlist /downloads/srv_b /opt/openlist/sys3/srv_b

RUN cat << 'EOF' > /entrypoint.sh
#!/bin/bash
set -e

umask 022

mkdir -p /data/downloads /data/log /tmp/.config /tmp/.local

usermod -u 1000 openlist 2>/dev/null || true
groupmod -g 1000 openlist 2>/dev/null || true
chown -R openlist:openlist /data /opt/openlist /tmp 2>/dev/null || true
chmod -R 777 /data /opt/openlist /tmp 2>/dev/null || true

if [ "$RUN_ARIA2" = "true" ]; then
    echo "[AIO] khoi hanh Aria2..."
    mkdir -p /tmp/.config/aria2
    [ ! -f /tmp/.config/aria2/aria2.session ] && touch /tmp/.config/aria2/aria2.session
    aria2c --enable-rpc --rpc-listen-all --rpc-allow-origin-all --dir=/data/downloads --input-file=/tmp/.config/aria2/aria2.session --save-session=/tmp/.config/aria2/aria2.session >/dev/null 2>&1 &
fi

fuser -k "7860/tcp" 2>/dev/null || true
if [ -n "$TUNNEL_TOKEN" ]; then
    echo "[CLOUDFLARE] Dang khoi dong Cloudflare Tunnel..."
    /opt/openlist/sys3/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" >/dev/null 2>&1 &
else
    echo "[CLOUDFLARE] Canh bao: Khong tim thay TUNNEL_TOKEN!"
fi

cd /data

CONFIG_FILE="/data/config.json"

if [ ! -f "$CONFIG_FILE" ]; then
    echo "[CONFIG] Khong tim thay config.json tren /data. Dang tu tao cau hinh mac dinh..."
    /opt/openlist/openlist server --no-prefix --config /data/config.json --data /data &
    PID_TEMP=$!
    sleep 3
    kill $PID_TEMP 2>/dev/null || true
fi

if [ -f "$CONFIG_FILE" ]; then
    if [ ! -s "$CONFIG_FILE" ] || ! jq empty "$CONFIG_FILE" 2>/dev/null; then
        echo "[CONFIG] Canh bao: File config.json bi loi hoac trong rong! Dang xoa de khoi tao lai..."
        rm -f "$CONFIG_FILE"
        /opt/openlist/openlist server --no-prefix --config /data/config.json --data /data &
        PID_TEMP=$!
        sleep 3
        kill $PID_TEMP 2>/dev/null || true
    fi
fi

if [ -f "$CONFIG_FILE" ]; then
    echo "[CONFIG] Cap nhat va sua loi cau hinh mac dinh bang jq..."
    TMP_CONFIG=$(mktemp)
    
    jq \
      --arg site_url "$SITE_URL" \
      --arg jwt_secret "$JWT_SECRET" \
      --arg meili_host "$MEILI_HOST" \
      --arg meili_key "$MEILI_KEY" \
      --arg meili_index "$MEILI_INDEX" \
      '
      .scheme.http_port = 7860 |
      .database = {"type": "sqlite3", "db_path": "/data/data.db"} |
      (if $site_url != "" then .site_url = $site_url else . end) |
      (if $jwt_secret != "" then .jwt_secret = $jwt_secret else . end) |
      (if $meili_host != "" then .meilisearch.host = $meili_host else . end) |
      (if $meili_key != "" then .meilisearch.api_key = $meili_key else . end) |
      (if $meili_index != "" then .meilisearch.index = $meili_index else . end)
      ' "$CONFIG_FILE" > "$TMP_CONFIG"

    sync
    mv "$TMP_CONFIG" "$CONFIG_FILE"
    chown openlist:openlist "$CONFIG_FILE"
    chmod 666 "$CONFIG_FILE"
fi

echo "[MAIN] Khoi dong OpenList Chunk chinh thuc tu WORKDIR=/data..."
exec /opt/openlist/openlist server --no-prefix --config /data/config.json --data /data
EOF

RUN chmod +x /entrypoint.sh

ENV PORT=7860 \
    RUN_ARIA2=true \
    HOME=/data \
    XDG_CONFIG_HOME=/data/.config \
    XDG_DATA_HOME=/data/.local \
    PYTHONUNBUFFERED=1 \
    TUNNEL_TOKEN="" \
    SITE_URL="" \
    JWT_SECRET="" \
    MEILI_HOST="" \
    MEILI_KEY="" \
    MEILI_INDEX=""

USER root
EXPOSE 7860

ENTRYPOINT ["/sbin/tini", "--", "/bin/bash", "/entrypoint.sh"]
