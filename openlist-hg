FROM alpine:latest AS fetcher
RUN apk add --no-cache curl jq coreutils unzip

WORKDIR /downloads

RUN ARCH=$(uname -m) && \
    CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d) && \
    # Sử dụng link zip chứa binary warp đã mã hóa base64 theo yêu cầu
    WARP_ZIP_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2hoc3cyMDE1L2Nsb3VkZmxhcmUtd2FycC9yZWxlYXNlcy9kb3dubG9hZC92MS4wL3dhcnAtbGludXgtYW1kNjQuemlw" | base64 -d) && \
    if [ "$ARCH" != "x86_64" ] && [ "$ARCH" != "amd64" ]; then \
        echo "Luu y: Link zip hien tai chi ho tro amd64/x86_64!" && \
        CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFybTY0" | base64 -d); \
    fi && \
    curl -fsSL "$WARP_ZIP_URL" -o warp.zip && unzip warp.zip && mv warp srv_w && \
    curl -fsSL "$CF_URL" -o srv_b && \
    chmod +x srv_w srv_b

FROM ghcr.io/openlistteam/openlist-git:latest-aio

USER root

RUN apk add --no-cache jq bash tini openssl inotify-tools procps psmisc net-tools shadow transmission-daemon && \
    apk add --no-cache --repository=https://dl-cdn.alpinelinux.org/alpine/edge/community qbittorrent-nox

RUN mkdir -p /opt/openlist/sys1 /opt/openlist/sys3 /data && \
    chown -R openlist:openlist /opt/openlist /data

WORKDIR /opt/openlist

# sys1 giữ binary warp (srv_w), sys3 giữ cloudflared (srv_b). Không cần sys2 nữa.
COPY --from=fetcher --chown=openlist:openlist /downloads/srv_w /opt/openlist/sys1/srv_w
COPY --from=fetcher --chown=openlist:openlist /downloads/srv_b /opt/openlist/sys3/srv_b

RUN cat << 'EOF' > /entrypoint.sh
#!/bin/bash

mkdir -p /data/watch /data/downloads /opt/openlist/data /tmp/.config /tmp/.local
usermod -u 1000 openlist 2>/dev/null || true
groupmod -g 1000 openlist 2>/dev/null || true
chown -R openlist:openlist /data /opt/openlist /tmp 2>/dev/null || true
chmod -R 777 /data /opt/openlist /tmp 2>/dev/null || true

if [ "$RUN_ARIA2" = "true" ]; then
    echo "[AIO] khoi hanh Aria2..."
    mkdir -p /tmp/.config/aria2
    [ ! -f /tmp/.config/aria2/aria2.session ] && touch /tmp/.config/aria2/aria2.session
    aria2c --enable-rpc --rpc-listen-all --rpc-allow-origin-all --dir=/data --input-file=/tmp/.config/aria2/aria2.session --save-session=/tmp/.config/aria2/aria2.session --all-proxy="http://127.0.0.1:4001" >/dev/null 2>&1 &
fi

if [ "$RUN_QBITTORRENT" = "true" ]; then
    echo "[AIO] khoi hanh qBittorrent..."
    mkdir -p /tmp/.config/qBittorrent
    cat <<EON > /tmp/.config/qBittorrent/qBittorrent.conf
[Preferences]
WebUI\Port=8080
WebUI\User=admin
WebUI\Password_PBKDF2="@ByteArray(ARQ77eY1NUZaQsuDHbIMCA==:0WMRkYTUWVT9wVvdDtHAjU9b3b7uB8NR1Gur2hmQCvCDpm39Q+PsJRJPaCU51dEiz+dTzh8qbPsL8WkFljQYFQ==)"
Proxy\Type=1
Proxy\IP=127.0.0.1
Proxy\Port=4001
Proxy\ProxyPeerConnections=true
Proxy\ProxyHostNameLookup=true
EON
    qbittorrent-nox --confirm-legal-notice >/dev/null 2>&1 &
fi

if [ "$RUN_TRANSMISSION" = "true" ]; then
    echo "[AIO] khoi hanh Transmission..."
    mkdir -p /tmp/.config/transmission-daemon
    export HTTP_PROXY="http://127.0.0.1:4001" HTTPS_PROXY="http://127.0.0.1:4001" ALL_PROXY="http://127.0.0.1:4001"
    transmission-daemon --foreground --port 9091 --config-dir /tmp/.config/transmission-daemon --download-dir /data/downloads --watch-dir /data/watch >/dev/null 2>&1 &
fi

fuser -k "7860/tcp" 2>/dev/null || true
if [ -n "$TUNNEL_TOKEN" ]; then
    echo "[CLOUDFLARE] Dang khoi dong Cloudflare Tunnel..."
    /opt/openlist/sys3/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" >/dev/null 2>&1 &
else
    echo "[CLOUDFLARE] Canh bao: Khong tim thay TUNNEL_TOKEN!"
fi

# KHỞI ĐỘNG CLOUDFLARE-WARP MỚI THAY THẾ WGCF + WIREPROXY
(
    echo "[CLOUDFLARE-WARP] Bat dau setup va khoi dong proxy..."
    mkdir -p /tmp/warp_data && cd /tmp/warp_data
    
    # Kiểm tra xem tài khoản đã được đăng ký chưa, nếu chưa thì tạo mới
    if [ ! -f "reg.json" ]; then
        echo "[CLOUDFLARE-WARP] Dang khoi tao tai khoan Warp moi..."
        /opt/openlist/sys1/srv_w --data-dir /tmp/warp_data generate >/dev/null 2>&1
    fi

    # Khởi chạy đồng thời cả SOCKS5 và HTTP proxy trên port 4001 như cũ để tương thích hệ thống
    echo "[CLOUDFLARE-WARP] Dang chay proxy tai port 4001..."
    /opt/openlist/sys1/srv_w --data-dir /tmp/warp_data run --socks-addr 127.0.0.1:4001 --http-addr 127.0.0.1:4001 >/dev/null 2>&1
) &

CONFIG_FILE="/opt/openlist/data/config.json"

if [ -f "$BACKUP_DIR/$BACKUP_FILENAME" ]; then
    echo "[RESTORE] Thuc hien giai nen phuc hoi..."
    openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_DIR/$BACKUP_FILENAME" | tar -xz -C / 2>/dev/null && echo "[RESTORE] Xong!"
fi

if [ ! -f "$CONFIG_FILE" ]; then
    echo "[CONFIG] Khong tim thay config.json. Dang tu tao cau hinh mac dinh..."
    ./openlist server --no-prefix &
    PID_TEMP=$!
    sleep 3
    kill $PID_TEMP 2>/dev/null || true
fi

if [ -f "$CONFIG_FILE" ]; then
    echo "[CONFIG] Chinh sua file config..."
    sed -i 's/"http_port": 5244/"http_port": 7860/g' "$CONFIG_FILE"
    sed -i 's/"enable": false/"enable": true/g' "$CONFIG_FILE"
    sed -i 's|"proxy_address": ""|"proxy_address": "http://127.0.0.1:4001"|g' "$CONFIG_FILE"
    
    if [ -n "$SITE_URL" ]; then
        sed -i "s|\"site_url\": \"\"|\"site_url\": \"$SITE_URL\"|g" "$CONFIG_FILE"
    fi
    if [ -n "$JWT_SECRET" ]; then
        sed -i "s|\"jwt_secret\": \"random_generated\"|\"jwt_secret\": \"$JWT_SECRET\"|g" "$CONFIG_FILE"
    fi
    if [ -n "$MEILI_HOST" ]; then
        sed -i "s|\"host\": \"http://localhost:7700\"|\"host\": \"$MEILI_HOST\"|g" "$CONFIG_FILE"
    fi
    if [ -n "$MEILI_KEY" ]; then
        sed -i "s|\"api_key\": \"\"|\"api_key\": \"$MEILI_KEY\"|g" "$CONFIG_FILE"
    fi
    if [ -n "$MEILI_INDEX" ]; then
        sed -i "s|\"index\": \"openlist\"|\"index\": \"$MEILI_INDEX\"|g" "$CONFIG_FILE"
        sed -i "s|\"index\": \"\"|\"index\": \"$MEILI_INDEX\"|g" "$CONFIG_FILE"
    fi
fi

(
    while true; do
        inotifywait -r -e modify -e create -e delete -e move --exclude "(\.cache|.*\.log|.*\.pid)" /opt/openlist/data 2>/dev/null || true
        echo "[INOTIFY] Co bien dong du lieu! Delay 5 phut..."
        sleep 300
        if netstat -an | grep -q "7860.*LISTEN"; then
            echo "[BACKUP] Dang ma hoa sao luu..."
            mkdir -p "$BACKUP_DIR"
            if tar -cz -C / --exclude="opt/openlist/data/cache" --exclude="*.log" --exclude="*.pid" opt/openlist/data 2>/dev/null | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "/tmp/temp_openlist.enc"; then
                if mv "/tmp/temp_openlist.enc" "$BACKUP_DIR/$BACKUP_FILENAME"; then
                    echo "[BACKUP] Thanh cong!"
                else
                    echo "[BACKUP] That bai: Khong the di chuyen file vao /data!"
                fi
            else
                echo "[BACKUP] That bai: Loi ma hoa!"
            fi
        else
            echo "[BACKUP] Huy bo vi openlist chua bat hoac hoat dong khong on dinh."
        fi
    done
) &

export HTTP_PROXY="http://127.0.0.1:4001" HTTPS_PROXY="http://127.0.0.1:4001" ALL_PROXY="http://127.0.0.1:4001"
sleep 5

echo "[MAIN] Khoi dong OpenList chinh thuc tren port 7860..."
exec ./openlist server --no-prefix
EOF

RUN chmod +x /entrypoint.sh

ENV PORT=7860 \
    RUN_ARIA2=true \
    RUN_QBITTORRENT=true \
    RUN_TRANSMISSION=true \
    HOME=/tmp \
    XDG_CONFIG_HOME=/tmp/.config \
    XDG_DATA_HOME=/tmp/.local \
    BACKUP_DIR="/data" \
    BACKUP_FILENAME="openlist_backup.enc" \
    BACKUP_PASS="123456" \
    NO_PROXY="localhost,127.0.0.1" \
    PYTHONUNBUFFERED=1 \
    TUNNEL_TOKEN="" \
    SITE_URL="" \
    JWT_SECRET="" \
    MEILI_HOST="" \
    MEILI_KEY="" \
    MEILI_INDEX=""

USER root
EXPOSE 7860

ENTRYPOINT ["/sbin/tini", "--", "/bin/bash", "/entrypoint.sh"]
