# Sử dụng Debian Bullseye Slim làm nền tảng
FROM node:20-bullseye-slim

# --- CÀI ĐẶT UV (Trình quản lý Python) ---
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# --- CÀI ĐẶT BUN (Runtime JS cực nhanh) ---
RUN apt-get update && apt-get install -y curl unzip \
    && curl -fsSL https://bun.sh/install | bash \
    && mv /root/.bun/bin/bun /usr/local/bin/bun \
    && rm -rf /root/.bun

# Biến môi trường - ĐÃ ĐỔI PORT SANG 7860
ENV PATH="/usr/local/bin:/usr/bin:${PATH}" \
    PORT=7860 \
    HOSTNAME=0.0.0.0 \
    NODE_ENV=production \
    BACKUP_DIR="/data" \
    BACKUP_FILENAME="opencode_backup.zip" \
    BACKUP_PASS="123456"

WORKDIR /root

# Cài đặt các công cụ cần thiết
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git ssh build-essential tini procps unzip psmisc \
        make g++ python3 zip inotify-tools \
    && uv python install 3.12 \
    && npm install -g opencode-ai@latest \
    && npm cache clean --force \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Fix quyền thực thi cho opencode
RUN chmod +x /usr/local/lib/node_modules/opencode-ai/bin/.opencode || true

# --- ENTRYPOINT SCRIPT: FIX LỖI SPAM BACKUP ---
RUN cat <<'EOF' > /usr/local/bin/entrypoint && chmod +x /usr/local/bin/entrypoint
#!/bin/bash
set -e

restore_data() {
    if [ -f "$BACKUP_DIR/$BACKUP_FILENAME" ]; then
        echo "--- [RESTORE] Đang phục hồi dữ liệu từ $BACKUP_FILENAME... ---"
        unzip -oP "$BACKUP_PASS" "$BACKUP_DIR/$BACKUP_FILENAME" -d / > /dev/null 2>&1 || true
        echo "--- [RESTORE] Thành công! ---"
    else
        echo "--- [RESTORE] Không tìm thấy file backup. Khởi tạo mới. ---"
    fi
}

backup_data() {
    if [ ! "$(ls -A /root)" ]; then return; fi
    echo "--- [BACKUP] Đang nén dữ liệu... ---"
    mkdir -p "$BACKUP_DIR"
    
    # Loại trừ cache và các file tạm của SQLite (.db-wal, .db-shm) để tránh loop backup
    zip -qrP "$BACKUP_PASS" "/tmp/temp_backup.zip" /root \
        -x "/root/.cache/*" "/root/.npm/*" "/root/.uv/*" "/root/.bun/*" \
        "*.db-wal" "*.db-shm" "*.log" 2>/dev/null || true
        
    if [ -f "/tmp/temp_backup.zip" ]; then
        mv "/tmp/temp_backup.zip" "$BACKUP_DIR/$BACKUP_FILENAME"
        echo "--- [BACKUP] Đã cập nhật lúc $(date) ---"
    fi
}

cleanup() {
    echo "!!! [STOP] Đang thực hiện backup cuối cùng trước khi tắt... !!!"
    backup_data
    [ -n "$CHILD_PID" ] && kill -TERM "$CHILD_PID"
    exit 0
}

trap cleanup SIGTERM SIGINT

# Bắt đầu quy trình
restore_data
backup_data

# Vòng lặp theo dõi thay đổi thông minh hơn
(
    while true; do
        # Chờ đợi thay đổi, bỏ qua các file log và database tạm
        inotifywait -r -e modify,create,delete,move -t 300 \
            --excludei '(/\.cache|/\.npm|/\.uv|/\.bun|/log/|\.log$|.*\.db-wal$|.*\.db-shm$)' /root 2>/dev/null || true
        
        # Đợi thêm 5 phút (300s) sau khi có thay đổi để gom cụm dữ liệu, tránh backup quá nhiều lần
        sleep 300
        backup_data
    done
) &

echo "Đang khởi động Opencode-AI trên Port: ${PORT}..."
opencode serve --port "${PORT}" --hostname "${HOSTNAME}" &

CHILD_PID=$!
wait "$CHILD_PID"
EOF

EXPOSE 7860

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint"]
