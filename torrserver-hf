FROM ghcr.io/9000000/torrserver:master

USER root

RUN apk update && apk add --no-cache \
    bash \
    openssl \
    inotify-tools \
    curl \
    ca-certificates \
    procps \
    psmisc \
    jq

RUN ARCH=$(uname -m) \
    && GITHUB_API=$(echo "aHR0cHM6Ly9hcGkuZ2l0aHViLmNvbS9yZXBvcy9WaVJiMy93Z2NmL3JlbGVhc2VzL2xhdGVzdA==" | base64 -d) \
    && DOWNLOAD_URL=$(curl -fsSL "$GITHUB_API" | jq -r ".assets[].browser_download_url") \
    && if [ "$ARCH" = "x86_64" ]; then \
         WGCF_URL=$(echo "$DOWNLOAD_URL" | grep -E "linux_amd64$|linux_amd64\.bin$"); \
       else \
         WGCF_URL=$(echo "$DOWNLOAD_URL" | grep -E "linux_arm64$|linux_arm64\.bin$"); \
       fi \
    && curl -fsSL "$WGCF_URL" -o /usr/local/bin/wgcf \
    && chmod +x /usr/local/bin/wgcf

RUN ARCH=$(uname -m) \
    && GITHUB_API_WP=$(echo "aHR0cHM6Ly9hcGkuZ2l0aHViLmNvbS9yZXBvcy93aW5kdGYvd2lyZXByb3h5L3JlbGVhc2VzL2xhdGVzdA==" | base64 -d) \
    && DOWNLOAD_URL_WP=$(curl -fsSL "$GITHUB_API_WP" | jq -r ".assets[].browser_download_url") \
    && if [ "$ARCH" = "x86_64" ]; then \
         WP_URL=$(echo "$DOWNLOAD_URL_WP" | grep -E "linux_amd64\.tar\.gz$"); \
       else \
         WP_URL=$(echo "$DOWNLOAD_URL_WP" | grep -E "linux_arm64\.tar\.gz$"); \
       fi \
    && curl -fsSL "$WP_URL" | tar -xz -C /usr/local/bin/ wireproxy \
    && chmod +x /usr/local/bin/wireproxy

ENV TS_PORT=7860
ENV TS_CONF_PATH="/root/.config/torrserver"
ENV TS_SETTINGS="/root/.config/torrserver/settings.json"
ENV TS_TORR_DIR="/root/torrents"
ENV TS_LOG_PATH="/root/torr.log"
ENV TS_RDB=1
ENV GODEBUG=madvdontneed=1

ENV BACKUP_DIR="/data" \
    BACKUP_FILENAME="torrserver_backup.enc" \
    BACKUP_PASS="torrserver123" \
    HTTP_PROXY="http://127.0.0.1:4001" \
    HTTPS_PROXY="http://127.0.0.1:4001" \
    ALL_PROXY="http://127.0.0.1:4001" \
    NO_PROXY="localhost,127.0.0.1"

WORKDIR /root

RUN mkdir -p /root/.config/torrserver /root/torrents /data /tmp/wgcf_temp && chmod -R 777 /root /data

RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh
#!/bin/bash
set +e

BACKUP_PATH="$BACKUP_DIR/$BACKUP_FILENAME"
TEMP_PATH="/tmp/temp_torr.enc"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

start_warp_proxy() {
    log "--- [WARP] Đang khởi tạo và đăng ký tài khoản Cloudflare trực tiếp qua WGCF... ---"
    killall wireproxy 2>/dev/null || true
    rm -rf /tmp/wgcf_temp && mkdir -p /tmp/wgcf_temp && cd /tmp/wgcf_temp
    
    unset HTTP_PROXY HTTPS_PROXY ALL_PROXY
    
    wgcf register --accept-tos >/dev/null 2>&1 || true
    wgcf generate >/dev/null 2>&1 || true

    if [ -f "wgcf-profile.conf" ]; then
        PRIVATE_KEY=$(grep "PrivateKey" wgcf-profile.conf | awk '{print $3}')
        PUBLIC_KEY=$(grep "PublicKey" wgcf-profile.conf | awk '{print $3}')
        ENDPOINT=$(grep "Endpoint" wgcf-profile.conf | awk '{print $3}')
        ADDRESS=$(grep "Address" wgcf-profile.conf | awk '{print $3}' | head -n 1)

        cat <<WCONF > wireproxy.conf
[Interface]
PrivateKey = $PRIVATE_KEY
Address = $ADDRESS
DNS = 1.1.1.1

[Peer]
PublicKey = $PUBLIC_KEY
Endpoint = $ENDPOINT

[http]
BindAddress = 127.0.0.1:4001
WCONF

        wireproxy -c wireproxy.conf >/dev/null 2>&1 &
        sleep 4
        
        export HTTP_PROXY="http://127.0.0.1:4001"
        export HTTPS_PROXY="http://127.0.0.1:4001"
        export ALL_PROXY="http://127.0.0.1:4001"
        
        if pgrep wireproxy > /dev/null; then
            log "--- [WARP] Kích hoạt thành công! Định tuyến TorrServer thông qua Proxy cổng 4001 ---"
        else
            log "--- [CẢNH BÁO] wireproxy gặp lỗi khi khởi động, chạy mạng trực tiếp ---"
            unset HTTP_PROXY HTTPS_PROXY ALL_PROXY
        fi
    else
        log "--- [CẢNH BÁO] Đăng ký WGCF thất bại, TorrServer sẽ chạy mạng trực tiếp ---"
        export HTTP_PROXY="http://127.0.0.1:4001"
        export HTTPS_PROXY="http://127.0.0.1:4001"
        export ALL_PROXY="http://127.0.0.1:4001"
        unset HTTP_PROXY HTTPS_PROXY ALL_PROXY
    fi
    cd /root
}

restore_data() {
    if [ -f "$BACKUP_PATH" ]; then
        log "--- [RESTORE] Tìm thấy bản sao lưu cũ. Tiến hành giải mã cấu hình TorrServer... ---"
        if openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_PATH" 2>/dev/null | tar -xz -C / 2>/dev/null; then
            log "--- [RESTORE] Phục hồi danh sách torrent và cấu hình thành công! ---"
        else
            log "--- [RESTORE] Bản sao lưu cũ bị lỗi giải mã hoặc không tương thích cấu trúc mới. Tiến hành tạo mới hoàn toàn ---"
            rm -f "$BACKUP_PATH"
        fi
    else
        log "--- [RESTORE] Chưa có bản sao lưu tại $BACKUP_PATH. Chạy cấu hình mới hoàn toàn. ---"
    fi
}

backup_data() {
    log "--- [BACKUP] Kích hoạt tiến trình đồng bộ dữ liệu vào không gian lưu trữ bền vững... ---"
    mkdir -p "$BACKUP_DIR"
    
    if tar -cz -C / \
        --exclude='root/.cache' \
        --exclude='root/torr.log' \
        root/.config/torrserver root/torrents 2>/dev/null | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$TEMP_PATH" 2>/dev/null; then
        
        mv "$TEMP_PATH" "$BACKUP_PATH"
        log "--- [BACKUP] Đồng bộ cơ sở dữ liệu và cấu hình cài đặt thành công! ---"
    else
        rm -f "$TEMP_PATH"
        log "--- [BACKUP] Thất bại trong quá trình nén và mã hóa ---"
    fi
}

cleanup() {
    log "!!! [STOP] Nhận tín hiệu tắt máy khẩn cấp từ Hugging Face. Tiến hành backup... !!!"
    backup_data
    [ -n "${APP_PID:-}" ] && kill -TERM "$APP_PID" 2>/dev/null
    exit 0
}

trap cleanup SIGTERM SIGINT

start_warp_proxy
restore_data

(
    while true; do
        inotifywait -r -e modify -e create -e delete -e move \
            /root/.config/torrserver /root/torrents 2>/dev/null

        log "--- [INOTIFY] Phát hiện cấu hình hệ thống (settings/database) vừa thay đổi dữ liệu ---"
        log "--- [INOTIFY] Đợi tạm hoãn 5 phút (Debounce) để gom dữ liệu trước khi lưu... ---"
        
        sleep 300
        backup_data
    done
) &

fuser -k "${TS_PORT}/tcp" 2>/dev/null || true

RDB_FLAG=""
if [ "${TS_RDB}" = "1" ]; then
    log "--- [CONFIG] Phát hiện cấu hình TS_RDB=1. Tự động kích hoạt chế độ Read-Only DB (--rdb) ---"
    RDB_FLAG="--rdb"
fi

log "--- [START] Khởi chạy TorrServer chính chủ trên cổng ${TS_PORT}... ---"

if pgrep wireproxy > /dev/null; then
    /usr/bin/torrserver \
        --port "${TS_PORT}" \
        --path "${TS_CONF_PATH}" \
        --torrentsdir "${TS_TORR_DIR}" \
        --logpath "${TS_LOG_PATH}" \
        --proxyurl "socks5h://127.0.0.1:4001" \
        --proxymode "full" \
        $RDB_FLAG &
else
    /usr/bin/torrserver \
        --port "${TS_PORT}" \
        --path "${TS_CONF_PATH}" \
        --torrentsdir "${TS_TORR_DIR}" \
        --logpath "${TS_LOG_PATH}" \
        $RDB_FLAG &
fi

APP_PID=$!
wait "$APP_PID"
EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 7860

ENTRYPOINT ["/bin/bash", "/usr/local/bin/entrypoint.sh"]
