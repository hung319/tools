FROM n8nio/n8n:latest

USER root

# --- 1. Tạo script mã hóa AES-256 bằng Node.js (nhẹ và nhanh) ---
RUN cat << 'EOF' > /crypto.js
const crypto = require('crypto');
const fs = require('fs');

const mode = process.argv[2];
const inFile = process.argv[3];
const outFile = process.argv[4];
const pass = process.env.BACKUP_PASS;

if (!pass) {
    console.error("LỖI: Thiếu biến môi trường BACKUP_PASS");
    process.exit(1);
}

try {
    const key = crypto.scryptSync(pass, 'n8n-backup-salt', 32);
    
    if (mode === 'enc') {
        const iv = crypto.randomBytes(16);
        const cipher = crypto.createCipheriv('aes-256-cbc', key, iv);
        const input = fs.createReadStream(inFile);
        const output = fs.createWriteStream(outFile);
        output.write(iv); 
        input.pipe(cipher).pipe(output).on('finish', () => process.exit(0));
        
    } else if (mode === 'dec') {
        if (!fs.existsSync(inFile)) process.exit(1);
        const fd = fs.openSync(inFile, 'r');
        const iv = Buffer.alloc(16);
        fs.readSync(fd, iv, 0, 16, 0);
        fs.closeSync(fd);
        
        const decipher = crypto.createDecipheriv('aes-256-cbc', key, iv);
        const input = fs.createReadStream(inFile, { start: 16 });
        const output = fs.createWriteStream(outFile);
        input.pipe(decipher).pipe(output).on('finish', () => process.exit(0));
    }
} catch (err) {
    console.error("Lỗi Crypto:", err.message);
    process.exit(1);
}
EOF

# --- 2. Tạo script Entrypoint điều khiển n8n và Backup ---
RUN cat << 'EOF' > /entrypoint.sh
#!/bin/sh
set -e

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

# Đảm bảo các thư mục tồn tại
mkdir -p /home/node/.n8n "$BACKUP_DIR"

# 1. Hàm Phục hồi dữ liệu (Chạy khi khởi động)
restore_data() {
    log "--- [RESTORE] Đang kiểm tra file backup tại $BACKUP_DIR/$BACKUP_FILENAME ---"
    if [ -f "$BACKUP_DIR/$BACKUP_FILENAME" ]; then
        log "--- [RESTORE] TÌM THẤY bản sao lưu. Đang giải mã..."
        rm -f /tmp/n8n_temp.tar.gz
        if node /crypto.js dec "$BACKUP_DIR/$BACKUP_FILENAME" /tmp/n8n_temp.tar.gz; then
            log "--- [RESTORE] Đang bung file vào /home/node/.n8n ..."
            tar -xzf /tmp/n8n_temp.tar.gz -C /home/node
            log "--- [RESTORE] THÀNH CÔNG! ---"
        else
            log "--- [RESTORE] LỖI: Giải mã thất bại. ---"
        fi
        rm -f /tmp/n8n_temp.tar.gz
    else
        log "--- [RESTORE] Không có file cũ trong Bucket. Bắt đầu như mới. ---"
    fi
}

# 2. Hàm Sao lưu dữ liệu (Smart Backup)
backup_data() {
    DB_FILE="/home/node/.n8n/database.sqlite"
    BACKUP_FILE="$BACKUP_DIR/$BACKUP_FILENAME"
    
    if [ ! -f "$DB_FILE" ]; then return; fi

    # KIỂM TRA THÔNG MINH: Chỉ chạy nếu DB mới hơn file backup
    if [ -f "$BACKUP_FILE" ]; then
        if [ ! "$DB_FILE" -nt "$BACKUP_FILE" ]; then
            # Không có thay đổi, thoát sớm để tiết kiệm tài nguyên
            return
        fi
    fi

    log "--- [BACKUP] Phát hiện thay đổi! Đang sao lưu vào Bucket... ---"
    rm -f /tmp/n8n_temp.tar.gz
    # Nén (loại bỏ cache và log để file nhẹ nhất có thể)
    tar -czf /tmp/n8n_temp.tar.gz --exclude='.n8n/binaryData' --exclude='.n8n/cache' --exclude='*.log' -C /home/node .n8n
    
    if node /crypto.js enc /tmp/n8n_temp.tar.gz "$BACKUP_FILE"; then
        log "--- [BACKUP] HOÀN TẤT lưu vào Bucket ---"
    else
        log "--- [BACKUP] LỖI khi mã hóa! ---"
    fi
    rm -f /tmp/n8n_temp.tar.gz
}

# 3. Hàm xử lý khi tắt máy (Shutdown)
cleanup() {
    trap - TERM INT QUIT
    log "--- [SHUTDOWN] Hugging Face đang tắt Space! Đang backup lần cuối... ---"
    kill $WATCHER_PID 2>/dev/null || true
    backup_data
    kill -TERM "$N8N_PID" 2>/dev/null || true
    wait "$N8N_PID" 2>/dev/null || true
    log "--- [SHUTDOWN] Tạm biệt! ---"
    exit 0
}

trap 'cleanup' TERM INT QUIT

# --- THỰC THI ---
restore_data

# Khởi chạy Smart Watcher ngầm (Quét mỗi 30s)
(
    while true; do
        sleep 30
        backup_data
    done
) &
WATCHER_PID=$!

log "--- [START] n8n đang khởi động... ---"
n8n start &
N8N_PID=$!

wait "$N8N_PID" || true
EOF

RUN chmod +x /entrypoint.sh

# --- 3. Cấu hình biến môi trường ---
# N8N_ENCRYPTION_KEY: Thay bằng chuỗi bí mật của bạn
# BACKUP_PASS: Mật khẩu để mã hóa file .enc
ENV N8N_PORT=7860 \
    BACKUP_DIR=/data \
    BACKUP_FILENAME=n8n_backup.enc \
    BACKUP_PASS=MatKhauSaoLuu123 \
    N8N_ENCRYPTION_KEY=ChuoiBiMatCuaRiengBan_999

# Cấp quyền cho user node
RUN mkdir -p /data && chown -R node:node /data /home/node

USER node
EXPOSE 7860

# Dùng tini để xử lý tín hiệu TERM chuẩn xác
ENTRYPOINT ["tini", "--", "/bin/sh", "/entrypoint.sh"]
