# Sử dụng trực tiếp Image chính thức của n8n
FROM n8nio/n8n:latest

USER root

# 1. Cấu hình các biến môi trường bắt buộc cho Hugging Face
ENV N8N_PORT=7860 \
    N8N_USER_FOLDER=/data \
    HOME=/data \
    N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# 2. Tạo và phân quyền triệt để cho thư mục dữ liệu /data
RUN mkdir -p /data && chown -R 1000:1000 /data

# 3. Trả quyền lại cho user node (1000) mặc định của n8n
USER 1000
EXPOSE 7860

# 4. Giải pháp tối thượng: Bypass hoàn toàn script docker-entrypoint.sh gốc.
# Gọi thẳng file binary gốc của n8n kết hợp với tini.
# Dạng Shell form này sẽ nuốt chửng và cô lập hoàn toàn mọi tham số rác ("start") từ Hugging Face.
ENTRYPOINT tini -- /usr/local/bin/n8n start
