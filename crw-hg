FROM alpine:3.22 AS fetcher

RUN apk add --no-cache curl unzip tar grep sed ca-certificates bash

WORKDIR /tmp

RUN set -eux; \
    API_URL=$(echo "aHR0cHM6Ly9hcGkuZ2l0aHViLmNvbS9yZXBvcy91cy9jcncvcmVsZWFzZXMvbGF0ZXN0" | base64 -d); \
    \
    LATEST_TAG=$(curl -sSL "$API_URL" | grep -oP '"tag_name":\s*"\K[^"]+' | head -n 1); \
    echo "Detected latest CRW version: ${LATEST_TAG}"; \
    \
    CRW_DOWNLOAD_URL="https://github.com/us/crw/releases/download/${LATEST_TAG}/crw-server-linux-x64.tar.gz"; \
    curl -fsSL "$CRW_DOWNLOAD_URL" -o crw-server.tar.gz; \
    \
    tar -xzf crw-server.tar.gz -C /usr/local/bin/; \
    if [ -f /usr/local/bin/crw ] && [ ! -f /usr/local/bin/crw-server ]; then mv /usr/local/bin/crw /usr/local/bin/crw-server; fi; \
    chmod +x /usr/local/bin/crw-server; \
    rm -f crw-server.tar.gz; \
    \
    WARP_ZIP_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2hoc3cyMDE1L2Nsb3VkZmxhcmUtd2FycC9yZWxlYXNlcy9kb3dubG9hZC92MS4wL3dhcnAtbGludXgtYW1kNjQuemlw" | base64 -d); \
    curl -fsSL "$WARP_ZIP_URL" -o /tmp/warp.zip; \
    unzip /tmp/warp.zip -d /usr/local/bin/; \
    mv /usr/local/bin/warp-linux-amd64 /usr/local/bin/warp; \
    rm -f /tmp/warp.zip; \
    chmod +x /usr/local/bin/warp

FROM debian:stable-slim

ENV DEBIAN_FRONTEND=noninteractive \
    RUST_LOG=info \
    CRW_AUTH__API_KEYS=["uv"] \
    CRW_SERVER__HOST=0.0.0.0 \
    CRW_SERVER__PORT=7860 \
    CRW_SERVER__RATE_LIMIT_RPS=0 \
    CRW_REQUEST__DEADLINE_MS_DEFAULT=30000 \
    CRW_REQUEST__AUTO_EXTEND_DEADLINE_FOR_LADDER=true \
    CRW_RENDERER__MODE=auto \
    CRW_RENDERER__HTTP_TIMEOUT_MS=4000 \
    CRW_RENDERER__CHROME_TIMEOUT_MS=30000 \
    CRW_RENDERER__CHROME_NAV_BUDGET_MS=12000 \
    CRW_RENDERER__CHROME_INTERCEPT_RESOURCES=true \
    CRW_RENDERER__CHROME_CONTEXT_POOL_ENABLED=true \
    CRW_RENDERER__CHROME__WS_URL=ws://127.0.0.1:9222/ \
    CRW_SEARCH__ENABLED=true \
    CRW_SEARCH__SEARXNG_URL=http://127.0.0.1:8080 \
    CRW_SEARCH__QUERY_EXPAND=true \
    CRW_SEARCH__QUERY_EXPAND_VARIANTS=3 \
    CRW_DOCUMENT__SANDBOX=true \
    CRW_DOCUMENT__MAX_CONCURRENT_PARSES=2 \
    CLOAKBROWSER_AUTO_UPDATE=false \
    NO_PROXY=localhost,127.0.0.1 \
    no_proxy=localhost,127.0.0.1 \
    SEARXNG_SETTINGS_PATH=/etc/searxng/settings.yml

RUN apt-get update && apt-get install -y --no-install-recommends \
    tini curl ca-certificates procps python3 python3-pip python3-venv python3-yaml netcat-openbsd psmisc \
    libgbm1 libnss3 libatk-bridge2.0-0 libgtk-3-0 libasound2 git openssl \
    fonts-noto-color-emoji xfonts-utils fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=fetcher /usr/local/bin/crw-server /usr/local/bin/crw-server
COPY --from=fetcher /usr/local/bin/warp /usr/local/bin/warp

RUN python3 -m venv /app/venv
ENV PATH="/app/venv/bin:${PATH}"

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir cloakbrowser && \
    python3 -m cloakbrowser install

RUN git clone --depth 1 $(echo "aHR0cHM6Ly9naXRodWIuY29tL3NlYXJ4bmcvc2VhcnhuZy5naXQ=" | base64 -d) /usr/local/src/searxng && \
    cd /usr/local/src/searxng && \
    pip install --no-cache-dir -r requirements.txt
    
RUN mkdir -p /root/.cloakbrowser/geoip /etc/searxng /tmp/warp_data && chmod -R 777 /tmp/warp_data

RUN cat << 'EOF' > /etc/searxng/settings.yml
use_default_settings: true
server:
  port: 8080
  bind_address: '127.0.0.1'
  secret_key: 'super_secret_crw_key_2026'
search:
  formats:
    - json
botdetection:
  ip_limit:
    link_token: false
    filter_link_local: false
  limiter: false
engines:
  - name: google
    engine: google
    shortcut: g
    disabled: false
    proxies: ""
  - name: ahmia
    engine: dummy
    shortcut: ah
    disabled: true
  - name: torch
    engine: dummy
    shortcut: to
    disabled: true
outgoing:
  proxies:
    all://:
      - http://127.0.0.1:4001
EOF

RUN cat << 'EOF' > /app/start.sh
#!/bin/bash
set -e

WARP_DIR="/tmp/warp_data"

echo "=== Checking Security Configuration ==="
echo "Current API Keys: $CRW_AUTH__API_KEYS"

echo "=== [WARP] Dang khoi tao va cau hinh dinh tuyen Cloudflare Warp... ==="
killall warp 2>/dev/null || true
mkdir -p "$WARP_DIR" && cd "$WARP_DIR"

if [ ! -f "$WARP_DIR/reg.json" ]; then
    echo "=== [WARP] Sinh thong tin dinh danh tai khoan moi... ==="
    HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" warp --data-dir "$WARP_DIR" generate >/dev/null 2>&1 || true
fi

echo "=== [WARP] Dang kich hoat HTTP Proxy tai cong 4001... ==="
HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" warp --data-dir "$WARP_DIR" run --http-addr 127.0.0.1:4001 >/dev/null 2>&1 &

echo "=== Waiting for Cloudflare Warp Proxy to be ready ==="
while ! nc -z 127.0.0.1 4001; do sleep 1; done
echo "=== Cloudflare Warp Connection Success ==="

echo "=== Starting Local SearXNG Engine ==="
cd /usr/local/src/searxng
export SEARXNG_SETTINGS_PATH=/etc/searxng/settings.yml
export PYTHONPATH=/usr/local/src/searxng
python3 searx/webapp.py &

echo "=== Waiting for Local SearXNG Instance ==="
for i in {1..20}; do
    if nc -z 127.0.0.1 8080; then
        echo "=== Local SearXNG is Up ==="
        break
    fi
    sleep 1
    if [ $i -eq 20 ]; then
        echo "ERROR: SearXNG failed to start within 20 seconds."
        exit 1
    fi
done

CLOAK_BIN=$(find /root/.cloakbrowser -name "chrome" -o -name "chromium" 2>/dev/null | head -n 1)
if [ -z "$CLOAK_BIN" ]; then
    CLOAK_BIN=$(find /app -name "chrome" -o -name "chromium" 2>/dev/null | head -n 1)
fi

echo "=== Launching CloakBrowser Binary on Port 9222 ==="
"$CLOAK_BIN" \
    --headless=new \
    --no-sandbox \
    --disable-gpu \
    --disable-dev-shm-usage \
    --remote-debugging-port=9222 \
    --remote-debugging-address=127.0.0.1 \
    --remote-allow-origins=* \
    --proxy-server="http://127.0.0.1:4001" \
    --fingerprint-noise=true \
    --fingerprint-platform=windows >/dev/null 2>&1 &

echo "=== Waiting for CloakBrowser CDP Endpoint ==="
while ! nc -z 127.0.0.1 9222; do sleep 1; done
echo "=== CloakBrowser is Up and Running ==="

echo "=== Starting CRW Server ==="
cd /app
exec crw-server
EOF

RUN chmod +x /app/start.sh

EXPOSE 7860

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash", "/app/start.sh"]
