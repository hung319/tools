# Sử dụng Debian Bullseye Slim
FROM node:20-bullseye-slim

USER root

# 1. Cài đặt công cụ hệ thống
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git ssh build-essential tini procps unzip psmisc \
        make g++ python3 tar openssl findutils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 2. Cài đặt UV và BUN
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
RUN curl -fsSL https://bun.sh/install | bash \
    && mv /root/.bun/bin/bun /usr/local/bin/bun \
    && rm -rf /root/.bun

# 3. Cài đặt Opencode-AI
RUN npm install -g opencode-ai@latest && npm cache clean --force

# 4. Cấu hình biến môi trường
ENV PATH="/usr/local/bin:/usr/bin:${PATH}" \
    PORT=7860 \
    HOSTNAME=0.0.0.0 \
    BACKUP_DIR="/data" \
    BACKUP_FILENAME="opencode_backup.enc" \
    BACKUP_PASS="123456"

WORKDIR /root

# 5. Script Entrypoint xử lý logic chuyên sâu
RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh
#!/bin/bash
set -e

BACKUP_FILE="$BACKUP_DIR/$BACKUP_FILENAME"
TEMP_FILE="/tmp/temp_backup.enc"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

# --- HÀM PHỤC HỒI ---
restore_data() {
    log "--- [RESTORE] Kiểm tra bản lưu tại $BACKUP_FILE ---"
    if [ -f "$BACKUP_FILE" ]; then
        log "--- [RESTORE] Đang giải mã và phục hồi toàn bộ môi trường /root... ---"
        if openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_FILE" | tar -xz -C /; then
            log "--- [RESTORE] THÀNH CÔNG! ---"
        else
            log "--- [RESTORE] LỖI: Không thể giải mã hoặc giải nén. ---"
        fi
    else
        log "--- [RESTORE] Không tìm thấy dữ liệu cũ. Bắt đầu phiên mới. ---"
    fi
}

# --- HÀM SAO LƯU ---
backup_data() {
    if [ ! "$(ls -A /root 2>/dev/null)" ]; then return; fi

    # Chỉ quét thay đổi ở những nơi quan trọng, bỏ qua cache để tránh loop
    if [ -f "$BACKUP_FILE" ]; then
        CHANGED_FILES=$(find /root -type f \
            -not -path "*/.cache/*" \
            -not -path "*/.npm/*" \
            -not -path "*/.uv/cache/*" \
            -not -path "*/.bun/install/cache/*" \
            -not -name "*.log" \
            -newer "$BACKUP_FILE" -print -quit 2>/dev/null)
        
        if [ -z "$CHANGED_FILES" ]; then return; fi
    fi

    log "--- [BACKUP] Phát hiện thay đổi dữ liệu/binary! Đang đóng gói... ---"
    
    # NÉN TOÀN BỘ /ROOT
    # Chỉ loại trừ thư mục CACHE, giữ lại các thư mục binary và database logs (.db-wal, .db-shm)
    if tar -cz -C / \
        --exclude='root/.cache' \
        --exclude='root/.npm' \
        --exclude='root/.uv/cache' \
        --exclude='root/.bun/install/cache' \
        --exclude='*.log' \
        root | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$TEMP_FILE"; then
        
        mkdir -p "$BACKUP_DIR"
        mv "$TEMP_FILE" "$BACKUP_FILE"
        log "--- [BACKUP] HOÀN TẤT: $BACKUP_FILENAME ---"
    else
        log "--- [BACKUP] LỖI: Sao lưu thất bại! ---"
        rm -f "$TEMP_FILE"
    fi
}

cleanup() {
    trap - TERM INT QUIT
    log "!!! [SHUTDOWN] Đang backup an toàn lần cuối... !!!"
    kill $WATCHER_PID 2>/dev/null || true
    backup_data
    kill -TERM "$APP_PID" 2>/dev/null || true
    wait "$APP_PID" 2>/dev/null || true
    exit 0
}

trap 'cleanup' TERM INT QUIT

restore_data
backup_data

# Watcher quét mỗi 60 giây
(
    while true; do
        sleep 60
        backup_data
    done
) &
WATCHER_PID=$!

log "Khởi động Opencode-AI Port: ${PORT}..."
opencode serve --port "${PORT}" --hostname "${HOSTNAME}" &
APP_PID=$!

wait "$APP_PID" || true
EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

# 6. Thực thi
EXPOSE 7860
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
