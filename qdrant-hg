FROM qdrant/qdrant:latest

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    tini tar openssl findutils procps inotify-tools curl jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV QDRANT__SERVICE__HTTP_PORT=7860 \
    QDRANT__SERVICE__GRPC_PORT=7861 \
    QDRANT__STORAGE__STORAGE_PATH=/tmp/qdrant_storage \
    QDRANT__STORAGE__SNAPSHOTS_PATH=/tmp/qdrant_snapshots \
    BACKUP_DIR=/data \
    BACKUP_FILENAME="qdrant_backup.enc" \
    BACKUP_PASS="PLACEHOLDER_BACKUP_PASSWORD" \
    QDRANT__SERVICE__API_KEY="PLACEHOLDER_QDRANT_API_KEY"

RUN mkdir -p /tmp/qdrant_storage /tmp/qdrant_snapshots /data && chmod -R 777 /tmp /data

RUN cat <<'EOF' > /usr/local/bin/qdrant-entrypoint.sh
#!/bin/sh
set -e

BACKUP_FILE="$BACKUP_DIR/$BACKUP_FILENAME"
TEMP_FILE="/tmp/temp_qdrant_backup.enc"
MOCK_DIR="/tmp/qdrant_snap"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [QDRANT-ENTRYPOINT] $1"; }

if [ -f "$BACKUP_FILE" ]; then
    log "--- [RESTORE] Found backup file. Decrypting... ---"
    if openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_FILE" | tar -xz -C /; then
        log "--- [RESTORE] SUCCESSFUL! ---"
    else
        log "--- [RESTORE] ERROR: Decryption failed. Starting fresh. ---"
    fi
else
    log "--- [RESTORE] No backup file found. Starting fresh. ---"
fi

chmod -R 777 /tmp/qdrant_storage /tmp/qdrant_snapshots /data 2>/dev/null || true

do_backup() {
    log "--- [THROTTLE ACTION] Packing Qdrant storage directory... ---"
    rm -rf "$MOCK_DIR"
    mkdir -p "$MOCK_DIR/tmp"
    cp -r /tmp/qdrant_storage "$MOCK_DIR/tmp/qdrant_storage" 2>/dev/null || true

    if tar -cz -C "$MOCK_DIR" . | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$TEMP_FILE"; then
        chmod 777 "$TEMP_FILE"
        mv "$TEMP_FILE" "$BACKUP_FILE"
        log "--- [BACKUP SUCCESS] Backup file updated successfully! ---"
    else
        log "--- [BACKUP ERROR] Packing or encryption failed! ---"
        rm -f "$TEMP_FILE"
    fi
    rm -rf "$MOCK_DIR"
}

watch_and_throttle() {
    local DIRTY_FLAG="/tmp/.qdrant_dirty"
    rm -f "$DIRTY_FLAG"
    sleep 15
    log "Activating inotifywait database monitor..."

    inotifywait -m -r -e modify -e move -e create -e delete \
        /tmp/qdrant_storage 2>/dev/null | while IFS='|' read -r filepath action; do
            if [ ! -f "$DIRTY_FLAG" ]; then
                log "-> [EVENT TRIGGER] Data changed. Scheduling backup in 5 minutes..."
                touch "$DIRTY_FLAG"
            fi
    done &

    while true; do
        if [ -f "$DIRTY_FLAG" ]; then
            sleep 300
            do_backup
            rm -f "$DIRTY_FLAG"
        else
            sleep 5
        fi
    done
}

cleanup() {
    trap - TERM INT QUIT
    log "!!! [SHUTDOWN] Emergency final sync and backup... !!!"
    do_backup
    exit 0
}
trap 'cleanup' TERM INT QUIT

watch_and_throttle &

log "Starting Qdrant Engine..."
./qdrant
EOF

RUN chmod +x /usr/local/bin/qdrant-entrypoint.sh

USER root
EXPOSE 7860
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/qdrant-entrypoint.sh"]
