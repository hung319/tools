FROM qdrant/qdrant:latest

USER root

# Chỉ giữ lại các package cơ bản cần thiết, loại bỏ inotify-tools, openssl, tar...
RUN apt-get update && apt-get install -y --no-install-recommends \
    tini procps curl jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Cấu hình Qdrant lưu data và snapshots trực tiếp vào /data
ENV QDRANT__SERVICE__HTTP_PORT=7860 \
    QDRANT__SERVICE__GRPC_PORT=7861 \
    QDRANT__STORAGE__STORAGE_PATH=/data/storage \
    QDRANT__STORAGE__SNAPSHOTS_PATH=/data/snapshots \
    QDRANT__SERVICE__API_KEY="PLACEHOLDER_QDRANT_API_KEY"

# Tạo thư mục và phân quyền
RUN mkdir -p /data/storage /data/snapshots && chmod -R 777 /data

# Entrypoint tối giản: Chỉ khởi chạy Qdrant trực tiếp
RUN cat <<'EOF' > /usr/local/bin/qdrant-entrypoint.sh
#!/bin/sh
set -e

echo "[$(date '+%Y-%m-%d %H:%M:%S')] [QDRANT-ENTRYPOINT] Starting Qdrant Engine..."
exec ./qdrant
EOF

RUN chmod +x /usr/local/bin/qdrant-entrypoint.sh

USER root
EXPOSE 7860 7861
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/qdrant-entrypoint.sh"]
