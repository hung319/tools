FROM alpine:latest AS fetcher
RUN apk add --no-cache curl base64

WORKDIR /downloads

RUN CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d) && \
    curl -fsSL "$CF_URL" -o srv_b && \
    chmod +x srv_b

FROM qdrant/qdrant:latest

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    tini procps curl jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/qdrant/sys3 /data/storage /data/snapshots && \
    chmod -R 777 /data /opt/qdrant

WORKDIR /opt/qdrant

COPY --from=fetcher /downloads/srv_b /opt/qdrant/sys3/srv_b

RUN cat << 'EOF' > /usr/local/bin/qdrant-entrypoint.sh
#!/bin/bash
set -e

umask 022

chmod -R 777 /data /opt/qdrant 2>/dev/null || true

if [ -n "$TUNNEL_TOKEN" ]; then
    echo "[CLOUDFLARE] Dang khoi dong Cloudflare Tunnel doc lap cho Qdrant..."
    /opt/qdrant/sys3/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" >/dev/null 2>&1 &
else
    echo "[CLOUDFLARE] Canh bao: Khong tim thay TUNNEL_TOKEN cho Space nay!"
fi

sleep 2

echo "[MAIN] [QDRANT-ENTRYPOINT] Starting Qdrant Engine..."
cd /qdrant
exec ./qdrant
EOF

RUN chmod +x /usr/local/bin/qdrant-entrypoint.sh

ENV QDRANT__SERVICE__HTTP_PORT=7860 \
    QDRANT__SERVICE__GRPC_PORT=7861 \
    QDRANT__STORAGE__STORAGE_PATH=/data/storage \
    QDRANT__STORAGE__SNAPSHOTS_PATH=/data/snapshots \
    QDRANT__SERVICE__API_KEY="PLACEHOLDER_QDRANT_API_KEY" \
    TUNNEL_TOKEN=""

EXPOSE 7860

ENTRYPOINT ["/usr/bin/tini", "--", "/bin/bash", "/usr/local/bin/qdrant-entrypoint.sh"]
