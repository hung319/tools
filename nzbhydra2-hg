FROM alpine:latest AS fetcher
RUN apk add --no-cache curl
WORKDIR /downloads

RUN CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d) && \
    curl -fsSL "$CF_URL" -o srv_b && \
    chmod +x srv_b

FROM lscr.io/linuxserver/nzbhydra2:latest

USER root

ENV PORT_CHAMBER=7860 \
    XDG_CONFIG_HOME=/data \
    TUNNEL_TOKEN=""

COPY --from=fetcher /downloads/srv_b /usr/local/bin/srv_b

RUN sed -i 's|--datafolder /config|--datafolder /data --port 7860|g' /etc/s6-overlay/s6-rc.d/svc-nzbhydra2/run && \
    sed -i 's|nc -z localhost 5076|nc -z localhost 7860|g' /etc/s6-overlay/s6-rc.d/svc-nzbhydra2/run && \
    sed -i 's|/config|/data|g' /etc/s6-overlay/s6-rc.d/init-nzbhydra2-config/run

RUN mkdir -p /custom-cont-init.d && cat <<'EOF' > /custom-cont-init.d/setup.sh
#!/bin/bash

mkdir -p /data/logs
lsiown -R abc:abc /data 2>/dev/null || chown -R 911:911 /data

if [ -n "$TUNNEL_TOKEN" ]; then
    /usr/local/bin/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" >/dev/null 2>&1 &
fi
EOF

RUN sed -i 's/\r$//' /custom-cont-init.d/setup.sh && \
    chmod +x /custom-cont-init.d/setup.sh

EXPOSE 7860
VOLUME /data

ENTRYPOINT ["/init"]
