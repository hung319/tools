FROM ghcr.io/xmbshwll/hermes-agent-docker:latest

USER root

ENV HOME=/root
ENV PATH="/root/.local/bin:${PATH}"
ENV HERMES_DASHBOARD_HOST=0.0.0.0
ENV HERMES_DASHBOARD_PORT=7860
ENV WEB_USERNAME="admin"
ENV WEB_PASSWORD="Doi_Mat_Khau_Nay_Khi_Deploy_2026"
ENV BACKUP_DIR=/data
ENV BACKUP_FILENAME="hermes_dashboard_backup.enc"
ENV BACKUP_PASS="MatKhauMaHoaDuLieuAnToan"
ENV WIREPROXY_SOCKS_PORT=4000
ENV ALL_PROXY="socks5://127.0.0.1:4000"
ENV all_proxy="socks5://127.0.0.1:4000"

ENV URL_WGCF_API="aHR0cHM6Ly9hcGkuZ2l0aHViLmNvbS9yZXBvcy9WaVJiMy93Z2NmL3JlbGVhc2VzL2xhdGVzdA=="
ENV URL_WIREPROXY_API="aHR0cHM6Ly9hcGkuZ2l0aHViLmNvbS9yZXBvcy93aW5kdGYvd2lyZXByb3h5L3JlbGVhc2VzL2xhdGVzdA=="

RUN apt-get update && apt-get install -y --no-install-recommends \
    tini tar openssl findutils procps inotify-tools sudo git curl jq ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN set -e; \
    API_WGCF=$(echo "$URL_WGCF_API" | base64 -d); \
    API_WIREPROXY=$(echo "$URL_WIREPROXY_API" | base64 -d); \
    VAL_WGCF=$(curl --noproxy "*" -s "$API_WGCF" | jq -r '.assets[] | select(.name | contains("linux_amd64")) | select(.name | contains("tar.gz") | not) | .browser_download_url'); \
    VAL_WIREPROXY=$(curl --noproxy "*" -s "$API_WIREPROXY" | jq -r '.assets[] | select(.name | contains("linux_amd64.tar.gz")) | .browser_download_url'); \
    if [ -z "$VAL_WGCF" ] || [ "$VAL_WGCF" = "null" ]; then exit 1; fi; \
    if [ -z "$VAL_WIREPROXY" ] || [ "$VAL_WIREPROXY" = "null" ]; then exit 1; fi; \
    curl --noproxy "*" -L -o /usr/local/bin/wgcf "$VAL_WGCF"; \
    chmod +x /usr/local/bin/wgcf; \
    curl --noproxy "*" -L -o /tmp/wireproxy.tar.gz "$VAL_WIREPROXY"; \
    tar -xzf /tmp/wireproxy.tar.gz -C /usr/local/bin/ wireproxy; \
    chmod +x /usr/local/bin/wireproxy; \
    rm -f /tmp/wireproxy.tar.gz; \
    wgcf --help >/dev/null && wireproxy --help >/dev/null

RUN ALL_PROXY="" all_proxy="" pip install --no-cache-dir --break-system-packages fastapi uvicorn ptyprocess psutil

RUN git config --global --add safe.directory /home/agent/hermes-agent
RUN cd /home/agent/hermes-agent && ALL_PROXY="" all_proxy="" hermes update

RUN mkdir -p /root/.hermes /root/workspace /data /etc/wireproxy \
    && chmod -R 777 /data /root/workspace /root/.hermes

RUN cat <<'EOF' > /usr/local/bin/hf-entrypoint.sh
#!/bin/sh
set -e

ROOT_HERMES="/root/.hermes"
WORKSPACE_DIR="/root/workspace"
BACKUP_FILE="$BACKUP_DIR/$BACKUP_FILENAME"
TEMP_FILE="/tmp/temp_backup.enc"
MOCK_DIR="/tmp/hermes_snap"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [HF-ENTRYPOINT] $1"; }

git config --global --add safe.directory '*' || true

REAL_HERMES=$(which hermes)

if [ -f "$BACKUP_FILE" ]; then
    log "--- [RESTORE] Tìm thấy file backup cũ. Đang giải mã phục hồi vào hệ thống ROOT... ---"
    if openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_FILE" | tar -xz -C /; then
        log "--- [RESTORE] PHỤC HỒI THÀNH CÔNG! ---"
    else
        log "--- [RESTORE] LỖI: Giải mã thất bại. Khởi tạo phiên mới. ---"
    fi
else
    log "--- [RESTORE] Không có dữ liệu cũ. Khởi tạo thư mục cấu hình mặc định... ---"
    mkdir -p "$ROOT_HERMES"
    $REAL_HERMES config init --data-dir "$ROOT_HERMES" >/dev/null 2>&1 || true
fi

chown -R root:root "$ROOT_HERMES" "$WORKSPACE_DIR" 2>/dev/null || true
chmod -R 777 "$ROOT_HERMES" "$WORKSPACE_DIR" /data 2>/dev/null || true

mkdir -p "$ROOT_HERMES"
PASS_HASH=$(/home/agent/hermes-agent/venv/bin/python3 -c "
import sys
sys.path.append('/home/agent/hermes-agent')
try:
    from plugins.dashboard_auth.basic import hash_password
    print(hash_password('$WEB_PASSWORD'))
except Exception:
    import passlib.hash
    print(passlib.hash.bcrypt.hash('$WEB_PASSWORD'))
")

cat <<EOT > "$ROOT_HERMES/config.yaml"
dashboard:
  basic_auth:
    username: "$WEB_USERNAME"
    password_hash: "$PASS_HASH"
plugins:
  dashboard_auth:
    basic:
      enabled: true
EOT

cd /etc/wireproxy
if [ ! -f "wgcf-profile.conf" ]; then
    export WGCF_CONFIG_DIR="/etc/wireproxy"
    ALL_PROXY="" all_proxy="" wgcf register --accept-tos >/dev/null 2>&1
    ALL_PROXY="" all_proxy="" wgcf generate >/dev/null 2>&1
fi

if [ -f "wgcf-profile.conf" ] && [ ! -f "wireproxy.conf" ]; then
    PRIV_KEY=$(grep "PrivateKey" wgcf-profile.conf | awk '{print $3}')
    PUB_KEY=$(grep "PublicKey" wgcf-profile.conf | awk '{print $3}')
    ADDRESS_V4=$(grep "Address" wgcf-profile.conf | cut -d' ' -f3 | cut -d',' -f1)
    ADDRESS_V6=$(grep "Address" wgcf-profile.conf | cut -d' ' -f3 | cut -d',' -f2)
    ENDPOINT=$(grep "Endpoint" wgcf-profile.conf | awk '{print $3}')

    cat <<EOT > wireproxy.conf
[Interface]
PrivateKey = $PRIV_KEY
Address = $ADDRESS_V4, $ADDRESS_V6
DNS = 1.1.1.1

[Peer]
PublicKey = $PUB_KEY
Endpoint = $ENDPOINT

[Socks5]
BindAddress = 127.0.0.1:$WIREPROXY_SOCKS_PORT
EOT
fi

if [ -f "wireproxy.conf" ]; then
    wireproxy -c wireproxy.conf > /tmp/wireproxy.log 2>&1 &
    sleep 3
fi

do_backup() {
    log "--- [THROTTLE ACTION] Tiến hành đóng gói dữ liệu của ROOT... ---"
    rm -rf "$MOCK_DIR" 
    mkdir -p "$MOCK_DIR/root"
    cp -r "$ROOT_HERMES" "$MOCK_DIR/root/.hermes" 2>/dev/null || true
    cp -r "$WORKSPACE_DIR" "$MOCK_DIR/root/workspace" 2>/dev/null || true

    if tar -cz --exclude='cache/**' --exclude='*.log' -C "$MOCK_DIR" . | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$TEMP_FILE"; then
        chmod 777 "$TEMP_FILE"
        mv "$TEMP_FILE" "$BACKUP_FILE"
        log "--- [BACKUP SUCCESS] Bản sao lưu ROOT đã được cập nhật thành công! ---"
    else
        log "--- [BACKUP ERROR] Có lỗi xảy ra trong quá trình nén hoặc mã hóa! ---"
        rm -f "$TEMP_FILE"
    fi
    rm -rf "$MOCK_DIR"
}

watch_and_throttle() {
    local DIRTY_FLAG="/tmp/.hermes_dirty"
    rm -f "$DIRTY_FLAG"
    sleep 15
    log "Đang kích hoạt tiến trình inotifywait theo dõi ngầm hệ thống ROOT..."
    
    inotifywait -m -r -e modify -e move -e create -e delete \
        --exclude "(cache/|.*\.log|venv/)" \
        --format "%w%f|%e" \
        "$ROOT_HERMES" "$WORKSPACE_DIR" 2>/dev/null | while IFS='|' read -r filepath action; do
            if [ ! -f "$DIRTY_FLAG" ]; then
                log "-> [EVENT TRIGGER] Phát hiện thay đổi dữ liệu. Đặt cờ chờ đóng gói sau 5 phút..."
                touch "$DIRTY_FLAG"
            fi
    done &

    while true; do
        if [ -f "$DIRTY_FLAG" ]; then
            sleep 300
            do_backup
            rm -f "$DIRTY_FLAG"
        else
            sleep 5
        fi
    done
}

cleanup() {
    trap - TERM INT QUIT
    log "!!! [SHUTDOWN] Tiến hành sao lưu khẩn cấp lần cuối cho ROOT... !!!"
    do_backup
    exit 0
}
trap 'cleanup' TERM INT QUIT

# TỰ ĐỘNG KHỞI CHẠY GATEWAY: Ép gateway chạy trực tiếp bằng lệnh đúng chuẩn Docker ngay khi start container
log "Đang tự động kích hoạt ngầm Hermes Gateway (hermes gateway run)..."
$REAL_HERMES gateway run > /tmp/hermes_gateway.log 2>&1 &

log "Đang khởi chạy Web Dashboard trực tiếp dưới quyền root..."
hermes dashboard --host $HERMES_DASHBOARD_HOST --port $HERMES_DASHBOARD_PORT --no-open &
HERMES_PID=$!

watch_and_throttle &
wait $HERMES_PID
EOF

RUN chmod +x /usr/local/bin/hf-entrypoint.sh

USER root
EXPOSE 7860
WORKDIR /root/workspace
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hf-entrypoint.sh"]
