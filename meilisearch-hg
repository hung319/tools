FROM alpine:latest AS fetcher
RUN apk add --no-cache curl base64

WORKDIR /downloads

RUN CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d) && \
    curl -fsSL "$CF_URL" -o srv_b && \
    chmod +x srv_b

FROM getmeili/meilisearch:latest AS base

FROM base AS builder

USER root

RUN apk add -q --no-cache \
        bash \
        lsof \
        procps \
        tini \
        curl \
        jq

RUN mkdir -p /sys3
COPY --from=fetcher /downloads/srv_b /sys3/srv_b

ENV MEILI_HTTP_ADDR="0.0.0.0:7860" \
    MEILI_SERVER_PROVIDER="docker" \
    MEILI_ENV="production" \
    MEILI_MASTER_KEY="MY_SECURE_MASTER_KEY_CHANGE_ME" \
    TUNNEL_TOKEN=""

WORKDIR /data

RUN mkdir -p /data && chmod -R 777 /data

RUN cat <<'EOF' > /bin/entrypoint.sh
#!/bin/bash
set -e

if [ -n "$TUNNEL_TOKEN" ]; then
    /sys3/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" >/dev/null 2>&1 &
fi

sleep 2

exec /bin/meilisearch --db-path /data/data.ms --experimental-dumpless-upgrade
EOF

RUN chmod +x /bin/entrypoint.sh

EXPOSE 7860

ENTRYPOINT ["tini", "--", "/bin/entrypoint.sh"]
