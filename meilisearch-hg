FROM getmeili/meilisearch:latest AS base

FROM base AS builder

USER root

# Chỉ giữ lại các công cụ hệ thống cơ bản, bỏ sạch inotify và openssl
RUN apk add -q --no-cache \
        bash \
        lsof \
        procps

ENV MEILI_HTTP_ADDR="0.0.0.0:7860" \
    MEILI_SERVER_PROVIDER="docker" \
    MEILI_ENV="production" \
    MEILI_MASTER_KEY="MY_SECURE_MASTER_KEY_CHANGE_ME"

WORKDIR /data

RUN mkdir -p /data && chmod -R 777 /data

RUN cat <<'EOF' > /bin/entrypoint.sh
#!/bin/bash
set -e

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [MEILI-ENTRYPOINT] $1"; }

log "Phát hiện bạn đang chạy cấu hình lưu trực tiếp tại /data."
log "Khởi động Meilisearch Engine với cờ tự động nâng cấp dữ liệu (--experimental-dumpless-upgrade)..."

# Thêm cờ --experimental-dumpless-upgrade để tự động sửa lỗi không tương thích phiên bản
exec /bin/meilisearch --db-path /data/data.ms --experimental-dumpless-upgrade
EOF

RUN chmod +x /bin/entrypoint.sh

EXPOSE 7860

ENTRYPOINT ["tini", "--", "/bin/entrypoint.sh"]
