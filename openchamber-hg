FROM node:20-bullseye-slim

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git ssh build-essential tini procps unzip psmisc \
        make g++ python3 tar openssl findutils gnupg inotify-tools \
    && curl -fsSL $(echo "aHR0cHM6Ly9idW4uc2gvaW5zdGFsbA==" | base64 -d) | BUN_INSTALL=/usr bash \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN ARCH=$(dpkg --print-architecture) \
    && if [ "$ARCH" = "amd64" ]; then \
         curl -fsSL $(echo "aHR0cHM6Ly9naXRodWIuY29tL1ZpUmIzL3dnY2YvcmVsZWFzZXMvZG93bmxvYWQvdjIuMi4zMS93Z2NmXzIuMi4zMV9saW51eF9hbWQ2NA==" | base64 -d) -o /usr/local/bin/wgcf; \
         curl -fsSL $(echo "aHR0cHM6Ly9naXRodWIuY29tL3dpbmR0Zi93aXJlcHJveHkvcmVsZWFzZXMvZG93bmxvYWQvdjEuMS4yL3dpcmVwcm94eV9saW51eF9hbWQ2NC50YXIuZ3o=" | base64 -d) | tar -xz -C /usr/local/bin/ wireproxy; \
       else \
         curl -fsSL $(echo "aHR0cHM6Ly9naXRodWIuY29tL1ZpUmIzL3dnY2YvcmVsZWFzZXMvZG93bmxvYWQvdjIuMi4zMS93Z2NmXzIuMi4zMV9saW51eF9hcm02NA==" | base64 -d) -o /usr/local/bin/wgcf; \
         curl -fsSL $(echo "aHR0cHM6Ly9naXRodWIuY29tL3dpbmR0Zi93aXJlcHJveHkvcmVsZWFzZXMvZG93bmxvYWQvdjEuMS4yL3dpcmVwcm94eV9saW51eF9hcm02NC50YXIuZ3o=" | base64 -d) | tar -xz -C /usr/local/bin/ wireproxy; \
       fi \
    && chmod +x /usr/local/bin/wgcf /usr/local/bin/wireproxy

ENV BUN_INSTALL="/usr" \
    BUN_INSTALL_BIN="/usr/bin" \
    PATH="/usr/bin:/usr/local/bin:${PATH}" \
    OPENCHAMBER_PORT=7860 \
    OPENCHAMBER_HOST=0.0.0.0 \
    BACKUP_DIR="/data" \
    BACKUP_FILENAME="openchamber_backup.enc" \
    BACKUP_PASS="123456" \
    NODE_ENV=production \
    PYTHONUNBUFFERED=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    GRADIO_ANALYTICS_ENABLED=false \
    SPACE_AUTHORIZATION="NONE" \
    HTTP_PROXY="http://127.0.0.1:4001" \
    HTTPS_PROXY="http://127.0.0.1:4001" \
    ALL_PROXY="http://127.0.0.1:4001" \
    NO_PROXY="localhost,127.0.0.1" \
    WGCF_FORCE_REGISTER=1

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

RUN echo "$(date +%Y-%m-%d_%H:%M:%S)" > /tmp/build_time

RUN HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" bun install -g opencode-ai@latest @openchamber/web@latest

WORKDIR /root

RUN mkdir -p /root/.config/openchamber /data /tmp/wgcf_temp && chmod -R 777 /root /data

RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh
#!/bin/bash
set +e

BACKUP_PATH="$BACKUP_DIR/$BACKUP_FILENAME"
TEMP_PATH="/tmp/temp_chamber.enc"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

start_warp_proxy() {
    log "--- [WARP] Đang khởi tạo và đăng ký IP Cloudflare mới... ---"
    killall wireproxy 2>/dev/null || true
    rm -rf /tmp/wgcf_temp && mkdir -p /tmp/wgcf_temp && cd /tmp/wgcf_temp
    
    HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" wgcf register --accept-tos >/dev/null 2>&1 || true
    HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" wgcf generate >/dev/null 2>&1 || true

    if [ -f "wgcf-profile.conf" ]; then
        PRIVATE_KEY=$(grep "PrivateKey" wgcf-profile.conf | awk '{print $3}')
        PUBLIC_KEY=$(grep "PublicKey" wgcf-profile.conf | awk '{print $3}')
        ENDPOINT=$(grep "Endpoint" wgcf-profile.conf | awk '{print $3}')
        ADDRESS=$(grep "Address" wgcf-profile.conf | awk '{print $3}' | head -n 1)

        cat <<WCONF > wireproxy.conf
[Interface]
PrivateKey = $PRIVATE_KEY
Address = $ADDRESS
DNS = 1.1.1.1

[Peer]
PublicKey = $PUBLIC_KEY
Endpoint = $ENDPOINT

[http]
BindAddress = 127.0.0.1:4001
WCONF

        HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" wireproxy -c wireproxy.conf >/dev/null 2>&1 &
        sleep 3
        log "--- [WARP] Kích hoạt thành công! HTTP Proxy đang chạy tại cổng 4001 ---"
    else
        log "--- [CẢNH BÁO] Không thể thiết lập bộ định tuyến WARP ---"
    fi
    cd /root
}

restore_data() {
    if [ -f "$BACKUP_PATH" ]; then
        log "--- [RESTORE] Tìm thấy bản lưu. Đang giải mã và phục hồi dữ liệu OpenChamber... ---"
        if openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_PATH" | tar -xz -C /; then
            rm -rf /root/.config/openchamber/pids/* 2>/dev/null || true
            rm -rf /root/.local/share/openchamber/*.pid 2>/dev/null || true
            fuser -k "${OPENCHAMBER_PORT}/tcp" 2>/dev/null || true
            log "--- [RESTORE] Phục hồi toàn bộ cấu hình thành công! ---"
        else
            log "--- [RESTORE] Giải mã thất bại ---"
        fi
    else
        log "--- [RESTORE] Không tìm thấy bản lưu cũ tại $BACKUP_PATH. Chạy môi trường mới. ---"
    fi
}

backup_data() {
    if [ ! "$(ls -A /root 2>/dev/null)" ]; then return; fi
    
    if [ -f "$BACKUP_PATH" ]; then
        CHANGED=$(find /root -type f -not -path "*/.cache/*" -not -path "*/.npm/*" -not -path "*/.uv/*" -not -name "*.log" -not -name "*.pid" -newer "$BACKUP_PATH" -print -quit 2>/dev/null)
        if [ -z "$CHANGED" ]; then return; fi
    fi

    log "--- [BACKUP] Phát hiện thay đổi, đang đóng gói dữ liệu an toàn... ---"
    mkdir -p "$BACKUP_DIR"
    if tar -cz -C / --exclude='root/.cache' --exclude='root/.npm' --exclude='root/.uv' --exclude='*.log' --exclude='*.pid' --exclude='root/.config/openchamber/pids' root 2>/dev/null | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$TEMP_PATH"; then
        mv "$TEMP_PATH" "$BACKUP_PATH"
        log "--- [BACKUP] Đã ghi đè cập nhật bản lưu mã hóa thành công! ---"
    else
        rm -f "$TEMP_PATH"
        log "--- [BACKUP] Thất bại trong quá trình đóng gói ---"
    fi
}

cleanup() {
    log "!!! [STOP] Đang thực hiện sao lưu khẩn cấp trước khi tắt máy... !!!"
    backup_data
    [ -n "${APP_PID:-}" ] && kill -TERM "$APP_PID" 2>/dev/null
    exit 0
}

trap cleanup SIGTERM SIGINT

start_warp_proxy
restore_data
backup_data

# Xuất hàm ra môi trường cho tiến trình ngầm sử dụng công khai
export -f backup_data
export -f log
export BACKUP_DIR BACKUP_FILENAME BACKUP_PASS TEMP_PATH

# --- TIẾN TRÌNH AUTO KIỂM TRA ĐỊNH KỲ (1 TIẾNG/LẦN) & XOAY IP (6 TIẾNG/LẦN) ---
(
    TIMER_COUNT=0
    while true; do
        sleep 300
        ((TIMER_COUNT+=1))
        
        backup_data
        
        if [ $TIMER_COUNT -ge 6 ]; then
            source /usr/local/bin/entrypoint.sh && start_warp_proxy
            TIMER_COUNT=0
        fi
    done
) &

fuser -k "${OPENCHAMBER_PORT}/tcp" 2>/dev/null || true

/usr/bin/openchamber serve \
    --port "${OPENCHAMBER_PORT}" \
    --host "${OPENCHAMBER_HOST}" \
    --foreground \
    ${OPENCHAMBER_UI_PASSWORD:+--ui-password "$OPENCHAMBER_UI_PASSWORD"} &

APP_PID=$!
wait "$APP_PID"
EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 7860

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
