FROM node:22-slim

USER root

# Cài đặt các gói phụ trợ hệ thống trên nền Debian 13
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git ssh build-essential tini procps unzip psmisc \
        make g++ python3 tar openssl findutils gnupg inotify-tools lsof \
    && curl -fsSL $(echo "aHR0cHM6Ly9idW4uc2gvaW5zdGFsbA==" | base64 -d) | BUN_INSTALL=/usr bash \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# SỬA LỖI ĐỔI TÊN: Giải nén ra warp-linux-amd64 và đổi tên thành warp
RUN ARCH=$(dpkg --print-architecture) \
    && WARP_ZIP_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2hoc3cyMDE1L2Nsb3VkZmxhcmUtd2FycC9yZWxlYXNlcy9kb3dubG9hZC92MS4wL3dhcnAtbGludXgtYW1kNjQuemlw" | base64 -d) \
    && if [ "$ARCH" != "amd64" ]; then \
         echo "Canh bao: Phien ban cloudflare-warp hien tai chi ho tro kien truc amd64!" ; \
       fi \
    && curl -fsSL "$WARP_ZIP_URL" -o /tmp/warp.zip \
    && unzip /tmp/warp.zip -d /usr/local/bin/ \
    && mv /usr/local/bin/warp-linux-amd64 /usr/local/bin/warp \
    && rm -f /tmp/warp.zip \
    && chmod +x /usr/local/bin/warp

ENV BUN_INSTALL="/usr" \
    BUN_INSTALL_BIN="/usr/bin" \
    PATH="/usr/bin:/usr/local/bin:${PATH}" \
    OPENCHAMBER_PORT=7860 \
    OPENCHAMBER_HOST=0.0.0.0 \
    BACKUP_DIR="/data" \
    BACKUP_FILENAME="openchamber_backup.enc" \
    BACKUP_PASS="123456" \
    NODE_ENV=production \
    PYTHONUNBUFFERED=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    GRADIO_ANALYTICS_ENABLED=false \
    SPACE_AUTHORIZATION="NONE" \
    HTTP_PROXY="http://127.0.0.1:4001" \
    HTTPS_PROXY="http://127.0.0.1:4001" \
    ALL_PROXY="http://127.0.0.1:4001" \
    NO_PROXY="localhost,127.0.0.1"

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

RUN echo "$(date +%Y-%m-%d_%H:%M:%S)" > /tmp/build_time

RUN HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" npm install -g opencode-ai@latest @openchamber/web@latest

WORKDIR /root

RUN mkdir -p /root/.config/openchamber /data /tmp/warp_data && chmod -R 777 /root /data

RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh
#!/bin/bash
set +e

BACKUP_PATH="$BACKUP_DIR/$BACKUP_FILENAME"
TEMP_PATH="/tmp/temp_chamber.enc"
WARP_DIR="/tmp/warp_data"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

is_app_alive() {
    if pgrep -f "openchamber" >/dev/null 2>&1 || lsof -i :"${OPENCHAMBER_PORT}" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

start_warp_proxy() {
    log "--- [WARP] Dang khoi tao va cau hinh dinh tuyen Cloudflare Warp... ---"
    killall warp 2>/dev/null || true
    mkdir -p "$WARP_DIR" && cd "$WARP_DIR"
    
    if [ ! -f "$WARP_DIR/reg.json" ]; then
        log "--- [WARP] Sinh thong tin dinh danh tai khoan moi... ---"
        HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" warp --data-dir "$WARP_DIR" generate >/dev/null 2>&1 || true
    fi

    log "--- [WARP] Dang kich hoat HTTP Proxy tai cong 4001... ---"
    HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" warp --data-dir "$WARP_DIR" run --http-addr 127.0.0.1:4001 >/dev/null 2>&1 &
    sleep 3
    cd /root
}

restore_data() {
    if [ -f "$BACKUP_PATH" ]; then
        log "--- [RESTORE] Tim thay ban luu. Dang giai ma va phuc hoi du lieu OpenChamber... ---"
        if openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_PATH" | tar -xz -C /; then
            rm -rf /root/.config/openchamber/pids/* 2>/dev/null || true
            rm -rf /root/.local/share/openchamber/*.pid 2>/dev/null || true
            fuser -k "${OPENCHAMBER_PORT}/tcp" 2>/dev/null || true
            log "--- [RESTORE] Phuc hoi toan bo cau hinh thanh cong! ---"
        else
            log "--- [RESTORE] Giai ma that bai ---"
        fi
    else
        log "--- [RESTORE] Khong tim thay ban luu cu tai $BACKUP_PATH. Chay moi truong moi. ---"
    fi
}

backup_data() {
    if [ ! "$(ls -A /root 2>/dev/null)" ]; then return; fi

    log "--- [BACKUP] Kich hoat tien trinh nen va ma hoa du lieu... ---"
    mkdir -p "$BACKUP_DIR"
    if tar -cz -C / \
        --exclude='root/.cache' \
        --exclude='root/.npm' \
        --exclude='root/.uv' \
        --exclude='*.log' \
        --exclude='*.pid' \
        --exclude='root/.config/openchamber/pids' \
        root 2>/dev/null | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$TEMP_PATH"; then
        
        mv "$TEMP_PATH" "$BACKUP_PATH"
        log "--- [BACKUP] Da ghi de cap nhat ban luu ma hoa thanh cong! ---"
    else
        rm -f "$TEMP_PATH"
        log "--- [BACKUP] That bai trong qua trinh dong goi ---"
    fi
}

cleanup() {
    if is_app_alive; then
        log "!!! [STOP] Dang thuc hien sao luu khan cap truoc khi tat may... !!!"
        backup_data
    else
        log "!!! [STOP] Ung dung da bi sap (crash) hoang chua khoi tao. HUY BO sao luu de bao ve du lieu !!!"
    fi
    exit 0
}

trap cleanup SIGTERM SIGINT

start_warp_proxy
restore_data

(
    while true; do
        inotifywait -r -e modify -e create -e delete -e move \
            --exclude '(\.cache|\.npm|\.uv|\.pid|pids|.*\.log)' \
            /root 2>/dev/null

        log "--- [INOTIFY] Phat hien he thong co tep tin vua thay doi! ---"
        log "--- [INOTIFY] Bat dau dem nguoc 5 phut (Debounce) truoc khi cap nhat file luu... ---"
        
        sleep 300
        
        if is_app_alive; then
            backup_data
        else
            log "--- [INOTIFY] Phat hien ung dung da crash, huy bo chu ky sao luu nay ---"
        fi
    done
) &

fuser -k "${OPENCHAMBER_PORT}/tcp" 2>/dev/null || true

openchamber serve \
    --port "${OPENCHAMBER_PORT}" \
    --host "${OPENCHAMBER_HOST}" \
    --foreground \
    ${OPENCHAMBER_UI_PASSWORD:+--ui-password "$OPENCHAMBER_UI_PASSWORD"} &

sleep 5
while is_app_alive; do
    sleep 5
done

log "--- [EXIT] Ung dung OpenChamber da tat chu dong ---"
EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 7860

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
