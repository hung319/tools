# Sử dụng Debian Bullseye Slim để đảm bảo tính ổn định cho Node.js và Python
FROM node:20-bullseye-slim

USER root

# 1. Cài đặt các công cụ hệ thống cần thiết
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git ssh build-essential tini procps unzip psmisc \
        make g++ python3 tar openssl findutils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 2. Cài đặt UV
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# 3. Cài đặt Opencode-AI và OpenChamber
RUN npm install -g opencode-ai@latest @openchamber/web@latest \
    && npm cache clean --force

# 4. Cấu hình biến môi trường
ENV PATH="/usr/local/bin:/usr/bin:${PATH}" \
    OPENCHAMBER_PORT=7860 \
    OPENCHAMBER_HOST=0.0.0.0 \
    BACKUP_DIR="/data" \
    BACKUP_FILENAME="chamber_secure_backup.enc" \
    BACKUP_PASS="123456" \
    NODE_ENV=production

WORKDIR /root

# 5. Script Entrypoint: Đã sửa lỗi xung đột PID / Port sau khi Restore
RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh
#!/bin/bash
set -e

BACKUP_PATH="$BACKUP_DIR/$BACKUP_FILENAME"
TEMP_PATH="/tmp/temp_chamber.enc"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

# --- HÀM PHỤC HỒI ---
restore_data() {
    if [ -f "$BACKUP_PATH" ]; then
        log "--- [RESTORE] Đang giải mã dữ liệu từ $BACKUP_FILENAME... ---"
        if openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_PATH" | tar -xz -C /; then
            log "--- [RESTORE] Thành công! ---"
            
            # [QUAN TRỌNG] Xóa sạch file định danh tiến trình cũ để tránh lỗi "Already running"
            log "--- [SỬA LỖI] Đang dọn dẹp file lock và PID cũ sau khi restore... ---"
            rm -rf /root/.config/openchamber/pids/* 2>/dev/null || true
            rm -rf /root/.local/share/openchamber/*.pid 2>/dev/null || true
            fuser -k "${OPENCHAMBER_PORT}/tcp" 2>/dev/null || true
        else
            log "--- [RESTORE] Thất bại (Sai mật khẩu hoặc file lỗi) ---"
        fi
    else
        log "--- [RESTORE] Không tìm thấy bản lưu cũ. Khởi tạo mới. ---"
    fi
}

# --- HÀM SAO LƯU ---
backup_data() {
    if [ ! "$(ls -A /root 2>/dev/null)" ]; then return; fi

    if [ -f "$BACKUP_PATH" ]; then
        CHANGED=$(find /root -type f \
            -not -path "*/.cache/*" -not -path "*/.npm/*" -not -path "*/.uv/*" \
            -not -name "*.log" -not -name "*.pid" -newer "$BACKUP_PATH" -print -quit 2>/dev/null)
        if [ -z "$CHANGED" ]; then return; fi
    fi

    log "--- [BACKUP] Đang đóng gói và mã hóa... ---"
    mkdir -p "$BACKUP_DIR"
    
    # Nén loại trừ thêm các file đuôi .pid và thư mục chứa pid tạm thời
    if tar -cz -C / \
        --exclude='root/.cache' \
        --exclude='root/.npm' \
        --exclude='root/.uv' \
        --exclude='*.log' \
        --exclude='*.pid' \
        --exclude='root/.config/openchamber/pids' \
        root | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$TEMP_PATH"; then
        
        mv "$TEMP_PATH" "$BACKUP_PATH"
        log "--- [BACKUP] Đã cập nhật bản lưu mã hóa lúc $(date) ---"
    else
        log "--- [BACKUP] Lỗi trong quá trình nén/mã hóa! ---"
        rm -f "$TEMP_PATH"
    fi
}

cleanup() {
    log "!!! [STOP] Đang thực hiện backup cuối cùng... !!!"
    backup_data
    [ -n "$APP_PID" ] && kill -TERM "$APP_PID"
    exit 0
}

trap cleanup SIGTERM SIGINT

# Chạy quy trình khởi động
restore_data
backup_data

# Watcher chạy ngầm mỗi 2 phút
(
    while true; do
        sleep 120
        backup_data
    done
) &

log "Khởi động OpenChamber trên cổng ${OPENCHAMBER_PORT}..."
# Thêm lệnh giải phóng port bằng fuser trước khi chạy để chắc chắn 100%
fuser -k "${OPENCHAMBER_PORT}/tcp" 2>/dev/null || true

openchamber serve \
    --port "${OPENCHAMBER_PORT}" \
    --host "${OPENCHAMBER_HOST}" \
    --foreground \
    ${OPENCHAMBER_UI_PASSWORD:+--ui-password "$OPENCHAMBER_UI_PASSWORD"} &

APP_PID=$!
wait "$APP_PID"
EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

# 6. Port mặc định
EXPOSE 7860

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
