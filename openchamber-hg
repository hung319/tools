FROM node:22-trixie-slim

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git ssh build-essential tini procps unzip psmisc \
        make g++ python3 tar openssl findutils gnupg inotify-tools lsof xxd netcat-openbsd jq \
    && curl -fsSL $(echo "aHR0cHM6Ly9idW4uc2gvaW5zdGFsbA==" | base64 -d) | BUN_INSTALL=/usr bash \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN ARCH=$(dpkg --print-architecture) \
    && if [ "$ARCH" = "amd64" ]; then \
         curl -fsSL $(echo "aHR0cHM6Ly9naXRodWIuY29tL3dpbmR0Zi93aXJlcHJveHkvcmVsZWFzZXMvZG93bmxvYWQvdjEuMS4yL3dpcmVwcm94eV9saW51eF9hbWQ2NC50YXIuZ3o=" | base64 -d) | tar -xz -C /usr/local/bin/ wireproxy; \
       else \
         curl -fsSL $(echo "aHR0cHM6Ly9naXRodWIuY29tL3dpbmR0Zi93aXJlcHJveHkvcmVsZWFzZXMvZG93bmxvYWQvdjEuMS4yL3dpcmVwcm94eV9saW51eF9hcm02NC50YXIuZ3o=" | base64 -d) | tar -xz -C /usr/local/bin/ wireproxy; \
       fi \
    && chmod +x /usr/local/bin/wireproxy

ENV BUN_INSTALL="/usr" \
    BUN_INSTALL_BIN="/usr/bin" \
    PATH="/usr/bin:/usr/local/bin:${PATH}" \
    OPENCHAMBER_PORT=7860 \
    OPENCHAMBER_HOST=0.0.0.0 \
    BACKUP_DIR="/data" \
    BACKUP_FILENAME="openchamber_backup.enc" \
    BACKUP_PASS="123456" \
    NODE_ENV=production \
    PYTHONUNBUFFERED=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    GRADIO_ANALYTICS_ENABLED=false \
    SPACE_AUTHORIZATION="NONE" \
    HTTP_PROXY="http://127.0.0.1:4001" \
    HTTPS_PROXY="http://127.0.0.1:4001" \
    ALL_PROXY="http://127.0.0.1:4001" \
    NO_PROXY="localhost,127.0.0.1"

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

RUN echo "$(date +%Y-%m-%d_%H:%M:%S)" > /tmp/build_time

RUN HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" npm install -g opencode-ai@latest @openchamber/web@latest

WORKDIR /root

RUN mkdir -p /root/.config/openchamber /data /tmp/wireproxy_temp && chmod -R 777 /root /data

RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh
#!/bin/bash
set +e

BACKUP_PATH="$BACKUP_DIR/$BACKUP_FILENAME"
TEMP_PATH="/tmp/temp_chamber.enc"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

is_app_alive() {
    if pgrep -f "openchamber" >/dev/null 2>&1 || lsof -i :"${OPENCHAMBER_PORT}" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

start_warp_proxy() {
    log "--- [WARP-SCAN] Đang quét nhanh Endpoint tối ưu bằng Bash (Fresh Mode)... ---"
    killall wireproxy 2>/dev/null || true
    rm -rf /tmp/wireproxy_temp && mkdir -p /tmp/wireproxy_temp && cd /tmp/wireproxy_temp

    ips=("162.159.192" "162.159.193" "162.159.195" "162.159.204" "188.114.96" "188.114.97" "188.114.98" "188.114.99")
    ports=(2408 500 864 880 894 934 1070 1180 3476 3581 4198 4500 5279 5956 7103 7152 7559 8319 8854 8886)
    HEX_DATA="\x04\x1d\x69\xe6\x79\x22\x09\x9a\xa0\xb9\x3d\x1e\x7b\x30\x9e\xc5\x85\x1e\xe2\xa3\xd6\xbf\x82\xa8\xbb\x5b\xb0\x3e\xd4\x6f\xb2\x34\x65\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x77\xa4\xa8\xcd\x5d\x88\x3e\x66\x08\x8e\x5f\x70\xad\xb4\x2f\x8a"
    DYNAMIC_ENDPOINT=""
    best_latency=9999

    for i in {1..12}; do
        rand_sub=${ips[$RANDOM % ${#ips[@]}]}
        rand_host=$((RANDOM % 254 + 1))
        rand_port=${ports[$RANDOM % ${#ports[@]}]}
        target_ip="${rand_sub}.${rand_host}"
        
        start_t=$(date +%s%3N)
        res=$(echo -ne "$HEX_DATA" | nc -w 1 -u "$target_ip" "$rand_port" 2>/dev/null | head -c 5 | xxd -p 2>/dev/null)
        end_t=$(date +%s%3N)
        
        if [[ "$res" == "cf00000000" ]]; then
            latency=$((end_t - start_t))
            if [ "$latency" -lt "$best_latency" ]; then
                best_latency=$latency
                DYNAMIC_ENDPOINT="${target_ip}:${rand_port}"
            fi
        fi
    done

    if [ -z "$DYNAMIC_ENDPOINT" ]; then
        log "[WARP-SCAN] Không scan kịp endpoint hợp lệ. Chuyển về Endpoint mặc định..."
        DYNAMIC_ENDPOINT="188.114.97.242:7559"
    else
        log "[WARP-SCAN] Đã tìm thấy Endpoint tốt nhất: $DYNAMIC_ENDPOINT (Ping: ${best_latency}ms)"
    fi

    log "--- [WARP-REG] Đăng ký tài khoản thực qua CORS Proxy (Đã xả kẹt ENV Proxy)... ---"
    openssl genpkey -algorithm X25519 -outform DER -out x25519_priv.der 2>/dev/null
    PRIV_KEY=$(tail -c 32 x25519_priv.der | base64 | tr -d '\n\r ')
    openssl pkey -inform DER -in x25519_priv.der -pubout -outform DER -out x25519_pub.der 2>/dev/null
    PUB_KEY=$(tail -c 32 x25519_pub.der | base64 | tr -d '\n\r ')
    rm -f x25519_priv.der x25519_pub.der
    NOW_ISO=$(date -u +"%Y-%m-%dT%H:%M:%S.000Z")

    # Ép trống proxy môi trường để tránh bị vòng lặp lôi vào cổng 4001 chưa chạy
    REG_RESPONSE=$(HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" curl -s -X POST 'https://proxy.corsfix.com/?https://api.cloudflareclient.com/v0a737/reg' \
      -H 'authority: proxy.corsfix.com' \
      -H 'content-type: application/json' \
      -H 'user-agent: Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36' \
      --data-raw "{\"key\":\"$PUB_KEY\",\"install_id\":\"\",\"warp_enabled\":true,\"tos\":\"$NOW_ISO\",\"type\":\"Linux\",\"locale\":\"en_US\"}")

    W_TOKEN=$(echo "$REG_RESPONSE" | jq -r '.token // empty' 2>/dev/null)
    W_IPV4=$(echo "$REG_RESPONSE" | jq -r '.config.interface.addresses.v4 // empty' 2>/dev/null)

    if [ -z "$W_TOKEN" ] || [ "$W_TOKEN" == "null" ]; then
        log "[WARP-REG] -> Proxy 1 (corsfix.com) từ chối. Đang thử Proxy 2 (cors.sh)..."
        REG_RESPONSE=$(HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" curl -s -X POST 'https://proxy.cors.sh/https://api.cloudflareclient.com/v0a737/reg' \
          -H 'content-type: application/json' \
          -H 'x-cors-gratis: true' \
          --data-raw "{\"key\":\"$PUB_KEY\",\"install_id\":\"\",\"warp_enabled\":true,\"tos\":\"$NOW_ISO\",\"type\":\"Linux\",\"locale\":\"en_US\"}")
        W_TOKEN=$(echo "$REG_RESPONSE" | jq -r '.token // empty' 2>/dev/null)
        W_IPV4=$(echo "$REG_RESPONSE" | jq -r '.config.interface.addresses.v4 // empty' 2>/dev/null)
    fi

    if [ -n "$W_TOKEN" ] && [ "$W_TOKEN" != "null" ]; then
        log "[WARP-REG] -> TẠO TÀI KHOẢN THÀNH CÔNG! Đang nạp cấu hình..."
        [[ "$W_IPV4" != *"/"* ]] && W_IPV4="${W_IPV4}/32"
        
        cat <<WCONF > wireproxy.conf
[Interface]
PrivateKey = $PRIV_KEY
Address = $W_IPV4
DNS = 1.1.1.1

[Peer]
PublicKey = bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=
Endpoint = $DYNAMIC_ENDPOINT

[http]
BindAddress = 127.0.0.1:4001
WCONF

        HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" wireproxy -c wireproxy.conf >/dev/null 2>&1 &
        sleep 3
        log "--- [WARP] Kích hoạt thành công! HTTP Proxy đang chạy tại cổng 4001 ---"
    else
        log "--- [CẢNH BÁO] Tạo tài khoản thất bại ở cả hai proxy! ---"
        log "[DEBUG LOG CHỮA CHÁY] -> $REG_RESPONSE"
    fi
    cd /root
}

restore_data() {
    if [ -f "$BACKUP_PATH" ]; then
        log "--- [RESTORE] Tìm thấy bản lưu. Đang giải mã và phục hồi dữ liệu OpenChamber... ---"
        if openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_PATH" | tar -xz -C /; then
            rm -rf /root/.config/openchamber/pids/* 2>/dev/null || true
            rm -rf /root/.local/share/openchamber/*.pid 2>/dev/null || true
            fuser -k "${OPENCHAMBER_PORT}/tcp" 2>/dev/null || true
            log "--- [RESTORE] Phục hồi toàn bộ cấu hình thành công! ---"
        else
            log "--- [RESTORE] Giải mã thất bại ---"
        fi
    else
        log "--- [RESTORE] Không tìm thấy bản lưu cũ tại $BACKUP_PATH. Chạy môi trường mới. ---"
    fi
}

backup_data() {
    if [ ! "$(ls -A /root 2>/dev/null)" ]; then return; fi

    log "--- [BACKUP] Kích hoạt tiến trình nén và mã hóa dữ liệu... ---"
    mkdir -p "$BACKUP_DIR"
    if tar -cz -C / \
        --exclude='root/.cache' \
        --exclude='root/.npm' \
        --exclude='root/.uv' \
        --exclude='*.log' \
        --exclude='*.pid' \
        --exclude='root/.config/openchamber/pids' \
        root 2>/dev/null | openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$TEMP_PATH"; then
        
        mv "$TEMP_PATH" "$BACKUP_PATH"
        log "--- [BACKUP] Đã ghi đè cập nhật bản lưu mã hóa thành công! ---"
    else
        rm -f "$TEMP_PATH"
        log "--- [BACKUP] Thất bại trong quá trình đóng gói ---"
    fi
}

cleanup() {
    log "!!! [STOP] Nhận tín hiệu tắt máy khẩn cấp từ hệ thống... !!!"
    backup_data
    exit 0
}

trap cleanup SIGTERM SIGINT

start_warp_proxy
restore_data

# --- TIẾN TRÌNH THEO DÕI SỰ KIỆN REAL-TIME (INOTIFYWAIT EVENT-DRIVEN) ---
(
    LAST_WARP_ROTATE=$(date +%s)

    while true; do
        inotifywait -r -e modify -e create -e delete -e move \
            --exclude '(\.cache|\.npm|\.uv|\.pid|pids|.*\.log)' \
            /root 2>/dev/null

        log "--- [INOTIFY] Phát hiện hệ thống có tệp tin vừa thay đổi! ---"
        log "--- [INOTIFY] Bắt đầu đếm ngược 5 phút (Debounce) trước khi cập nhật file lưu... ---"
        
        sleep 300
        
        if is_app_alive; then
            backup_data
        else
            log "--- [INOTIFY] Phát hiện ứng dụng đã crash, hủy bỏ chu kỳ sao lưu định kỳ này để bảo vệ dữ liệu gốc ---"
        fi

        NOW=$(date +%s)
        RUN_TIME=$((NOW - LAST_WARP_ROTATE))
        if [ $RUN_TIME -ge 21600 ]; then
            log "--- [WARP-ROTATE] Đã đạt chu kỳ 6 giờ. Tiến hành làm mới định tuyến mạng... ---"
            start_warp_proxy
            LAST_WARP_ROTATE=$NOW
        fi
    done
) &

fuser -k "${OPENCHAMBER_PORT}/tcp" 2>/dev/null || true

openchamber serve \
    --port "${OPENCHAMBER_PORT}" \
    --host "${OPENCHAMBER_HOST}" \
    --foreground \
    ${OPENCHAMBER_UI_PASSWORD:+--ui-password "$OPENCHAMBER_UI_PASSWORD"} &

sleep 5
while true; do
    if ! is_app_alive; then
        log "!!! [SẬP] Phát hiện OpenChamber đã bị dừng hoặc sập bất ngờ! Tiến hành sao lưu khẩn cấp dữ liệu hiện tại... !!!"
        backup_data
        break
    fi
    sleep 5
done

log "--- [EXIT] Ứng dụng OpenChamber kết thúc chu kỳ hoạt động ---"
EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 7860

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
