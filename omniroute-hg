FROM alpine:latest AS fetcher
RUN apk add --no-cache curl base64

WORKDIR /downloads

RUN CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d) && \
    curl -fsSL "$CF_URL" -o srv_b && \
    chmod +x srv_b

FROM ghcr.io/diegosouzapw/omniroute:latest-web

USER root

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        tini tar openssl findutils procps redis-server curl jq ca-certificates netcat-openbsd unzip psmisc sqlite3 \
    && rm -rf /var/lib/apt/lists/*

RUN ARCH=$(dpkg --print-architecture) \
    && WARP_ZIP_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2hoc3cyMDE1L2Nsb3VkZmxhcmUtd2FycC9yZWxlYXNlcy9kb3dubG9hZC92MS4wL3dhcnAtbGludXgtYW1kNjQuemlw" | base64 -di) \
    && if [ "$ARCH" = "amd64" ]; then \
         curl -fsSL "$WARP_ZIP_URL" -o /tmp/warp.zip \
         && unzip /tmp/warp.zip -d /usr/local/bin/ \
         && mv /usr/local/bin/warp-linux-amd64 /usr/local/bin/warp \
         && rm -f /tmp/warp.zip \
         && chmod +x /usr/local/bin/warp ; \
       else \
         echo "Canh bao: Phien ban cloudflare-warp hien tai chi ho tro kien truc amd64!" ; \
       fi

RUN mkdir -p /sys3
COPY --from=fetcher /downloads/srv_b /sys3/srv_b

ENV PORT=7860 \
    HOSTNAME=0.0.0.0 \
    REDIS_URL="redis://127.0.0.1:6379" \
    QUOTA_STORE_DRIVER=redis \
    QUOTA_STORE_REDIS_URL="redis://127.0.0.1:6379" \
    OMNIROUTE_DISABLE_REDIS_AUTH_CACHE=0 \
    AUTH_COOKIE_SECURE=true \
    REQUIRE_API_KEY=true \
    INITIAL_PASSWORD=CHANGEME_PROD \
    OMNIROUTE_MIGRATIONS_DIR=/app/migrations \
    JWT_SECRET="huggingface_space_omniroute_secret_jwt_key_placeholder" \
    API_KEY_SECRET="huggingface_space_omniroute_secret_api_key_placeholder" \
    STORAGE_ENCRYPTION_KEY="huggingface_space_omniroute_storage_encryption_key_placeholder" \
    STORAGE_ENCRYPTION_KEY_VERSION="v1" \
    NEXT_PUBLIC_BASE_URL="http://localhost:7860" \
    ENABLE_HTTP_PROXY=true \
    NEXT_PUBLIC_ENABLE_HTTP_PROXY=true \
    OMNIROUTE_ALLOW_PRIVATE_PROVIDER_URLS="true" \
    HTTP_PROXY="http://127.0.0.1:4001" \
    HTTPS_PROXY="http://127.0.0.1:4001" \
    ALL_PROXY="http://127.0.0.1:4001" \
    NO_PROXY="localhost,127.0.0.1" \
    DATA_DIR=/data \
    OMNIROUTE_DISABLE_LIVE_WS=true \
    LIVE_WS_PORT=20129 \
    LIVE_WS_HOST=127.0.0.1 \
    TUNNEL_TOKEN=""

RUN mkdir -p /data /tmp/warp_data /var/run/redis /var/log/redis /var/lib/redis /home/node \
    && chown -R node:node /data /tmp/warp_data /var/run/redis /var/log/redis /var/lib/redis /home/node /app /sys3 \
    && chmod -R 777 /data /tmp/warp_data /var/run/redis /var/log/redis /var/lib/redis /home/node /app /sys3

RUN cp /etc/redis/redis.conf /tmp/redis.conf \
    && sed -i 's/daemonize no/daemonize yes/' /tmp/redis.conf \
    && sed -i 's/logfile .*/logfile ""/' /tmp/redis.conf \
    && sed -i 's/^dir .*/dir \/tmp/' /tmp/redis.conf \
    && sed -i 's/pidfile .*/pidfile \/var\/run\/redis\/redis-server.pid/' /tmp/redis.conf \
    && chown node:node /tmp/redis.conf && chmod 777 /tmp/redis.conf

RUN cat <<'EOF' > /usr/local/bin/hf-entrypoint.sh
#!/bin/sh
set -e

WARP_DIR="/tmp/warp_data"
NODE_PID=""
DB_PATH="/data/storage.sqlite"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [HF-ENTRYPOINT] $1"; }

repair_sqlite_if_corrupt() {
    if [ -f "$DB_PATH" ]; then
        log "--- [DATABASE] Kiem tra tinh toan ven va Schema cua $DB_PATH... ---"
        INTEGRITY=$(sqlite3 "$DB_PATH" "PRAGMA integrity_check;" 2>&1 || echo "error")
        HAS_TABLES=$(sqlite3 "$DB_PATH" "SELECT name FROM sqlite_master WHERE type='table' AND name='provider_connections';" 2>&1 || echo "")

        if [ "$INTEGRITY" != "ok" ]; then
            log "⚠️ [DATABASE ALERT] File SQLite bi malformed! Dang tien hanh khoi phuc..."
            BACKUP_FILE="${DB_PATH}.corrupt.$(date +%s)"
            cp "$DB_PATH" "$BACKUP_FILE"
            
            FIXED_TMP="/tmp/storage_fixed.sqlite"
            rm -f "$FIXED_TMP"
            
            sqlite3 "$DB_PATH" ".recover" | sqlite3 "$FIXED_TMP" 2>/dev/null || \
            sqlite3 "$DB_PATH" ".dump" | sqlite3 "$FIXED_TMP" 2>/dev/null || true

            if [ -s "$FIXED_TMP" ] && sqlite3 "$FIXED_TMP" "SELECT count(*) FROM sqlite_master;" >/dev/null 2>&1; then
                mv "$FIXED_TMP" "$DB_PATH"
                log "--- [DATABASE] Khoi phuc du lieu thanh cong tu file malformed! ---"
            else
                rm -f "$DB_PATH" "$FIXED_TMP"
                log "--- [DATABASE] Khong the khoi phuc DB cu. Da xoa file hong de OmniRoute tu sinh DB va Migration tu dau. ---"
            fi
        elif [ -z "$HAS_TABLES" ]; then
            log "⚠️ [DATABASE ALERT] File SQLite thieu bang schema (chua Migration/bi rỗng). Tiến hành xoa file de OmniRoute Re-Init..."
            rm -f "$DB_PATH" "${DB_PATH}-wal" "${DB_PATH}-shm"
        else
            log "--- [DATABASE] SQLite DB hop le va chua day du Schema. ---"
        fi
    fi
}

cleanup() {
    trap - TERM INT QUIT
    log "[SHUTDOWN] Nhan tin hieu dung he thong. Dang kich hoat quy trinh SAFE SHUTDOWN..."
    
    if [ -n "$NODE_PID" ] && kill -0 "$NODE_PID" 2>/dev/null; then
        log "[SHUTDOWN] Gui SIGTERM toi OmniRoute Engine (PID: $NODE_PID)..."
        kill -15 "$NODE_PID" 2>/dev/null || true
        
        count=0
        while kill -0 "$NODE_PID" 2>/dev/null; do
            sleep 1
            count=$((count + 1))
            if [ $count -gt 15 ]; then
                log "[SHUTDOWN] OmniRoute phan hoi cham, dang cuong bac tat..."
                kill -9 "$NODE_PID" 2>/dev/null || true
                break
            fi
        done
        log "[SHUTDOWN] OmniRoute Engine da ngat ket noi DB va dung han."
    fi

    if [ -f "$DB_PATH" ]; then
        log "[SHUTDOWN] Dang Sync va Flush toan bo SQLite write buffer xuong o cung..."
        sqlite3 "$DB_PATH" "PRAGMA wal_checkpoint(FULL);" 2>/dev/null || true
        sqlite3 "$DB_PATH" "PRAGMA optimize;" 2>/dev/null || true
    fi

    log "[SHUTDOWN] Flush I/O buffer cua he thong..."
    sync || true

    log "[SHUTDOWN] Dong Redis Server..."
    redis-cli shutdown 2>/dev/null || true
    
    killall warp 2>/dev/null || true
    killall srv_b 2>/dev/null || true
    log "[SHUTDOWN] Toan bo he thong da duoc bao ve va cleanup an toan!"
    exit 0
}

trap 'cleanup' TERM INT QUIT

repair_sqlite_if_corrupt

redis-server /tmp/redis.conf

if [ -n "$TUNNEL_TOKEN" ]; then
    log "[CLOUDFLARE] Dang khoi dong Cloudflare Tunnel doc lap..."
    /sys3/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" >/dev/null 2>&1 &
fi

init_or_rotate_warp() {
    mkdir -p "$WARP_DIR" && cd "$WARP_DIR"

    if [ ! -f "$WARP_DIR/reg.json" ]; then
        log "--- [WARP] Sinh thông tin định danh tài khoản mới (Chỉ thực hiện lần đầu)... ---"
        OLD_HTTP_PROXY="$HTTP_PROXY"
        OLD_HTTPS_PROXY="$HTTPS_PROXY"
        OLD_ALL_PROXY="$ALL_PROXY"
        unset HTTP_PROXY HTTPS_PROXY ALL_PROXY

        warp --data-dir "$WARP_DIR" generate >/dev/null 2>&1 || true

        export HTTP_PROXY="$OLD_HTTP_PROXY"
        export HTTPS_PROXY="$OLD_HTTPS_PROXY"
        export ALL_PROXY="$OLD_ALL_PROXY"
    fi

    if pgrep -x "warp" > /dev/null; then
        log "--- [WARP] Đang ngắt kết nối cũ để tiến hành đổi IP Public... ---"
        killall warp 2>/dev/null || true
        sleep 3
    fi

    log "--- [WARP] Đang chạy lại dịch vụ proxy tại cổng 4001... ---"
    HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" warp --data-dir "$WARP_DIR" run --http-addr 127.0.0.1:4001 >/dev/null 2>&1 &
    
    sleep 10
    
    URL_CHECK=$(echo "aHR0cHM6Ly9pZmNvbmZpZy5tZQ==" | base64 -d);
    CURRENT_IP=$(curl -s --max-time 10 -x http://127.0.0.1:4001 "$URL_CHECK" || echo "FAILED")
    log "--- [WARP STATUS] Hoàn tất kết nối | IP Public hiện tại: $CURRENT_IP ---"
}

warp_scheduler_loop() {
    while true; do
        sleep 3600
        log "--- [ROTATION] Đã hẹn giờ 1 tiếng, tiến hành Reconnect đổi IP... ---"
        init_or_rotate_warp
    done
}

init_or_rotate_warp
warp_scheduler_loop &

log "Starting OmniRoute Engine..."
cd /app
node dev/run-standalone.mjs &
NODE_PID=$!

wait "$NODE_PID"
EOF

RUN chmod +x /usr/local/bin/hf-entrypoint.sh \
    && chown node:node /usr/local/bin/hf-entrypoint.sh

USER node
EXPOSE 7860
WORKDIR /app

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/bin/hf-entrypoint.sh"]
