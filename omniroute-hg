FROM ghcr.io/diegosouzapw/omniroute:latest-web

USER root

# 1. Cài đặt các công cụ hệ thống cần thiết cho Redis và Warp
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        tini tar openssl findutils procps redis-server curl jq ca-certificates netcat-openbsd unzip psmisc \
    && rm -rf /var/lib/apt/lists/*

# 2. Tải và cấu hình Cloudflare Warp Go Proxy (amd64)
RUN ARCH=$(dpkg --print-architecture) \
    && WARP_ZIP_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2hoc3cyMDE1L2Nsb3VkZmxhcmUtd2FycC9yZWxlYXNlcy9kb3dubG9hZC92MS4wL3dhcnAtbGludXgtYW1kNjQuemlw" | base64 -di) \
    && if [ "$ARCH" = "amd64" ]; then \
         curl -fsSL "$WARP_ZIP_URL" -o /tmp/warp.zip \
         && unzip /tmp/warp.zip -d /usr/local/bin/ \
         && mv /usr/local/bin/warp-linux-amd64 /usr/local/bin/warp \
         && rm -f /tmp/warp.zip \
         && chmod +x /usr/local/bin/warp ; \
       else \
         echo "Canh bao: Phien ban cloudflare-warp hien tai chi ho tro kien truc amd64!" ; \
       fi

# 3. Cấu hình biến môi trường hệ thống (Tắt hẳn Live WS bằng biến môi trường của tác giả)
ENV PORT=7860 \
    HOSTNAME=0.0.0.0 \
    REDIS_URL="redis://127.0.0.1:6379" \
    QUOTA_STORE_DRIVER=redis \
    QUOTA_STORE_REDIS_URL="redis://127.0.0.1:6379" \
    OMNIROUTE_DISABLE_REDIS_AUTH_CACHE=0 \
    AUTH_COOKIE_SECURE=true \
    REQUIRE_API_KEY=true \
    INITIAL_PASSWORD=CHANGEME_PROD \
    OMNIROUTE_MIGRATIONS_DIR=/app/migrations \
    JWT_SECRET="huggingface_space_omniroute_secret_jwt_key_placeholder" \
    API_KEY_SECRET="huggingface_space_omniroute_secret_api_key_placeholder" \
    STORAGE_ENCRYPTION_KEY="huggingface_space_omniroute_storage_encryption_key_placeholder" \
    STORAGE_ENCRYPTION_KEY_VERSION="v1" \
    NEXT_PUBLIC_BASE_URL="http://localhost:7860" \
    ENABLE_HTTP_PROXY=true \
    NEXT_PUBLIC_ENABLE_HTTP_PROXY=true \
    OMNIROUTE_ALLOW_PRIVATE_PROVIDER_URLS="true" \
    # Định tuyến mạng qua Warp
    HTTP_PROXY="http://127.0.0.1:4001" \
    HTTPS_PROXY="http://127.0.0.1:4001" \
    ALL_PROXY="http://127.0.0.1:4001" \
    NO_PROXY="localhost,127.0.0.1" \
    DATA_DIR=/data \
    # 🛑 KHÓA CHẾ ĐỘ LIVE DASHBOARD WEBSOCKET
    OMNIROUTE_DISABLE_LIVE_WS=true \
    LIVE_WS_PORT=20129 \
    LIVE_WS_HOST=127.0.0.1

# 4. Tạo cấu trúc thư mục phân quyền sạch sẽ
RUN mkdir -p /data /tmp/warp_data /var/run/redis /var/log/redis /var/lib/redis /home/node \
    && chown -R node:node /data /tmp/warp_data /var/run/redis /var/log/redis /var/lib/redis /home/node /app \
    && chmod -R 777 /data /tmp/warp_data /var/run/redis /var/log/redis /var/lib/redis /home/node /app

RUN cp /etc/redis/redis.conf /tmp/redis.conf \
    && sed -i 's/daemonize no/daemonize yes/' /tmp/redis.conf \
    && sed -i 's/logfile .*/logfile ""/' /tmp/redis.conf \
    && sed -i 's/^dir .*/dir \/tmp/' /tmp/redis.conf \
    && sed -i 's/pidfile .*/pidfile \/var\/run\/redis\/redis-server.pid/' /tmp/redis.conf \
    && chown node:node /tmp/redis.conf && chmod 777 /tmp/redis.conf

# 5. Tạo Script Entrypoint mới tinh - ĐÃ LOẠI BỎ LIVE SOCKET
RUN cat <<'EOF' > /usr/local/bin/hf-entrypoint.sh
#!/bin/sh
set -e

WARP_DIR="/tmp/warp_data"
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [HF-ENTRYPOINT] $1"; }

# Khởi chạy Redis nội bộ
redis-server /tmp/redis.conf

# Hàm cấu hình và xoay Proxy Warp
init_or_rotate_warp() {
    mkdir -p "$WARP_DIR" && cd "$WARP_DIR"

    if [ ! -f "$WARP_DIR/reg.json" ]; then
        log "--- [WARP] Sinh thông tin định danh tài khoản mới (Chỉ thực hiện lần đầu)... ---"
        OLD_HTTP_PROXY="$HTTP_PROXY"
        OLD_HTTPS_PROXY="$HTTPS_PROXY"
        OLD_ALL_PROXY="$ALL_PROXY"
        unset HTTP_PROXY HTTPS_PROXY ALL_PROXY

        warp --data-dir "$WARP_DIR" generate >/dev/null 2>&1 || true

        export HTTP_PROXY="$OLD_HTTP_PROXY"
        export HTTPS_PROXY="$OLD_HTTPS_PROXY"
        export ALL_PROXY="$OLD_ALL_PROXY"
    fi

    if pgrep -x "warp" > /dev/null; then
        log "--- [WARP] Đang ngắt kết nối cũ để tiến hành đổi IP Public... ---"
        killall warp 2>/dev/null || true
        sleep 3
    fi

    log "--- [WARP] Đang chạy lại dịch vụ proxy tại cổng 4001... ---"
    HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" warp --data-dir "$WARP_DIR" run --http-addr 127.0.0.1:4001 >/dev/null 2>&1 &
    
    # ⏳ TĂNG THỜI GIAN CHỜ: Để Warp ổn định đường truyền trước khi nhường quyền cho OmniRoute Engine
    sleep 10
    
    URL_CHECK=$(echo "aHR0cHM6Ly9pZmNvbmZpZy5tZQ==" | base64 -d);
    CURRENT_IP=$(curl -s --max-time 10 -x http://127.0.0.1:4001 "$URL_CHECK" || echo "FAILED")
    log "--- [WARP STATUS] Hoàn tất kết nối | IP Public hiện tại: $CURRENT_IP ---"
}

warp_scheduler_loop() {
    while true; do
        sleep 3600
        log "--- [ROTATION] Đã hẹn giờ 1 tiếng, tiến hành Reconnect đổi IP... ---"
        init_or_rotate_warp
    done
}

cleanup() {
    trap - TERM INT QUIT
    log "[SHUTDOWN] Đang dừng hệ thống an toàn..."
    killall warp 2>/dev/null || true
    exit 0
}
trap 'cleanup' TERM INT QUIT

# Thực thi proxy
init_or_rotate_warp
warp_scheduler_loop &

# Chạy ứng dụng chính ở chế độ Foreground (ĐÃ BỎ ĐOẠN START-WS-SERVER)
log "Starting OmniRoute Engine..."
cd /app
exec node dev/run-standalone.mjs
EOF

RUN chmod +x /usr/local/bin/hf-entrypoint.sh \
    && chown node:node /usr/local/bin/hf-entrypoint.sh

USER node
EXPOSE 7860
WORKDIR /app

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hf-entrypoint.sh"]
