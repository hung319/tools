FROM debian:stable-slim

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    psmisc \
    tini \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /usr/local/bin && \
    MEDIAFLOW_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL21oZHp1bWFpci9tZWRpYWZsb3ctcHJveHktbGlnaHQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL21lZGlhZmxvdy1wcm94eS1saWdodC1saW51eC14ODZfNjQ=" | base64 -d) && \
    curl -fsSL "$MEDIAFLOW_URL" -o /usr/local/bin/mediaflow-proxy-light && \
    chmod +x /usr/local/bin/mediaflow-proxy-light

RUN mkdir -p /sys3 && \
    CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d) && \
    curl -fsSL "$CF_URL" -o /sys3/srv_b && \
    chmod +x /sys3/srv_b

ENV APP__SERVER__HOST=0.0.0.0 \
    APP__SERVER__PORT=7860 \
    APP__LOG_LEVEL=info \
    APP__AUTH__API_PASSWORD=huggingface_proxy_secure \
    TUNNEL_TOKEN=""

WORKDIR /data

RUN mkdir -p /data /sys3 && chmod -R 777 /data /sys3

RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh
#!/bin/bash
set +e

cleanup() {
    [ -n "${APP_PID:-}" ] && kill -TERM "$APP_PID" 2>/dev/null
    killall srv_b 2>/dev/null || true
    exit 0
}

trap cleanup SIGTERM SIGINT

if [ -n "$TUNNEL_TOKEN" ]; then
    /sys3/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" >/dev/null 2>&1 &
fi

fuser -k "${APP__SERVER__PORT}/tcp" 2>/dev/null || true

/usr/local/bin/mediaflow-proxy-light &

APP_PID=$!
wait "$APP_PID"
EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 7860

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
