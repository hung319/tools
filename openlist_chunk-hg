FROM alpine:latest AS fetcher
RUN apk add --no-cache curl jq coreutils
WORKDIR /downloads
RUN ARCH=$(uname -m) && \
    WIRE_API=$(echo "aHR0cHM6Ly9hcGkuZ2l0aHViLmNvbS9yZXBvcy93aW5kdGYvd2lyZXByb3h5L3JlbGVhc2VzL2xhdGVzdA==" | base64 -d) && \
    CF_URL_AMD64=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d) && \
    CF_URL_ARM64=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFybTY0" | base64 -d) && \
    if [ "$ARCH" = "x86_64" ] || [ "$ARCH" = "amd64" ]; then \
        WIRE_URL=$(curl -s $WIRE_API | jq -r '.assets[] | select(.name | contains("linux_amd64.tar.gz")) | .browser_download_url') && \
        CF_URL=$CF_URL_AMD64; \
    else \
        WIRE_URL=$(curl -s $WIRE_API | jq -r '.assets[] | select(.name | contains("linux_arm64.tar.gz")) | .browser_download_url') && \
        CF_URL=$CF_URL_ARM64; \
    fi && \
    curl -fsSL "$WIRE_URL" | tar -xz wireproxy && mv wireproxy srv_p && \
    curl -fsSL "$CF_URL" -o srv_b && \
    chmod +x srv_p srv_b

FROM ghcr.io/zmabin/openlist-chunk:latest
USER root

RUN apk add --no-cache curl jq bash tini openssl inotify-tools procps psmisc net-tools shadow transmission-daemon aria2 qbittorrent-nox ca-certificates

RUN mkdir -p /opt/openlist/sys2 /opt/openlist/sys3 /data && \
    chown -R openlist:openlist /opt/openlist /data
WORKDIR /opt/openlist

COPY --from=fetcher --chown=openlist:openlist /downloads/srv_p /opt/openlist/sys2/srv_p
COPY --from=fetcher --chown=openlist:openlist /downloads/srv_b /opt/openlist/sys3/srv_b

RUN cat << 'EOF' > /entrypoint.sh
#!/bin/bash
umask 022
mkdir -p /data/watch /data/downloads /opt/openlist/data /tmp/.config /tmp/.local /tmp/.config/qBittorrent /tmp/.local/share/qBittorrent
chown -R openlist:openlist /data /opt/openlist /tmp 2>/dev/null || true
chmod -R 777 /data /opt/openlist /tmp 2>/dev/null || true

curl -fsSL "$(echo "$WARP_SCRIPT_URL" | base64 -d)" -o /init-warp.sh && chmod +x /init-warp.sh
curl -fsSL "$(echo "$BACKUP_SCRIPT_URL" | base64 -d)" -o /manage-backup.sh && chmod +x /manage-backup.sh

function ext_exit() {
    /manage-backup.sh backup
    exit 0
}
trap ext_exit SIGTERM SIGINT SIGQUIT

[ "$RUN_ARIA2" = "true" ] && { mkdir -p /tmp/.config/aria2; [ ! -f /tmp/.config/aria2/aria2.session ] && touch /tmp/.config/aria2/aria2.session; aria2c --enable-rpc --rpc-listen-all --rpc-allow-origin-all --dir=/data --input-file=/tmp/.config/aria2/aria2.session --save-session=/tmp/.config/aria2/aria2.session --all-proxy="http://127.0.0.1:4001" >/dev/null 2>&1 & }
[ "$RUN_QBITTORRENT" = "true" ] && { cat <<EON > /tmp/.config/qBittorrent/qBittorrent.conf
[Preferences]
WebUI\Port=8080
WebUI\User=admin
WebUI\Password_PBKDF2="@ByteArray(ARQ77eY1NUZaQsuDHbIMCA==:0WMRkYTUWVT9wVvdDtHAjU9b3b7uB8NR1Gur2hmQCvCDpm39Q+PsJRJPaCU51dEiz+dTzh8qbPsL8WkFljQYFQ==)"
Proxy\Type=1
Proxy\IP=127.0.0.1
Proxy\Port=4001
Proxy\ProxyPeerConnections=true
Proxy\ProxyHostNameLookup=true
EON
qbittorrent-nox --confirm-legal-notice --webui-port=8080 >/dev/null 2>&1 & }
[ "$RUN_TRANSMISSION" = "true" ] && { mkdir -p /tmp/.config/transmission-daemon; (export HTTP_PROXY="http://127.0.0.1:4001" HTTPS_PROXY="http://127.0.0.1:4001" ALL_PROXY="http://127.0.0.1:4001"; transmission-daemon --foreground --port 9091 --config-dir /tmp/.config/transmission-daemon --download-dir /data/downloads --watch-dir /data/watch >/dev/null 2>&1 &) }

fuser -k "7860/tcp" 2>/dev/null || true
[ -n "$TUNNEL_TOKEN" ] && /opt/openlist/sys3/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" >/dev/null 2>&1 &

/manage-backup.sh restore

mkdir -p /tmp/wireproxy_temp && cd /tmp/wireproxy_temp
rm -f /opt/openlist/data/wireproxy.conf 2>/dev/null
/init-warp.sh && /opt/openlist/sys2/srv_p -c wireproxy.conf >/dev/null 2>&1 &

for i in {1..30}; do
    netstat -an | grep -q "4001.*LISTEN" && { break; }
    sleep 1
done

cd /opt/openlist
CONFIG_FILE="/opt/openlist/data/config.json"
[ ! -f "$CONFIG_FILE" ] && { /opt/openlist/openlist server --no-prefix & PID_TEMP=$!; sleep 3; kill $PID_TEMP 2>/dev/null || true; }
if [ -f "$CONFIG_FILE" ]; then
    sed -i 's/"http_port": 5244/"http_port": 7860/g' "$CONFIG_FILE"
    sed -i 's/"enable": false/"enable": true/g' "$CONFIG_FILE"
    sed -i 's|"proxy_address": ""|"proxy_address": "http://127.0.0.1:4001"|g' "$CONFIG_FILE"
fi

/manage-backup.sh watch &

rm -f /init-warp.sh

export HTTP_PROXY="http://127.0.0.1:4001" HTTPS_PROXY="http://127.0.0.1:4001" ALL_PROXY="http://127.0.0.1:4001"
exec /opt/openlist/openlist server --no-prefix
EOF

RUN chmod +x /entrypoint.sh

ENV WARP_SCRIPT_URL="aHR0cHM6Ly9naXRodWIuY29tL2h1bmczMTkvdG9vbHMvcmF3L3JlZnMvaGVhZHMvc2hlbGwvaW5pdC13YXJwLnNo" \
    BACKUP_SCRIPT_URL="aHR0cHM6Ly9naXRodWIuY29tL2h1bmczMTkvdG9vbHMvcmF3L3JlZnMvaGVhZHMvc2hlbGwvbWFuYWdlLWJhY2t1cC5zaA==" \
    PORT=7860 \
    RUN_ARIA2=true \
    RUN_QBITTORRENT=true \
    RUN_TRANSMISSION=true \
    HOME=/tmp \
    XDG_CONFIG_HOME=/tmp/.config \
    XDG_DATA_HOME=/tmp/.local \
    BACKUP_DIR="/data" \
    BACKUP_FILENAME="openlist_backup.enc" \
    BACKUP_PASS="123456" \
    NO_PROXY="localhost,127.0.0.1" \
    TUNNEL_TOKEN="" \
    SITE_URL="" \
    JWT_SECRET="" \
    MEILI_HOST="" \
    MEILI_KEY="" \
    MEILI_INDEX=""

USER root
EXPOSE 7860
ENTRYPOINT ["/sbin/tini", "--", "/bin/bash", "/entrypoint.sh"]
