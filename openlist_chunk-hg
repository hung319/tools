FROM alpine:latest AS fetcher
RUN apk add --no-cache curl jq coreutils

WORKDIR /downloads

RUN ARCH=$(uname -m) && \
    WIRE_API=$(echo "aHR0cHM6Ly9hcGkuZ2l0aHViLmNvbS9yZXBvcy93aW5kdGYvd2lyZXByb3h5L3JlbGVhc2VzL2xhdGVzdA==" | base64 -d) && \
    CF_URL_AMD64=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d) && \
    CF_URL_ARM64=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFybTY0" | base64 -d) && \
    if [ "$ARCH" = "x86_64" ] || [ "$ARCH" = "amd64" ]; then \
        WIRE_URL=$(curl -s $WIRE_API | jq -r '.assets[] | select(.name | contains("linux_amd64.tar.gz")) | .browser_download_url') && \
        CF_URL=$CF_URL_AMD64; \
    else \
        WIRE_URL=$(curl -s $WIRE_API | jq -r '.assets[] | select(.name | contains("linux_arm64.tar.gz")) | .browser_download_url') && \
        CF_URL=$CF_URL_ARM64; \
    fi && \
    curl -fsSL "$WIRE_URL" | tar -xz wireproxy && mv wireproxy srv_p && \
    curl -fsSL "$CF_URL" -o srv_b && \
    chmod +x srv_p srv_b

FROM ghcr.io/zmabin/openlist-chunk:latest

USER root

# GIỮ NGUYÊN các gói cốt lõi ban đầu của bạn, KHÔNG cài thêm python hay wg-tools
RUN apk add --no-cache curl jq bash tini openssl inotify-tools procps psmisc net-tools shadow transmission-daemon aria2 qbittorrent-nox ca-certificates

RUN mkdir -p /opt/openlist/sys2 /opt/openlist/sys3 /data && \
    chown -R openlist:openlist /opt/openlist /data

WORKDIR /opt/openlist

COPY --from=fetcher --chown=openlist:openlist /downloads/srv_p /opt/openlist/sys2/srv_p
COPY --from=fetcher --chown=openlist:openlist /downloads/srv_b /opt/openlist/sys3/srv_b

RUN cat << 'EOF' > /entrypoint.sh
#!/bin/bash

umask 022
mkdir -p /data/watch /data/downloads /opt/openlist/data /tmp/.config /tmp/.local /tmp/.config/qBittorrent /tmp/.local/share/qBittorrent
chown -R openlist:openlist /data /opt/openlist /tmp 2>/dev/null || true
chmod -R 777 /data /opt/openlist /tmp 2>/dev/null || true

function do_backup() {
    echo "[BACKUP] Dang quet va dong goi du lieu ma hoa..."
    mkdir -p "$BACKUP_DIR"
    tar -cz -C / /opt/openlist/data /tmp/.config/qBittorrent /tmp/.local/share/qBittorrent 2>/dev/null | \
    openssl enc -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -out "$BACKUP_DIR/$BACKUP_FILENAME"
    echo "[BACKUP] Da luu tru an toan vao $BACKUP_DIR/$BACKUP_FILENAME!"
}

function ext_exit() {
    echo "[SHUTDOWN] Nhan tín hieu dung container. Dang luu du lieu lan cuoi..."
    do_backup
    echo "[SHUTDOWN] Hoan tat! Tam biet."
    exit 0
}

trap ext_exit SIGTERM SIGINT SIGQUIT

if [ "$RUN_ARIA2" = "true" ]; then
    echo "[AIO] khoi hanh Aria2..."
    mkdir -p /tmp/.config/aria2
    [ ! -f /tmp/.config/aria2/aria2.session ] && touch /tmp/.config/aria2/aria2.session
    aria2c --enable-rpc --rpc-listen-all --rpc-allow-origin-all --dir=/data --input-file=/tmp/.config/aria2/aria2.session --save-session=/tmp/.config/aria2/aria2.session --all-proxy="http://127.0.0.1:4001" >/dev/null 2>&1 &
fi

if [ "$RUN_QBITTORRENT" = "true" ]; then
    echo "[AIO] khoi hanh qBittorrent..."
    if [ ! -f /tmp/.config/qBittorrent/qBittorrent.conf ]; then
        cat <<EON > /tmp/.config/qBittorrent/qBittorrent.conf
[Preferences]
WebUI\Port=8080
WebUI\User=admin
WebUI\Password_PBKDF2="@ByteArray(ARQ77eY1NUZaQsuDHbIMCA==:0WMRkYTUWVT9wVvdDtHAjU9b3b7uB8NR1Gur2hmQCvCDpm39Q+PsJRJPaCU51dEiz+dTzh8qbPsL8WkFljQYFQ==)"
Proxy\Type=1
Proxy\IP=127.0.0.1
Proxy\Port=4001
Proxy\ProxyPeerConnections=true
Proxy\ProxyHostNameLookup=true
EON
    fi
    qbittorrent-nox --confirm-legal-notice --webui-port=8080 >/dev/null 2>&1 &
fi

if [ "$RUN_TRANSMISSION" = "true" ]; then
    echo "[AIO] khoi hanh Transmission..."
    mkdir -p /tmp/.config/transmission-daemon
    (export HTTP_PROXY="http://127.0.0.1:4001" HTTPS_PROXY="http://127.0.0.1:4001" ALL_PROXY="http://127.0.0.1:4001"; transmission-daemon --foreground --port 9091 --config-dir /tmp/.config/transmission-daemon --download-dir /data/downloads --watch-dir /data/watch >/dev/null 2>&1 &)
fi

fuser -k "7860/tcp" 2>/dev/null || true
if [ -n "$TUNNEL_TOKEN" ]; then
    echo "[CLOUDFLARE] Dang khoi dong Cloudflare Tunnel..."
    /opt/openlist/sys3/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" >/dev/null 2>&1 &
fi

mkdir -p /tmp/wireproxy_temp && cd /tmp/wireproxy_temp

if [ -f "$BACKUP_DIR/$BACKUP_FILENAME" ]; then
    echo "[RESTORE] Thuc hien giai nen phuc hoi..."
    openssl enc -d -aes-256-cbc -pbkdf2 -pass pass:"$BACKUP_PASS" -in "$BACKUP_DIR/$BACKUP_FILENAME" | tar -xz -C / 2>/dev/null && echo "[RESTORE] Xong!"
fi

rm -f /opt/openlist/data/wireproxy.conf 2>/dev/null

echo "[WARP-SCAN] Dang quet nhanh Endpoint toi uu bang Bash (Fresh Mode)..."
ips=("162.159.192" "162.159.193" "162.159.195" "162.159.204" "188.114.96" "188.114.97" "188.114.98" "188.114.99")
ports=(2408 500 864 880 894 934 1070 1180 3476 3581 4198 4500 5279 5956 7103 7152 7559 8319 8854 8886)
HEX_DATA="\x04\x1d\x69\xe6\x79\x22\x09\x9a\xa0\xb9\x3d\x1e\x7b\x30\x9e\xc5\x85\x1e\xe2\xa3\xd6\xbf\x82\xa8\xbb\x5b\xb0\x3e\xd4\x6f\xb2\x34\x65\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x77\xa4\xa8\xcd\x5d\x88\x3e\x66\x08\x8e\x5f\x70\xad\xb4\x2f\x8a"
DYNAMIC_ENDPOINT=""
best_latency=9999

for i in {1..12}; do
    rand_sub=${ips[$RANDOM % ${#ips[@]}]}
    rand_host=$((RANDOM % 254 + 1))
    rand_port=${ports[$RANDOM % ${#ports[@]}]}
    target_ip="${rand_sub}.${rand_host}"
    
    start_t=$(date +%s%3N)
    res=$(echo -ne "$HEX_DATA" | nc -w 1 -u "$target_ip" "$rand_port" 2>/dev/null | head -c 5 | xxd -p 2>/dev/null)
    end_t=$(date +%s%3N)
    
    if [[ "$res" == "cf00000000" ]]; then
        latency=$((end_t - start_t))
        if [ "$latency" -lt "$best_latency" ]; then
            best_latency=$latency
            DYNAMIC_ENDPOINT="${target_ip}:${rand_port}"
        fi
    fi
done

if [ -z "$DYNAMIC_ENDPOINT" ]; then
    echo "[WARP-SCAN] Khong scan kip endpoint hop le. Chuyen ve Endpoint mac dinh..."
    DYNAMIC_ENDPOINT="188.114.97.242:7559"
else
    echo "[WARP-SCAN] Da tim thay Endpoint ngon nhat: $DYNAMIC_ENDPOINT (Ping: ${best_latency}ms)"
fi

echo "[WARP-REG] Dang ky tai khoan thuc qua corsfix.com..."

# Giải pháp thuần túy cắt byte OpenSSL để có đúng định dạng thô (Raw 32 bytes) cho Private Key và Public Key
openssl genpkey -algorithm X25519 -outform DER -out x25519_priv.der 2>/dev/null
PRIV_KEY=$(tail -c 32 x25519_priv.der | base64 | tr -d '\n\r ')

openssl pkey -inform DER -in x25519_priv.der -pubout -outform DER -out x25519_pub.der 2>/dev/null
PUB_KEY=$(tail -c 32 x25519_pub.der | base64 | tr -d '\n\r ')

rm -f x25519_priv.der x25519_pub.der

NOW_ISO=$(date -u +"%Y-%m-%dT%H:%M:%S.000Z")

# Fallback: Nếu proxy.corsfix.com lỗi, có thể thử proxy công cộng khác tương đương
REG_RESPONSE=$(curl -s 'https://proxy.corsfix.com/?https://api.cloudflareclient.com/v0a737/reg' \
  -H 'authority: proxy.corsfix.com' \
  -H 'accept: */*' \
  -H 'accept-language: vi-VN,vi;q=0.9' \
  -H 'content-type: application/json' \
  -H 'origin: https://lanrat.github.io' \
  -H 'referer: https://lanrat.github.io/' \
  -H 'user-agent: Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Mobile Safari/537.36' \
  --data-raw "{\"key\":\"$PUB_KEY\",\"install_id\":\"\",\"warp_enabled\":true,\"tos\":\"$NOW_ISO\",\"type\":\"Linux\",\"locale\":\"en_US\"}")

W_TOKEN=$(echo "$REG_RESPONSE" | jq -r '.token // empty' 2>/dev/null)
W_IPV4=$(echo "$REG_RESPONSE" | jq -r '.config.interface.addresses.v4 // empty' 2>/dev/null)

if [ -n "$W_TOKEN" ] && [ "$W_TOKEN" != "null" ]; then
    echo "[WARP-REG] -> TAO TAI KHOAN SUCCESS! Dang nap..."
    [[ "$W_IPV4" != *"/"* ]] && W_IPV4="${W_IPV4}/32"
    
    printf "[Interface]\nPrivateKey = %s\nAddress = %s\nDNS = 1.1.1.1\n\n[Peer]\nPublicKey = bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=\nEndpoint = %s\n\n[http]\nBindAddress = 127.0.0.1:4001\n" \
    "$PRIV_KEY" "$W_IPV4" "$DYNAMIC_ENDPOINT" > wireproxy.conf
else
    echo "[WARP-REG] -> Tao tai khoan tai corsfix, thu thu voi proxy.cors.sh..."
    REG_RESPONSE=$(curl -s 'https://proxy.cors.sh/https://api.cloudflareclient.com/v0a737/reg' \
      -H 'accept: */*' \
      -H 'content-type: application/json' \
      -H 'x-cors-gratis: true' \
      --data-raw "{\"key\":\"$PUB_KEY\",\"install_id\":\"\",\"warp_enabled\":true,\"tos\":\"$NOW_ISO\",\"type\":\"Linux\",\"locale\":\"en_US\"}")
    W_TOKEN=$(echo "$REG_RESPONSE" | jq -r '.token // empty' 2>/dev/null)
    W_IPV4=$(echo "$REG_RESPONSE" | jq -r '.config.interface.addresses.v4 // empty' 2>/dev/null)
    
    if [ -n "$W_TOKEN" ] && [ "$W_TOKEN" != "null" ]; then
        echo "[WARP-REG] -> TAO TAI KHOAN SUCCESS (via cors.sh)! Dang nap..."
        [[ "$W_IPV4" != *"/"* ]] && W_IPV4="${W_IPV4}/32"
        printf "[Interface]\nPrivateKey = %s\nAddress = %s\nDNS = 1.1.1.1\n\n[Peer]\nPublicKey = bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=\nEndpoint = %s\n\n[http]\nBindAddress = 127.0.0.1:4001\n" \
        "$PRIV_KEY" "$W_IPV4" "$DYNAMIC_ENDPOINT" > wireproxy.conf
    else
        echo "[WARP-REG] -> Tao tai khoan that bai o ca hai proxy!"
        echo "[LOG PHAN HOI TU API] -> $REG_RESPONSE"
        exit 1
    fi
fi

/opt/openlist/sys2/srv_p -c wireproxy.conf >/dev/null 2>&1 &

echo "[MAIN] Cho dong bo hoa Wireproxy tai port 4001..."
for i in {1..30}; do
    if netstat -an | grep -q "4001.*LISTEN"; then
        echo "[MAIN] Wireproxy da ONLINE thanh cong tai port 4001!"
        break
    fi
    sleep 1
done

cd /opt/openlist
CONFIG_FILE="/opt/openlist/data/config.json"

if [ ! -f "$CONFIG_FILE" ]; then
    /opt/openlist/openlist server --no-prefix &
    PID_TEMP=$!
    sleep 3
    kill $PID_TEMP 2>/dev/null || true
fi

if [ -f "$CONFIG_FILE" ]; then
    echo "[CONFIG] Chinh sua file config..."
    sed -i 's/"http_port": 5244/"http_port": 7860/g' "$CONFIG_FILE"
    sed -i 's/"enable": false/"enable": true/g' "$CONFIG_FILE"
    sed -i 's|"proxy_address": ""|"proxy_address": "http://127.0.0.1:4001"|g' "$CONFIG_FILE"
    
    if [ -n "$SITE_URL" ]; then
        sed -i "s|\"site_url\": \"\"|\"site_url\": \"$SITE_URL\"|g" "$CONFIG_FILE"
    fi
    if [ -n "$JWT_SECRET" ]; then
        sed -i "s|\"jwt_secret\": \"random_generated\"|\"jwt_secret\": \"$JWT_SECRET\"|g" "$CONFIG_FILE"
    fi
    if [ -n "$MEILI_HOST" ]; then
        sed -i "s|\"host\": \"http://localhost:7700\"|\"host\": \"$MEILI_HOST\"|g" "$CONFIG_FILE"
    fi
    if [ -n "$MEILI_KEY" ]; then
        sed -i "s|\"api_key\": \"\"|\"api_key\": \"$MEILI_KEY\"|g" "$CONFIG_FILE"
    fi
    if [ -n "$MEILI_INDEX" ]; then
        sed -i "s|\"index\": \"openlist\"|\"index\": \"$MEILI_INDEX\"|g" "$CONFIG_FILE"
        sed -i "s|\"index\": \"\"|\"index\": \"$MEILI_INDEX\"|g" "$CONFIG_FILE"
    fi
fi

(
    last_run=0
    inotifywait -m -e modify,create,delete,move -r /opt/openlist/data /tmp/.config/qBittorrent 2>/dev/null | while read path action file; do
        now=$(date +%s)
        if (( now - last_run > 300 )); then
            last_run=$now
            echo "[INOTIFY] Phat hien thay doi cấu hình, đang auto-backup sau 5 phut..."
            sleep 300
            do_backup
        fi
    done
) &

export HTTP_PROXY="http://127.0.0.1:4001" HTTPS_PROXY="http://127.0.0.1:4001" ALL_PROXY="http://127.0.0.1:4001"
exec /opt/openlist/openlist server --no-prefix
EOF

RUN chmod +x /entrypoint.sh

ENV PORT=7860 \
    RUN_ARIA2=true \
    RUN_QBITTORRENT=true \
    RUN_TRANSMISSION=true \
    HOME=/tmp \
    XDG_CONFIG_HOME=/tmp/.config \
    XDG_DATA_HOME=/tmp/.local \
    BACKUP_DIR="/data" \
    BACKUP_FILENAME="openlist_backup.enc" \
    BACKUP_PASS="123456" \
    NO_PROXY="localhost,127.0.0.1" \
    TUNNEL_TOKEN="" \
    SITE_URL="" \
    JWT_SECRET="" \
    MEILI_HOST="" \
    MEILI_KEY="" \
    MEILI_INDEX=""

USER root
EXPOSE 7860
ENTRYPOINT ["/sbin/tini", "--", "/bin/bash", "/entrypoint.sh"]
