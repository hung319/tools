FROM python:3.10-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

USER root

# Cài đặt các gói hệ thống cần thiết (bao gồm unzip để giải nén warp và psmisc để dùng lệnh killall)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        tini tar openssl findutils procps inotify-tools curl jq ca-certificates unzip psmisc \
    && rm -rf /var/lib/apt/lists/*

# Tải và cấu hình Cloudflare Warp Go Proxy (Thay thế cho wgcf và wireproxy)
RUN ARCH=$(dpkg --print-architecture) \
    && WARP_ZIP_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2hoc3cyMDE1L2Nsb3VkZmxhcmUtd2FycC9yZWxlYXNlcy9kb3dubG9hZC92MS4wL3dhcnAtbGludXgtYW1kNjQuemlw" | base64 -d) \
    && if [ "$ARCH" != "amd64" ]; then \
         echo "Canh bao: Phien ban cloudflare-warp hien tai chi ho tro kien truc amd64!" ; \
       fi \
    && curl -fsSL "$WARP_ZIP_URL" -o /tmp/warp.zip \
    && unzip /tmp/warp.zip -d /usr/local/bin/ \
    && mv /usr/local/bin/warp-linux-amd64 /usr/local/bin/warp \
    && rm -f /tmp/warp.zip \
    && chmod +x /usr/local/bin/warp

WORKDIR /app

# Khởi tạo môi trường ảo Python và cài đặt các thư viện backend
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /app/.venv && \
    . /app/.venv/bin/activate && \
    uv pip install "llm4free[api]" fastapi uvicorn httpx

# Thiết lập các biến môi trường hệ thống và định tuyến Proxy qua cổng 4001 của Warp
ENV PORT=7860 \
    PATH="/app/.venv/bin:$PATH" \
    LLM4FREE_HOST=127.0.0.1 \
    LLM4FREE_PORT=8000 \
    LLM4FREE_API_KEY="sk-my-super-secret-key-2026" \
    HTTP_PROXY="http://127.0.0.1:4001" \
    HTTPS_PROXY="http://127.0.0.1:4001" \
    ALL_PROXY="http://127.0.0.1:4001" \
    NO_PROXY="localhost,127.0.0.1"

# Tạo sẵn thư mục lưu dữ liệu cấu hình cố định cho Warp để giữ lại reg.json
RUN mkdir -p /tmp/warp_data /app && chmod -R 777 /tmp/warp_data /app

# Tạo file Auth Wrapper bảo mật kết nối nội bộ
RUN cat <<'EOF' > /app/auth_wrapper.py
import os
import httpx
from fastapi import FastAPI, Request, Response, HTTPException, Depends
from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials

app = FastAPI(title="LLM4Free Auth Wrapper")
security = HTTPBearer()
API_KEY = os.getenv("LLM4FREE_API_KEY", "sk-my-super-secret-key-2026")
TARGET_URL = "http://127.0.0.1:8000"

def verify_token(credentials: HTTPAuthorizationCredentials = Depends(security)):
    if credentials.credentials != API_KEY:
        raise HTTPException(status_code=401, detail="Invalid API Key / Unauthorized")
    return credentials.credentials

@app.api_route("/{path:path}", methods=["GET", "POST", "PUT", "DELETE", "OPTIONS", "HEAD", "PATCH"])
async def proxy_gateway(path: str, request: Request, token: str = Depends(verify_token)):
    if path in ["docs", "openapi.json", "redoc", "monitor/health"]:
        pass

    url = f"{TARGET_URL}/{path}"
    headers = dict(request.headers)
    headers.pop("host", None)
    
    async with httpx.AsyncClient(timeout=None, trust_env=False) as client:
        req_content = await request.body()
        resp = await client.request(
            method=request.method,
            url=url,
            headers=headers,
            params=dict(request.query_params),
            content=req_content
        )
        return Response(content=resp.content, status_code=resp.status_code, headers=dict(resp.headers))
EOF

# Tạo script Entrypoint điều phối: Quản lý Warp (chỉ generate 1 lần), tự xoay IP sau mỗi 1 giờ
RUN cat <<'EOF' > /usr/local/bin/hf-entrypoint.sh
#!/bin/sh

WARP_DIR="/tmp/warp_data"
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [HF-ENTRYPOINT] $1"; }

init_or_rotate_warp() {
    mkdir -p "$WARP_DIR" && cd "$WARP_DIR"

    # 1. KIỂM TRA ĐĂNG KÝ: Chỉ tạo file reg.json một lần duy nhất lúc khởi tạo container lần đầu
    if [ ! -f "$WARP_DIR/reg.json" ]; then
        log "--- [WARP] Sinh thông tin định danh tài khoản mới (Chỉ thực hiện lần đầu)... ---"
        OLD_HTTP_PROXY="$HTTP_PROXY"
        OLD_HTTPS_PROXY="$HTTPS_PROXY"
        OLD_ALL_PROXY="$ALL_PROXY"
        unset HTTP_PROXY HTTPS_PROXY ALL_PROXY

        warp --data-dir "$WARP_DIR" generate >/dev/null 2>&1 || true

        export HTTP_PROXY="$OLD_HTTP_PROXY"
        export HTTPS_PROXY="$OLD_HTTPS_PROXY"
        export ALL_PROXY="$OLD_ALL_PROXY"
    fi

    # 2. NGẮT KẾT NỐI: Tắt tiến trình cũ nếu đang chạy để chuẩn bị làm mới đường truyền
    if pgrep -x "warp" > /dev/null; then
        log "--- [WARP] Đang ngắt kết nối để chuẩn bị làm mới IP Public... ---"
        killall warp 2>/dev/null || true
        sleep 3
    fi

    # 3. KẾT NỐI LẠI: Chạy lại Warp dựa trên token cũ, ép đổi Edge Node để lấy IP Public mới
    log "--- [WARP] Đang khởi chạy lại dịch vụ proxy tại cổng 4001... ---"
    HTTP_PROXY="" HTTPS_PROXY="" ALL_PROXY="" warp --data-dir "$WARP_DIR" run --http-addr 127.0.0.1:4001 >/dev/null 2>&1 &
    sleep 5
    
    # Kiểm định thực tế IP Public vừa được cập nhật
    URL_CHECK=$(echo "aHR0cHM6Ly9pZmNvbmZpZy5tZQ==" | base64 -d);
    CURRENT_IP=$(curl -s --max-time 5 -x http://127.0.0.1:4001 "$URL_CHECK" || echo "FAILED")
    log "--- [WARP STATUS] Hoàn tất kết nối | IP Public hiện tại: $CURRENT_IP ---"
}

# Vòng lặp chạy ngầm: Tự động ngắt - kết nối lại sau mỗi 3600 giây (1 giờ)
warp_scheduler_loop() {
    while true; do
        sleep 3600
        log "--- [ROTATION] Đã qua 1 giờ, tiến hành làm mới IP Public (Safe Reconnect)... ---"
        init_or_rotate_warp
    done
}

# Thực thi cấu hình Warp ban đầu
init_or_rotate_warp

# Kích hoạt vòng lặp xoay IP chạy ngầm
warp_scheduler_loop &

log "--- Starting LLM4Free Backend Server (Internal Port 8000)... ---"
/app/.venv/bin/llm4free-server > /dev/null 2>&1 &

log "--- Starting Authentication Wrapper Proxy (Public Port 7860)... ---"
cd /app
exec /app/.venv/bin/uvicorn auth_wrapper:app --host 0.0.0.0 --port 7860 --log-level info
EOF

RUN chmod +x /usr/local/bin/hf-entrypoint.sh

EXPOSE 7860
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/hf-entrypoint.sh"]
