    <span class="method method-get">GET</span>
    <span class="endpoint-path">/settings</span>
    <span class="endpoint-desc">Get all settings</span>
  </div>
  <div class="endpoint-body">
    <div class="try-it" onclick="event.stopPropagation()">
      <div class="btn-row">
        <button onclick="tryIt(this, 'GET', '/settings')">Try it</button>
      </div>
      <div class="result"></div>
    </div>
  </div>
</div>

<div class="endpoint" onclick="toggle(this)">
  <div class="endpoint-header">
    <span class="method method-any">*</span>
    <span class="endpoint-path">/raw/*</span>
    <span class="endpoint-desc">Raw passthrough to Lingarr</span>
  </div>
  <div class="endpoint-body">
    <p>Forward any request directly to the Lingarr API. Example:</p>
    <pre>GET /raw/api/SomeEndpoint?foo=bar</pre>
  </div>
</div>

<div class="footer">
  Lingarr Worker API Docs &mdash; <a href="https://lingarr.com/docs/api/definitions/1.0.5.json" style="color:var(--accent)">Lingarr API Spec</a>
</div>

</div>

<script>
function toggle(el) {
  el.classList.toggle('open');
}

async function tryIt(btn, method, path, body) {
  const baseUrl = document.getElementById('baseUrl').textContent;
  const secret = prompt('Enter your WORKER_SECRET:');
  if (!secret) return;

  const opts = {
    method,
    headers: {
      'Authorization': 'Bearer ' + secret,
      'Content-Type': 'application/json',
    },
  };
  if (body && method !== 'GET') {
    opts.body = typeof body === 'string' ? body : JSON.stringify(body);
  }

  const resultDiv = btn.closest('.try-it').querySelector('.result');
  resultDiv.innerHTML = '<pre style="color:var(--muted)">Loading...</pre>';

  try {
    const resp = await fetch(baseUrl + path, opts);
    const text = await resp.text();
    let formatted;
    try {
      formatted = JSON.stringify(JSON.parse(text), null, 2);
    } catch {
      formatted = text;
    }
    const color = resp.ok ? 'var(--green)' : 'var(--red)';
    resultDiv.innerHTML =
      '<pre style="border-left:3px solid ' + color + '; padding-left:.8rem">' +
      '<span style="color:' + color + '">HTTP ' + resp.status + '</span>\\n' +
      escapeHtml(formatted) + '</pre>';
  } catch (e) {
    resultDiv.innerHTML = '<pre style="color:var(--red)">Error: ' + escapeHtml(e.message) + '</pre>';
  }
}

async function tryUpload(btn) {
  const baseUrl = document.getElementById('baseUrl').textContent;
  const secret = prompt('Enter your WORKER_SECRET:');
  if (!secret) return;

  const textarea = btn.closest('.try-it').querySelector('textarea');
  const content = textarea.value;

  const resultDiv = btn.closest('.try-it').querySelector('.result');
  resultDiv.innerHTML = '<pre style="color:var(--muted)">Loading...</pre>';

  try {
    const resp = await fetch(baseUrl + '/translate/upload?from=en&to=vi', {
      method: 'POST',
      headers: {
        'Authorization': 'Bearer ' + secret,
        'Content-Type': 'text/plain',
      },
      body: content,
    });
    const text = await resp.text();
    let formatted;
    try {
      formatted = JSON.stringify(JSON.parse(text), null, 2);
    } catch {
      formatted = text;
    }
    const color = resp.ok ? 'var(--green)' : 'var(--red)';
    resultDiv.innerHTML =
      '<pre style="border-left:3px solid ' + color + '; padding-left:.8rem">' +
      '<span style="color:' + color + '">HTTP ' + resp.status + '</span>\\n' +
      escapeHtml(formatted) + '</pre>';
  } catch (e) {
    resultDiv.innerHTML = '<pre style="color:var(--red)">Error: ' + escapeHtml(e.message) + '</pre>';
  }
}

function escapeHtml(str) {
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
</script>
</body>
</html>`;
