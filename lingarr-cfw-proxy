    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: .45rem 1rem;
    font-size: .8rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity .15s;
  }
  .try-it button:hover { opacity: .85; }
  .try-it .result {
    margin-top: .5rem;
    max-height: 250px;
    overflow: auto;
  }

  .tag { display: inline-block; font-size: .65rem; padding: .1rem .4rem; border-radius: 3px; margin-left: .35rem; vertical-align: middle; }
  .tag-file { background: rgba(251,146,60,.15); color: var(--orange); }
  .tag-url { background: rgba(34,211,238,.15); color: var(--cyan); }

  .footer {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: .78rem;
    text-align: center;
  }

  @media (max-width: 640px) {
    .endpoint-desc { display: none; }
    .container { padding: 1rem; }
  }
</style>
</head>
<body>
<div class="container">

<header>
  <h1><span>Lingarr</span> Worker API</h1>
  <p>Simplified proxy for the Lingarr subtitle translation API. Deploy on Cloudflare Workers.</p>
