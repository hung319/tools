/**
 * Lingarr Cloudflare Worker — Simplified Proxy
 *
 * Env vars (set via `wrangler secret put`):
 *   LINGARR_URL   — Base URL of your Lingarr instance (e.g. http://192.168.1.10:9876)
 *   LINGARR_KEY   — Your Lingarr API key (X-Api-Key)
 *   WORKER_SECRET — A secret string clients must send as Authorization: Bearer <this>
 *
 * Features:
 *   - Simplified endpoint names
 *   - Injects X-Api-Key automatically
 *   - Subtitle input: file upload (multipart), URL, or path string
 *   - Both GET and POST for most endpoints
 *   - /docs serves an interactive documentation page
 */

const CORS = {
  "Access-Control-Allow-Origin": "*",
  "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type, Authorization",
};

// ── Route table ──────────────────────────────────────────────────────────
// Each entry: { methods, handler }
// handler(env, url, request, params) → Response

const ROUTES = [
  // ── Health / Docs ──────────────────────────────────────────────
  { path: "/", methods: ["GET"], handler: () => json({ status: "ok", service: "lingarr-proxy", docs: "/docs" }) },
  { path: "/health", methods: ["GET"], handler: () => json({ status: "ok", service: "lingarr-proxy" }) },
  { path: "/docs", methods: ["GET"], handler: serveDocs },

  // ── Auth ───────────────────────────────────────────────────────
  { path: "/login", methods: ["POST"], handler: (env, _u, req) => proxy(env, "/api/Auth/login", req) },
  { path: "/signup", methods: ["POST"], handler: (env, _u, req) => proxy(env, "/api/Auth/signup", req) },
  { path: "/apikey", methods: ["POST"], handler: (env, _u, req) => proxy(env, "/api/Auth/apikey/generate", req, { method: "POST" }) },

  // ── Translate: line ────────────────────────────────────────────
  { path: "/translate/line", methods: ["GET", "POST"], handler: handleTranslateLine },

  // ── Translate: content (batch) ─────────────────────────────────
  { path: "/translate/content", methods: ["GET", "POST"], handler: handleTranslateContent },

  // ── Translate: file (path / url / upload) ──────────────────────
  { path: "/translate/file", methods: ["GET", "POST"], handler: handleTranslateFile },

  // ── Translate: file content directly ───────────────────────────
  { path: "/translate/upload", methods: ["POST"], handler: handleTranslateUpload },

  // ── Translate: languages & models ──────────────────────────────
  { path: "/translate/languages", methods: ["GET"], handler: (env, _u, req) => proxy(env, "/api/Translate/languages", req) },
  { path: "/translate/models", methods: ["GET"], handler: (env, _u, req) => proxy(env, "/api/Translate/models", req) },

  // ── Media ──────────────────────────────────────────────────────
  { path: "/movies", methods: ["GET", "POST"], handler: handleMovies },
  { path: "/shows", methods: ["GET", "POST"], handler: handleShows },
  { path: "/media/exclude", methods: ["GET", "POST"], handler: (env, _u, req) => proxy(env, "/api/Media/exclude", req) },
  { path: "/media/threshold", methods: ["GET", "POST"], handler: (env, _u, req) => proxy(env, "/api/Media/threshold", req) },

  // ── Subtitles ──────────────────────────────────────────────────
  { path: "/subtitles", methods: ["GET", "POST"], handler: (env, _u, req) => proxy(env, "/api/Subtitle/all", req) },

  // ── Translation Requests ───────────────────────────────────────
  { path: "/requests", methods: ["GET", "POST"], handler: handleRequests },
  { path: "/requests/active", methods: ["GET"], handler: (env, _u, req) => proxy(env, "/api/TranslationRequest/active", req) },
  { path: "/requests/cancel", methods: ["GET", "POST"], handler: (env, _u, req) => proxy(env, "/api/TranslationRequest/cancel", req) },
  { path: "/requests/remove", methods: ["GET", "POST"], handler: (env, _u, req) => proxy(env, "/api/TranslationRequest/remove", req) },
  { path: "/requests/retry", methods: ["GET", "POST"], handler: (env, _u, req) => proxy(env, "/api/TranslationRequest/retry", req) },

  // ── Misc ───────────────────────────────────────────────────────
  { path: "/version", methods: ["GET"], handler: (env, _u, req) => proxy(env, "/api/Version", req) },
  { path: "/schedule/jobs", methods: ["GET"], handler: (env, _u, req) => proxy(env, "/api/Schedule/jobs", req) },
  { path: "/schedule/job/start", methods: ["GET", "POST"], handler: (env, _u, req) => proxy(env, "/api/Schedule/job/start", req) },
  { path: "/mapping", methods: ["GET"], handler: (env, _u, req) => proxy(env, "/api/Mapping/get", req) },
  { path: "/mapping", methods: ["POST"], handler: (env, _u, req) => proxy(env, "/api/Mapping/set", req) },
  { path: "/settings", methods: ["GET"], handler: (env, _u, req) => proxy(env, "/api/Setting/get", req) },
];

// ── Worker entry ─────────────────────────────────────────────────────────

export default {
  async fetch(request, env) {
    if (request.method === "OPTIONS") {
      return new Response(null, { status: 204, headers: CORS });
    }

    // Auth check (skip for /health and /docs; skip entirely if WORKER_SECRET not set)
    const url = new URL(request.url);
    const skipAuth = ["/", "/health", "/docs"];
    if (env.WORKER_SECRET && !skipAuth.includes(url.pathname)) {
      const authHeader = request.headers.get("Authorization") || "";
      const token = authHeader.replace(/^Bearer\s+/i, "");
      if (token !== env.WORKER_SECRET) {
        return json({ error: "Unauthorized" }, 401);
      }
    }

    try {
      const path = url.pathname;
      const method = request.method;

      // Match static routes
      const route = ROUTES.find((r) => r.path === path && r.methods.includes(method));
      if (route) {
        return route.handler(env, url, request);
      }

      // Dynamic route: /requests/:id
      const reqMatch = path.match(/^\/requests\/(\d+)$/);
      if (reqMatch && ["GET", "POST"].includes(method)) {
        return proxy(env, `/api/TranslationRequest/${reqMatch[1]}`, request);
      }

      // Dynamic route: /image/show/*, /image/movie/*
      if (path.startsWith("/image/show/")) {
        const p = path.slice("/image/show/".length);
        return proxy(env, `/api/Image/show/${p}`, request);
      }
      if (path.startsWith("/image/movie/")) {
        const p = path.slice("/image/movie/".length);
        return proxy(env, `/api/Image/movie/${p}`, request);
      }

      // Raw passthrough: /raw/*
      if (path.startsWith("/raw/")) {
        const lingarrPath = "/" + path.slice("/raw/".length) + url.search;
        return proxy(env, lingarrPath, request);
      }

      return json({ error: "Not found", hint: "GET /docs for full API reference" }, 404);
    } catch (err) {
      return json({ error: err.message || "Internal error" }, 500);
    }
  },
};

// ── Handler: translate line ──────────────────────────────────────────────

async function handleTranslateLine(env, url, request) {
  let body;
  if (request.method === "GET") {
    body = {
      text: url.searchParams.get("text") || "",
      from: url.searchParams.get("from") || "en",
      to: url.searchParams.get("to") || "vi",
    };
  } else {
    body = await request.json();
  }

  const payload = {
    subtitleLine: body.text,
    sourceLanguage: body.from || "en",
    targetLanguage: body.to || "vi",
    contextLinesBefore: body.contextBefore || null,
    contextLinesAfter: body.contextAfter || null,
  };

  return proxy(env, "/api/Translate/line", request, {
    method: "POST",
    body: JSON.stringify(payload),
  });
}

// ── Handler: translate content (batch) ───────────────────────────────────

async function handleTranslateContent(env, url, request) {
  let body;
  if (request.method === "GET") {
    // GET only supports simple inline via query (limited, but handy)
    const text = url.searchParams.get("lines") || ""; // comma-separated
    const lines = text.split("|").map((l, i) => ({ position: i + 1, line: l }));
    body = {
      title: url.searchParams.get("title") || "",
      from: url.searchParams.get("from") || "en",
      to: url.searchParams.get("to") || "vi",
      lines,
    };
  } else {
    body = await request.json();
  }

  const payload = {
    arrMediaId: body.mediaId || 0,
    title: body.title || "",
    sourceLanguage: body.from || "en",
    targetLanguage: body.to || "vi",
    mediaType: body.mediaType || "Movie",
    lines: body.lines.map((l) => ({ position: l.position, line: l.line })),
  };

  return proxy(env, "/api/Translate/content", request, {
    method: "POST",
    body: JSON.stringify(payload),
  });
}

// ── Handler: translate file (path / url) ─────────────────────────────────

async function handleTranslateFile(env, url, request) {
  let body;
  if (request.method === "GET") {
    body = {
      path: url.searchParams.get("path") || "",
      url: url.searchParams.get("url") || "",
      from: url.searchParams.get("from") || "en",
      to: url.searchParams.get("to") || "vi",
      mediaId: url.searchParams.get("mediaId") || "0",
      mediaType: url.searchParams.get("mediaType") || "Movie",
      format: url.searchParams.get("format") || "srt",
    };
  } else {
    body = await request.json();
  }

  // If url is provided, fetch the subtitle content first
  if (body.url && !body.path) {
    try {
      const resp = await fetch(body.url);
      if (!resp.ok) return json({ error: `Failed to fetch subtitle from URL: ${resp.status}` }, 400);
      const content = await resp.text();
      const ext = body.url.split(".").pop().split("?")[0] || "srt";

      // Send as content-based translation
      const lines = parseSubtitleContent(content);
      const payload = {
        arrMediaId: parseInt(body.mediaId) || 0,
        title: body.title || "URL Subtitle",
        sourceLanguage: body.from || "en",
        targetLanguage: body.to || "vi",
        mediaType: body.mediaType || "Movie",
        lines: lines,
      };

      return proxy(env, "/api/Translate/content", request, {
        method: "POST",
        body: JSON.stringify(payload),
      });
    } catch (e) {
      return json({ error: `Failed to fetch URL: ${e.message}` }, 400);
    }
  }

  // Otherwise, translate by file path on Lingarr
  const payload = {
    subtitlePath: body.path,
    sourceLanguage: body.from || "en",
    targetLanguage: body.to || "vi",
    mediaId: parseInt(body.mediaId) || 0,
    mediaType: body.mediaType || "Movie",
    subtitleFormat: body.format || "srt",
  };

  return proxy(env, "/api/Translate/file", request, {
    method: "POST",
    body: JSON.stringify(payload),
  });
}

// ── Handler: upload subtitle file for translation ────────────────────────

async function handleTranslateUpload(env, url, request) {
  const contentType = request.headers.get("Content-Type") || "";

  let subtitleText = "";
  let from = "en";
  let to = "vi";
  let title = "";
  let mediaId = 0;
  let mediaType = "Movie";

  if (contentType.includes("multipart/form-data")) {
    // Multipart form: field "file" = subtitle file, plus form fields
    const formData = await request.formData();
    const file = formData.get("file");
    if (!file) return json({ error: "No 'file' field in form data" }, 400);
    subtitleText = await file.text();
    from = formData.get("from") || "en";
    to = formData.get("to") || "vi";
    title = formData.get("title") || file.name || "";
    mediaId = parseInt(formData.get("mediaId")) || 0;
    mediaType = formData.get("mediaType") || "Movie";
  } else if (contentType.includes("application/json")) {
    // JSON body: { content: "srt text...", from, to }
    const body = await request.json();
    subtitleText = body.content || body.text || "";
    from = body.from || "en";
    to = body.to || "vi";
    title = body.title || "";
    mediaId = body.mediaId || 0;
    mediaType = body.mediaType || "Movie";
  } else {
    // Raw text body — the subtitle content itself
    subtitleText = await request.text();
    from = url.searchParams.get("from") || "en";
    to = url.searchParams.get("to") || "vi";
  }

  if (!subtitleText.trim()) {
    return json({ error: "Empty subtitle content" }, 400);
  }

  // Parse SRT/VTT content into lines
  const lines = parseSubtitleContent(subtitleText);
  if (!lines.length) {
    return json({ error: "No translatable lines found in subtitle content" }, 400);
  }

  const payload = {
    arrMediaId: mediaId,
    title: title || "Uploaded Subtitle",
    sourceLanguage: from,
    targetLanguage: to,
    mediaType,
    lines,
  };

  return proxy(env, "/api/Translate/content", request, {
    method: "POST",
    body: JSON.stringify(payload),
  });
}

// ── Handler: movies ──────────────────────────────────────────────────────

async function handleMovies(env, url, request) {
  let qs;
  if (request.method === "GET") {
    qs = forwardQS(url, {
      searchQuery: "search",
      pageNumber: "page",
      pageSize: "size",
      orderBy: "sort",
      ascending: "asc",
      subtitleFilter: "filter",
    });
  } else {
    const body = await request.json();
    const params = new URLSearchParams();
    if (body.search) params.set("searchQuery", body.search);
    if (body.page) params.set("pageNumber", body.page);
    if (body.size) params.set("pageSize", body.size);
    if (body.sort) params.set("orderBy", body.sort);
    if (body.asc !== undefined) params.set("ascending", body.asc);
    if (body.filter) params.set("subtitleFilter", body.filter);
    qs = params.toString() ? "?" + params.toString() : "";
  }
  return proxy(env, `/api/Media/movies${qs || ""}`, request);
}

// ── Handler: shows ───────────────────────────────────────────────────────

async function handleShows(env, url, request) {
  let qs;
  if (request.method === "GET") {
    qs = forwardQS(url, {
      searchQuery: "search",
      pageNumber: "page",
      pageSize: "size",
      orderBy: "sort",
      ascending: "asc",
      subtitleFilter: "filter",
    });
  } else {
    const body = await request.json();
    const params = new URLSearchParams();
    if (body.search) params.set("searchQuery", body.search);
    if (body.page) params.set("pageNumber", body.page);
    if (body.size) params.set("pageSize", body.size);
    if (body.sort) params.set("orderBy", body.sort);
    if (body.asc !== undefined) params.set("ascending", body.asc);
    if (body.filter) params.set("subtitleFilter", body.filter);
    qs = params.toString() ? "?" + params.toString() : "";
  }
  return proxy(env, `/api/Media/shows${qs || ""}`, request);
}

// ── Handler: translation requests ────────────────────────────────────────

async function handleRequests(env, url, request) {
  if (request.method === "GET") {
    const qs = forwardQS(url, {
      searchQuery: "search",
      pageNumber: "page",
      pageSize: "size",
      orderBy: "sort",
      ascending: "asc",
    });
    return proxy(env, `/api/TranslationRequest/requests${qs}`, request);
  }
  // POST — pass through body
  return proxy(env, "/api/TranslationRequest/requests", request);
}

// ── Helpers ──────────────────────────────────────────────────────────────

async function proxy(env, lingarrPath, originalReq, overrides = {}) {
  const upstream = env.LINGARR_URL.replace(/\/+$/, "") + lingarrPath;
  const headers = { "Content-Type": "application/json" };
  if (env.LINGARR_KEY) headers["X-Api-Key"] = env.LINGARR_KEY;

  const init = {
    method: overrides.method || originalReq.method,
    headers,
  };

  if (overrides.body !== undefined) {
    init.body = overrides.body;
  } else if (originalReq.method !== "GET" && originalReq.method !== "HEAD") {
    const cloned = originalReq.clone();
    const body = await cloned.text();
    if (body) init.body = body;
  }

  const resp = await fetch(upstream, init);
  const text = await resp.text();

  let data;
  try {
    data = JSON.parse(text);
  } catch {
    data = text;
  }

  return new Response(JSON.stringify(data), {
    status: resp.status,
    headers: { "Content-Type": "application/json", ...CORS },
  });
}

function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: { "Content-Type": "application/json", ...CORS },
  });
}

function forwardQS(clientURL, mapping) {
  const parts = [];
  for (const [upstreamKey, clientKey] of Object.entries(mapping)) {
    const v = clientURL.searchParams.get(clientKey);
    if (v !== null && v !== "") parts.push(`${upstreamKey}=${encodeURIComponent(v)}`);
  }
  return parts.length ? "?" + parts.join("&") : "";
}

/**
 * Parse SRT/VTT subtitle content into { position, line } array.
 * Strips timestamps, sequence numbers, and formatting tags.
 */
function parseSubtitleContent(content) {
  const lines = [];
  // Split into blocks (separated by blank lines)
  const blocks = content.split(/\r?\n\r?\n/);
  let position = 1;

  for (const block of blocks) {
    const blockLines = block.trim().split(/\r?\n/);
    if (blockLines.length < 2) continue;

    // Find the text lines (skip sequence numbers and timestamp lines)
    for (const line of blockLines) {
      const trimmed = line.trim();
      // Skip empty, sequence numbers, timestamp lines (contain -->), and VTT header
      if (!trimmed) continue;
      if (/^\d+$/.test(trimmed)) continue;
      if (trimmed.includes("-->")) continue;
      if (trimmed === "WEBVTT") continue;
      if (trimmed.startsWith("Kind:") || trimmed.startsWith("Language:")) continue;

      // Strip HTML/SRT tags: <i>, </i>, <b>, <b>, <font ...>, etc.
      const cleaned = trimmed.replace(/<[^>]+>/g, "").trim();
      if (cleaned) {
        lines.push({ position, line: cleaned });
        position++;
      }
    }
  }
  return lines;
}

