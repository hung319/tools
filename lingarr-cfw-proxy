<!-- ═══ Translate ════════════════════════════════════════════════ -->
<div class="section-title">Translate</div>

<div class="endpoint" onclick="toggle(this)">
  <div class="endpoint-header">
    <span class="method method-any">GET/POST</span>
    <span class="endpoint-path">/translate/line</span>
    <span class="endpoint-desc">Translate a single subtitle line</span>
  </div>
  <div class="endpoint-body">
    <h4>Parameters</h4>
    <table class="params-table">
      <tr><th>Name</th><th>Type</th><th>Default</th><th>Description</th></tr>
      <tr><td><code>text</code></td><td>string</td><td>—</td><td>The text to translate</td></tr>
      <tr><td><code>from</code></td><td>string</td><td><code>en</code></td><td>Source language code</td></tr>
      <tr><td><code>to</code></td><td>string</td><td><code>vi</code></td><td>Target language code</td></tr>
    </table>
    <h4>Body (JSON)</h4>
    <pre>{ <span class="key">"text"</span>: <span class="str">"Hello, how are you?"</span>, <span class="key">"from"</span>: <span class="str">"en"</span>, <span class="key">"to"</span>: <span class="str">"vi"</span> }</pre>
    <div class="try-it" onclick="event.stopPropagation()">
      <textarea class="body-input">{ "text": "Hello, how are you?", "from": "en", "to": "vi" }</textarea>
      <div class="btn-row">
        <button onclick="tryIt(this, 'GET', '/translate/line?text=Hello%2C+how+are+you%3F&from=en&to=vi')">GET</button>
        <button onclick="tryIt(this, 'POST', '/translate/line', this.closest('.try-it').querySelector('textarea').value)">POST</button>
      </div>
      <div class="result"></div>
    </div>
  </div>
</div>

<div class="endpoint" onclick="toggle(this)">
  <div class="endpoint-header">
    <span class="method method-any">GET/POST</span>
    <span class="endpoint-path">/translate/content</span>
    <span class="endpoint-desc">Batch translate multiple lines</span>
  </div>
  <div class="endpoint-body">
    <h4>Body (JSON)</h4>
    <pre>{
  <span class="key">"title"</span>: <span class="str">"Movie Name"</span>,
  <span class="key">"from"</span>: <span class="str">"en"</span>,
  <span class="key">"to"</span>: <span class="str">"vi"</span>,
  <span class="key">"lines"</span>: [
    { <span class="key">"position"</span>: <span class="num">1</span>, <span class="key">"line"</span>: <span class="str">"Hello"</span> },
    { <span class="key">"position"</span>: <span class="num">2</span>, <span class="key">"line"</span>: <span class="str">"World"</span> }
  ]
}</pre>
    <h4>GET mode</h4>
    <p>Pass <code>lines</code> as pipe-separated: <code>/translate/content?lines=Hello|World&from=en&to=vi</code></p>
    <div class="try-it" onclick="event.stopPropagation()">
      <textarea class="body-input">{
  "title": "Test",
  "from": "en",
  "to": "vi",
  "lines": [
    { "position": 1, "line": "Hello world" },
    { "position": 2, "line": "Goodbye world" }
  ]
}</textarea>
      <div class="btn-row">
        <button onclick="tryIt(this, 'POST', '/translate/content', this.closest('.try-it').querySelector('textarea').value)">POST</button>
      </div>
      <div class="result"></div>
    </div>
  </div>
</div>

<div class="endpoint" onclick="toggle(this)">
  <div class="endpoint-header">
    <span class="method method-any">GET/POST</span>
    <span class="endpoint-path">/translate/file</span>
    <span class="endpoint-desc">Translate a subtitle file <span class="tag tag-url">URL</span></span>
  </div>
  <div class="endpoint-body">
    <p>Translate by <strong>file path</strong> on Lingarr, or by <strong>URL</strong> (fetches and parses SRT/VTT automatically).</p>
    <h4>Parameters</h4>
    <table class="params-table">
      <tr><th>Name</th><th>Type</th><th>Required</th><th>Description</th></tr>
      <tr><td><code>path</code></td><td>string</td><td><span class="optional">one of path/url</span></td><td>Subtitle file path on Lingarr media server</td></tr>
      <tr><td><code>url</code></td><td>string</td><td><span class="optional">one of path/url</span></td><td>URL to download the subtitle file from</td></tr>
      <tr><td><code>from</code></td><td>string</td><td></td><td>Source language (default: <code>en</code>)</td></tr>
      <tr><td><code>to</code></td><td>string</td><td></td><td>Target language (default: <code>vi</code>)</td></tr>
      <tr><td><code>mediaId</code></td><td>int</td><td></td><td>Media ID (default: <code>0</code>)</td></tr>
      <tr><td><code>mediaType</code></td><td>string</td><td></td><td><code>Movie</code> or <code>Show</code> (default: <code>Movie</code>)</td></tr>
      <tr><td><code>format</code></td><td>string</td><td></td><td>Subtitle format (default: <code>srt</code>)</td></tr>
    </table>
    <h4>JSON Body</h4>
    <pre>{ <span class="key">"url"</span>: <span class="str">"https://example.com/subtitle.srt"</span>, <span class="key">"from"</span>: <span class="str">"en"</span>, <span class="key">"to"</span>: <span class="str">"vi"</span> }</pre>
    <h4>GET Example</h4>
    <pre>GET /translate/file?url=https://example.com/sub.srt&amp;from=en&amp;to=vi</pre>
    <div class="try-it" onclick="event.stopPropagation()">
      <textarea class="body-input">{ "url": "", "path": "", "from": "en", "to": "vi" }</textarea>
      <div class="btn-row">
        <button onclick="tryIt(this, 'POST', '/translate/file', this.closest('.try-it').querySelector('textarea').value)">POST</button>
      </div>
      <div class="result"></div>
    </div>
  </div>
</div>

<div class="endpoint" onclick="toggle(this)">
  <div class="endpoint-header">
    <span class="method method-post">POST</span>
    <span class="endpoint-path">/translate/upload</span>
    <span class="endpoint-desc">Upload & translate subtitle <span class="tag tag-file">FILE</span></span>
  </div>
  <div class="endpoint-body">
    <p>Upload a subtitle file directly. Supports <code>multipart/form-data</code>, JSON with content string, or raw SRT/VTT text body.</p>
    <h4>Multipart Form</h4>
    <table class="params-table">
      <tr><th>Field</th><th>Type</th><th>Required</th><th>Description</th></tr>
      <tr><td><code>file</code></td><td>file</td><td>yes</td><td>The subtitle file (.srt, .vtt, .ass)</td></tr>
      <tr><td><code>from</code></td><td>string</td><td></td><td>Source language (default: <code>en</code>)</td></tr>
      <tr><td><code>to</code></td><td>string</td><td></td><td>Target language (default: <code>vi</code>)</td></tr>
      <tr><td><code>title</code></td><td>string</td><td></td><td>Media title (default: filename)</td></tr>
      <tr><td><code>mediaId</code></td><td>int</td><td></td><td>Media ID</td></tr>
      <tr><td><code>mediaType</code></td><td>string</td><td></td><td><code>Movie</code> or <code>Show</code></td></tr>
    </table>
    <h4>JSON Body</h4>
    <pre>{ <span class="key">"content"</span>: <span class="str">"1\\n00:00:01,000 --> 00:00:03,000\\nHello world\\n\\n2\\n00:00:04,000 --> ..."</span>, <span class="key">"from"</span>: <span class="str">"en"</span>, <span class="key">"to"</span>: <span class="str">"vi"</span> }</pre>
    <h4>Raw Text</h4>
    <p>Send the SRT/VTT content as raw body with <code>Content-Type: text/plain</code>. Use query params for <code>from</code> and <code>to</code>.</p>
    <h4>curl Example</h4>
    <pre><span class="comment"># Upload a file</span>
curl -X POST https://worker.dev/translate/upload \\
  -H "Authorization: Bearer YOUR_SECRET" \\
  -F "file=@subtitle.srt" \\
  -F "from=en" -F "to=vi"

<span class="comment"># Raw SRT text</span>
curl -X POST https://worker.dev/translate/upload \\
  -H "Authorization: Bearer YOUR_SECRET" \\
  -H "Content-Type: text/plain" \\
  --data-binary @subtitle.srt \\
  "?from=en&to=vi"</pre>
    <div class="try-it" onclick="event.stopPropagation()">
      <textarea class="body-input" rows="4">1
00:00:01,000 --> 00:00:03,000
Hello world

2
00:00:04,000 --> 00:00:06,000
Goodbye world</textarea>
      <div class="btn-row">
        <button onclick="tryUpload(this)">POST (raw text)</button>
      </div>
      <div class="result"></div>
    </div>
  </div>
</div>

<div class="endpoint" onclick="toggle(this)">
