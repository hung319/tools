FROM docker.io/linuxserver/prowlarr:latest

USER root

RUN apk update && apk add --no-cache bash && rm -rf /var/cache/apk/*

ENV PORT_CHAMBER=7860 \
    XDG_CONFIG_HOME=/data \
    XDG_DATA_HOME=/data

RUN mkdir -p /custom-cont-init.d && cat <<'EOF' > /custom-cont-init.d/prowlarr-config.sh
#!/bin/bash

mkdir -p /data/Prowlarr
if [ ! -f /data/Prowlarr/config.xml ]; then
    echo "<Config><Port>${PORT_CHAMBER}</Port><UrlBase></UrlBase><LogLevel>warn</LogLevel><AuthenticationMethod>None</AuthenticationMethod></Config>" > /data/Prowlarr/config.xml
else
    sed -i "s|<Port>.*</Port>|<Port>${PORT_CHAMBER}</Port>|g" /data/Prowlarr/config.xml
    sed -i "s|<LogLevel>.*</LogLevel>|<LogLevel>warn</LogLevel>|g" /data/Prowlarr/config.xml
fi

chown -R 911:911 /data
EOF

RUN sed -i 's/\r$//' /custom-cont-init.d/prowlarr-config.sh && \
    chmod +x /custom-cont-init.d/prowlarr-config.sh

EXPOSE 7860

ENTRYPOINT ["/init"]
