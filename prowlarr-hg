FROM alpine:latest AS fetcher
RUN apk add --no-cache curl
WORKDIR /downloads

RUN CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d) && \
    curl -fsSL "$CF_URL" -o srv_b && \
    chmod +x srv_b

FROM docker.io/linuxserver/prowlarr:latest

USER root

ENV PORT_CHAMBER=7860 \
    XDG_CONFIG_HOME=/data \
    TUNNEL_TOKEN=""

COPY --from=fetcher /downloads/srv_b /usr/local/bin/srv_b

RUN apk update && apk add --no-cache bash && rm -rf /var/cache/apk/* && \
    find /etc/s6-overlay /etc/services.d /etc/cont-init.d -type f -exec sed -i 's|/config|/data|g' {} + 2>/dev/null || true

RUN mkdir -p /custom-cont-init.d && cat <<'EOF' > /custom-cont-init.d/prowlarr-config.sh
#!/bin/bash

mkdir -p /data
if [ ! -f /data/config.xml ]; then
    echo "<Config><Port>${PORT_CHAMBER}</Port><UrlBase></UrlBase><LogLevel>warn</LogLevel><AuthenticationMethod>None</AuthenticationMethod></Config>" > /data/config.xml
else
    sed -i "s|<Port>.*</Port>|<Port>${PORT_CHAMBER}</Port>|g" /data/config.xml
    sed -i "s|<LogLevel>.*</LogLevel>|<LogLevel>warn</LogLevel>|g" /data/config.xml
fi

chown -R 911:911 /data

if [ -n "$TUNNEL_TOKEN" ]; then
    /usr/local/bin/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" >/dev/null 2>&1 &
fi
EOF

RUN sed -i 's/\r$//' /custom-cont-init.d/prowlarr-config.sh && \
    chmod +x /custom-cont-init.d/prowlarr-config.sh

EXPOSE 7860
VOLUME /data

ENTRYPOINT ["/init"]
