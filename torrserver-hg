FROM debian:stable-slim

USER root

# Loại bỏ inotify-tools vì không còn dùng để sync dữ liệu nữa
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    openssl \
    curl \
    ca-certificates \
    procps \
    psmisc \
    jq \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN ARCH=$(uname -m) \
    && GITHUB_API="https://api.github.com/repos/9000000/TorrServer/releases/latest" \
    && DOWNLOAD_URL=$(curl -fsSL "$GITHUB_API" | jq -r ".assets[].browser_download_url") \
    && if [ "$ARCH" = "x86_64" ]; then \
         TS_URL=$(echo "$DOWNLOAD_URL" | grep -Ei "TorrServer-linux-amd64$"); \
       else \
         TS_URL=$(echo "$DOWNLOAD_URL" | grep -Ei "TorrServer-linux-arm64$"); \
       fi \
    && curl -fsSL "$TS_URL" -o /usr/bin/torrserver \
    && chmod +x /usr/bin/torrserver

ENV TS_PORT=7860
# Chuyển toàn bộ đường dẫn lưu trữ về /data
ENV TS_CONF_PATH="/data/.config/torrserver"
ENV TS_SETTINGS="/data/.config/torrserver/settings.json"
ENV TS_TORR_DIR="/data/torrents"
ENV TS_LOG_PATH="/data/torr.log"
ENV TS_RDB=1
ENV GODEBUG=madvdontneed=1

# Đổi không gian làm việc chính sang /data
WORKDIR /data

RUN mkdir -p /data/.config/torrserver /data/torrents && chmod -R 777 /data

RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh
#!/bin/bash
set +e

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

cleanup() {
    log "!!! [STOP] Nhận tín hiệu tắt máy. Đang dừng TorrServer... !!!"
    [ -n "${APP_PID:-}" ] && kill -TERM "$APP_PID" 2>/dev/null
    exit 0
}

trap cleanup SIGTERM SIGINT

fuser -k "${TS_PORT}/tcp" 2>/dev/null || true

RDB_FLAG=""
if [ "${TS_RDB}" = "1" ]; then
    log "--- [CONFIG] Phát hiện cấu hình TS_RDB=1. Tự động kích hoạt chế độ Read-Only DB (--rdb) ---"
    RDB_FLAG="--rdb"
fi

log "--- [START] Khởi chạy TorrServer chính chủ trên cổng ${TS_PORT} (Dữ liệu lưu tại /data)... ---"

/usr/bin/torrserver \
    --port "${TS_PORT}" \
    --path "${TS_CONF_PATH}" \
    --torrentsdir "${TS_TORR_DIR}" \
    --logpath "${TS_LOG_PATH}" \
    $RDB_FLAG &

APP_PID=$!
wait "$APP_PID"
EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 7860

ENTRYPOINT ["/bin/bash", "/usr/local/bin/entrypoint.sh"]
