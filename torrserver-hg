FROM debian:stable-slim

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    openssl \
    curl \
    ca-certificates \
    procps \
    psmisc \
    ffmpeg \
    tini \
    && rm -rf /var/lib/apt/lists/*

RUN TS_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tLzkwMDAwMDAvVG9yclNlcnZlci9yZWxlYXNlcy9sYXRlc3QvZG93bmxvYWQvVG9yclNlcnZlci1saW51eC1hbWQ2NA==" | base64 -d) \
    && curl -fsSL "$TS_URL" -o /usr/bin/torrserver \
    && chmod +x /usr/bin/torrserver

RUN mkdir -p /sys3 && \
    CF_URL=$(echo "aHR0cHM6Ly9naXRodWIuY29tL2Nsb3VkZmxhcmUvY2xvdWRmbGFyZWQvcmVsZWFzZXMvbGF0ZXN0L2Rvd25sb2FkL2Nsb3VkZmxhcmVkLWxpbnV4LWFtZDY0" | base64 -d) && \
    curl -fsSL "$CF_URL" -o /sys3/srv_b && \
    chmod +x /sys3/srv_b

ENV TS_PORT=7860 \
    TS_CONF_PATH="/data/.config/torrserver" \
    TS_SETTINGS="/data/.config/torrserver/settings.json" \
    TS_TORR_DIR="/data/torrents" \
    TS_LOG_PATH="/data/torr.log" \
    TS_RDB=1 \
    GODEBUG=madvdontneed=1 \
    TUNNEL_TOKEN=""

WORKDIR /data

RUN mkdir -p /data/.config/torrserver /data/torrents /sys3 && chmod -R 777 /data /sys3

RUN cat <<'EOF' > /usr/local/bin/entrypoint.sh
#!/bin/bash
set +e

cleanup() {
    [ -n "${APP_PID:-}" ] && kill -TERM "$APP_PID" 2>/dev/null
    killall srv_b 2>/dev/null || true
    exit 0
}

trap cleanup SIGTERM SIGINT

if [ -n "$TUNNEL_TOKEN" ]; then
    /sys3/srv_b tunnel --no-autoupdate run --token "$TUNNEL_TOKEN" >/dev/null 2>&1 &
fi

fuser -k "${TS_PORT}/tcp" 2>/dev/null || true

RDB_FLAG=""
if [ "${TS_RDB}" = "1" ]; then
    RDB_FLAG="--rdb"
fi

/usr/bin/torrserver \
    --port "${TS_PORT}" \
    --path "${TS_CONF_PATH}" \
    --torrentsdir "${TS_TORR_DIR}" \
    --logpath "${TS_LOG_PATH}" \
    $RDB_FLAG &

APP_PID=$!
wait "$APP_PID"
EOF

RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 7860

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
